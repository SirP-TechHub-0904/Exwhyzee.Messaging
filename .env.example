# ===================================================================
# Exwhyzee.Messaging Environment Configuration Template (.env.example)
# Copy to .env (and/or Exwhyzee.Messaging.Web/.env & Exwhyzee.Messaging.Api/.env)
# ===================================================================

# SQL Server Database Connection
ConnectionStrings__ZyxsmsDbConnection="Server=localhost;Database=db_xyzsms_dev;Trusted_Connection=True;TrustServerCertificate=True;"

# ZeptoMail Transactional Email Settings
ZeptoMailSettings__Host="smtp.zeptomail.com"
ZeptoMailSettings__Port="587"
ZeptoMailSettings__UserName="your_zeptomail_username"
ZeptoMailSettings__Password="your_zeptomail_password"
ZeptoMailSettings__FromEmail="noreply@yourdomain.com"
ZeptoMailSettings__FromName="Messaging Platform"

# Paystack Payment & Outflow Gateway
PaystackSettings__PublicKey="pk_test_your_public_key_here"
PaystackSettings__SecretKey="sk_test_your_secret_key_here"

# Google reCAPTCHA v3
GoogleReCaptcha__SiteKey="your_recaptcha_site_key"
GoogleReCaptcha__SecretKey="your_recaptcha_secret_key"

# OneSignal Push Notifications
OneSignal__AppId="your_onesignal_app_id"
OneSignal__RestApiKey="your_onesignal_rest_api_key"

# Cloudinary Media CDN
CloudinarySettings__CloudName="your_cloud_name"
CloudinarySettings__ApiKey="your_cloudinary_api_key"
CloudinarySettings__ApiSecret="your_cloudinary_api_secret"

# Application & Gateway API Token
AppSettings__ApiToken="your_internal_gateway_api_token"
AppSettings__ApiBaseUrl="https://api.yourdomain.com"

