@{
    ViewBag.Title = "Account Suspended - Emergency Support Appeal";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    string siteKey = ViewBag.ReCaptchaSiteKey as string ?? "6LciMY4tAAAAAAn4BSqUzeCAwQacub1GxgjeIwIG";
}

<script src="https://www.google.com/recaptcha/api.js?render=@siteKey"></script>

<style>
    .xyz-lockout-form-card {
        width: 100%;
        max-width: 520px;
        background: #FFFFFF;
        padding: 36px;
        border-radius: 20px;
        border: 1px solid #FCA5A5;
        box-shadow: 0 20px 40px rgba(220, 38, 38, 0.12);
        margin: 20px auto;
    }

    .xyz-lockout-icon {
        width: 68px;
        height: 68px;
        background: #FEE2E2;
        color: #DC2626;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 16px auto;
        box-shadow: 0 4px 14px rgba(220, 38, 38, 0.2);
    }

    .xyz-field-group {
        margin-bottom: 18px;
        text-align: left;
    }

    .xyz-field-group label {
        display: block;
        font-weight: 700;
        font-size: 0.85rem;
        color: #1E293B;
        margin-bottom: 6px;
    }

    .xyz-input-box {
        position: relative;
        width: 100%;
    }

    .xyz-input-box i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #94A3B8;
        font-size: 1rem;
        z-index: 2;
        pointer-events: none;
    }

    .xyz-input-box input,
    .xyz-input-box select {
        width: 100%;
        height: 48px;
        padding-left: 44px;
        padding-right: 16px;
        border-radius: 10px;
        border: 1px solid #CBD5E1;
        font-size: 0.95rem;
        font-family: inherit;
        background: #FFFFFF;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

    .xyz-input-box input:focus,
    .xyz-input-box select:focus,
    .xyz-textarea:focus {
        border-color: #DC2626;
        box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.15);
        outline: none;
    }

    .xyz-textarea {
        width: 100%;
        border-radius: 10px;
        border: 1px solid #CBD5E1;
        padding: 12px 16px;
        font-size: 0.95rem;
        font-family: inherit;
        background: #FFFFFF;
        box-sizing: border-box;
        transition: all 0.2s ease;
        resize: vertical;
    }
</style>

<div class="xyz-auth-container">
    <!-- LEFT SIDE BRANDING HERO -->
    <div class="xyz-auth-side">
        <div>
            <img src="~/Content/image/SMS-LOGO.png" alt="XYZ SMS" style="height: 44px; filter: brightness(0) invert(1);" />
            <div style="margin-top: 60px;">
                <span class="badge" style="background: rgba(220, 38, 38, 0.2); color: #FCA5A5; padding: 6px 14px; border-radius: 20px; font-weight: 700; font-size: 0.8rem;">
                    <i class="fa fa-shield-alt"></i> Security Desk
                </span>
                <h1 style="font-size: 2.4rem; font-weight: 800; margin: 16px 0 12px 0; line-height: 1.2; letter-spacing: -0.5px;">
                    Account Security &amp;<br />Access Appeal Portal
                </h1>
                <p style="color: #94A3B8; font-size: 1.05rem; line-height: 1.6; max-width: 440px; margin: 0;">
                    If your account access has been restricted, submit an emergency appeal below. Our security team reviews all requests promptly.
                </p>
            </div>
        </div>

        <div style="color: #64748B; font-size: 0.85rem;">
            &copy; @DateTime.UtcNow.Year Exwhyzee Messaging. All rights reserved.
        </div>
    </div>

    <!-- RIGHT SIDE FORM WRAPPER -->
    <div class="xyz-auth-form-wrapper" style="overflow-y: auto; padding: 30px 20px;">
        <div class="xyz-lockout-form-card text-center">
            <div class="xyz-lockout-icon">
                <i class="fa fa-user-slash"></i>
            </div>

            <h2 style="font-weight: 800; color: #991B1B; margin: 0 0 8px 0; letter-spacing: -0.5px; font-size: 1.6rem;">
                Account Access Suspended
            </h2>

            <p style="color: #64748B; font-size: 0.9rem; line-height: 1.5; margin-bottom: 24px;">
                Your account is currently restricted. Submit an emergency support appeal below for administrator review.
            </p>

            @Html.Partial("_ResponseMessagePartial")

            @using (Html.BeginForm("SubmitLockoutTicket", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="xyz-field-group">
                    <label>Your Full Name</label>
                    <div class="xyz-input-box">
                        <i class="fa fa-user"></i>
                        <input type="text" name="senderName" placeholder="e.g. John Doe" required />
                    </div>
                </div>

                <div class="xyz-field-group">
                    <label>Your Registered Email</label>
                    <div class="xyz-input-box">
                        <i class="fa fa-envelope"></i>
                        <input type="email" name="senderEmail" placeholder="user@domain.com" required />
                    </div>
                </div>

                <div class="xyz-field-group">
                    <label>Phone Number (Optional)</label>
                    <div class="xyz-input-box">
                        <i class="fa fa-phone"></i>
                        <input type="text" name="senderPhone" placeholder="0803..." />
                    </div>
                </div>

                <div class="xyz-field-group">
                    <label>Appeal Details &amp; Reason for Unblocking</label>
                    <textarea name="message" class="xyz-textarea" rows="4" placeholder="Explain your request for account restoration..." required></textarea>
                </div>

                <!-- GOOGLE RECAPTCHA v3 (invisible) -->
                <input type="hidden" name="g-recaptcha-response" id="recaptchaToken" />

                <button type="submit" class="btn btn-danger btn-block btn-lg" style="font-weight: 800; border-radius: 10px; height: 48px; background: #DC2626; border: none; font-size: 1rem; width: 100%;">
                    <i class="fa fa-paper-plane"></i> Submit Emergency Appeal Ticket
                </button>
            }

<script>
    document.querySelector('form').addEventListener('submit', function (e) {
        e.preventDefault();
        var form = this;
        grecaptcha.ready(function () {
            grecaptcha.execute('@siteKey', { action: 'lockout_appeal' }).then(function (token) {
                document.getElementById('recaptchaToken').value = token;
                form.submit();
            });
        });
    });
</script>

            <div style="margin-top: 24px; border-top: 1px solid #F1F5F9; padding-top: 16px;">
                <a href="@Url.Action("Login", "Account")" style="color: #64748B; font-weight: 700; font-size: 0.88rem; text-decoration: none;">
                    <i class="fa fa-arrow-left"></i> Return to Login Page
                </a>
            </div>
        </div>
    </div>
</div>
