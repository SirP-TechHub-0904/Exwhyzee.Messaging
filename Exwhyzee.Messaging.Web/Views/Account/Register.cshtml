@using Exwhyzee.Messaging.Core.Models
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model RegisterViewModel

@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewBag.Title = "Create Your Free Account";
    var reCaptchaSiteKey = Configuration["GoogleReCaptcha:SiteKey"] ?? "6LciMY4tAAAAAAn4BSqUzeCAwQacub1GxgjeIwIG";
}

<div class="xyz-auth-container">
    <!-- Left Showcase Side (Desktop) -->
    <div class="xyz-auth-side">
        <div>
            <a href="@Url.Action("Index", "Home")" class="xyz-brand" style="display:inline-block; background:#FFFFFF; padding:10px 20px; border-radius:10px; box-shadow:0 4px 14px rgba(0,0,0,0.2);">
                <img src="~/Content/image/SMS-LOGO.png" alt="Exwhyzee Bulk SMS" style="height:42px; width:auto; display:block;" />
            </a>
        </div>

        <div>
            <span style="display:inline-flex; align-items:center; gap:8px; background:rgba(16,185,129,0.15); color:#10B981; border:1px solid rgba(16,185,129,0.3); padding:6px 14px; border-radius:var(--xyz-radius-full); font-size:0.8rem; font-weight:700; text-transform:uppercase; margin-bottom:16px;">
                <i class="fa fa-gift"></i> 20 Free Test Units
            </span>
            <h2 style="font-size:2.2rem; font-weight:800; line-height:1.2; margin-bottom:16px;">
                Start Sending in Less Than 60 Seconds.
            </h2>
            <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:12px; color:var(--xyz-gray-300); font-size:0.95rem;">
                <li style="display:flex; align-items:center; gap:10px;">
                    <i class="fa fa-circle-check" style="color:var(--xyz-success);"></i> Free Instant Test Messaging Units
                </li>
                <li style="display:flex; align-items:center; gap:10px;">
                    <i class="fa fa-circle-check" style="color:var(--xyz-success);"></i> Custom Alphanumeric Sender ID
                </li>
                <li style="display:flex; align-items:center; gap:10px;">
                    <i class="fa fa-circle-check" style="color:var(--xyz-success);"></i> Direct Carrier Gateway Routing
                </li>
                <li style="display:flex; align-items:center; gap:10px;">
                    <i class="fa fa-circle-check" style="color:var(--xyz-success);"></i> Developer REST API & Webhooks
                </li>
            </ul>
        </div>

        <div style="font-size:0.85rem; color:var(--xyz-gray-500);">
            &copy; @DateTime.UtcNow.Year <a href="https://exwhyzee.ng/" target="_blank" rel="noopener noreferrer" style="color:var(--xyz-gray-400); text-decoration:none; font-weight:700; transition:color 0.2s ease;">Exwhyzee Smart Solutions Limited</a>.
        </div>
    </div>

    <!-- Right Form Side -->
    <div class="xyz-auth-form-wrapper">
        <div class="xyz-auth-card">
            
            <!-- Mobile Brand Logo -->
            <div class="xyz-auth-mobile-logo">
                <a href="@Url.Action("Index", "Home")" style="display:inline-block; background:#FFFFFF; padding:8px 18px; border-radius:8px; border:1px solid var(--xyz-gray-200); box-shadow:var(--xyz-shadow-sm);">
                    <img src="~/Content/image/SMS-LOGO.png" alt="Exwhyzee Bulk SMS" style="height:38px; width:auto; display:block;" />
                </a>
            </div>

            <div style="text-align:center; margin-bottom:24px;">
                <h1 style="font-size:1.6rem; font-weight:800; color:var(--xyz-dark-900); margin-bottom:6px;">Create Account</h1>
                <p style="color:var(--xyz-gray-500); font-size:0.9rem; margin:0;">Get started with 20 free test messaging units</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div style="background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.3); color:#065f46; padding:12px 16px; border-radius:var(--xyz-radius-md); margin-bottom:16px; font-size:0.9rem; font-weight:600;">
                    <i class="fa fa-circle-check" style="color:#10B981; margin-right:6px;"></i> @TempData["Success"]
                </div>
            }

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { id = "registerForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { style = "color:var(--xyz-primary); font-size:0.88rem; margin-bottom:14px;" })

                <div class="xyz-input-icon-wrapper" style="margin-bottom:8px;">
                    <i class="fa fa-user"></i>
                    <input type="text" id="regUsername" class="xyz-calc-input" name="Username" placeholder="Choose a Username" required autofocus autocomplete="off" />
                    @Html.ValidationMessageFor(m => m.Username, "", new { style = "color:var(--xyz-primary); font-size:0.8rem;" })
                </div>
                <!-- Realtime Username Availability Status -->
                <div id="usernameStatus" style="font-size:0.82rem; margin-bottom:14px; min-height:18px; transition:all 0.2s ease;"></div>

                <div class="xyz-input-icon-wrapper">
                    <i class="fa fa-envelope"></i>
                    <input type="email" id="regEmail" class="xyz-calc-input" name="Email" placeholder="Email Address" required />
                    @Html.ValidationMessageFor(m => m.Email, "", new { style = "color:var(--xyz-primary); font-size:0.8rem;" })
                </div>

                <div class="xyz-input-icon-wrapper">
                    <i class="fa fa-phone"></i>
                    <input type="tel" class="xyz-calc-input" name="PhoneNumber" placeholder="Phone Number (e.g. 08012345678)" required />
                    @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { style = "color:var(--xyz-primary); font-size:0.8rem;" })
                </div>

                <div class="xyz-input-icon-wrapper">
                    <i class="fa fa-lock"></i>
                    <input type="password" id="regPassword" name="Password" placeholder="Create Password" required />
                    <button type="button" class="xyz-pwd-eye" onclick="togglePasswordVisibility('regPassword', this)">
                        <i class="fa fa-eye"></i>
                    </button>
                    @Html.ValidationMessageFor(m => m.Password, "", new { style = "color:var(--xyz-primary); font-size:0.8rem;" })
                </div>

                <div class="xyz-input-icon-wrapper">
                    <i class="fa fa-lock"></i>
                    <input type="password" id="regConfirmPassword" name="ConfirmPassword" placeholder="Confirm Password" required />
                    <button type="button" class="xyz-pwd-eye" onclick="togglePasswordVisibility('regConfirmPassword', this)">
                        <i class="fa fa-eye"></i>
                    </button>
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { style = "color:var(--xyz-primary); font-size:0.8rem;" })
                </div>

                <!-- Google reCAPTCHA v3 (invisible) -->
                <input type="hidden" name="g-recaptcha-response" id="recaptchaToken" />

                <button type="submit" id="btnRegisterSubmit" class="xyz-btn xyz-btn-primary" style="width:100%; padding:13px; margin-top:4px; font-weight:700;">
                    <i class="fa fa-user-plus"></i> Create Account &amp; Claim Units
                </button>
            }

            <div style="text-align:center; margin-top:20px; padding-top:16px; border-top:1px solid var(--xyz-gray-200); font-size:0.9rem; color:var(--xyz-gray-600);">
                Already have an account?
                <a href="@Url.Action("Login", "Account")" style="color:var(--xyz-primary); font-weight:700;">
                    Sign In
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<!-- Google reCAPTCHA v3 API -->
<script src="https://www.google.com/recaptcha/api.js?render=@reCaptchaSiteKey"></script>
<script>
    document.querySelector('form').addEventListener('submit', function (e) {
        e.preventDefault();
        var form = this;
        grecaptcha.ready(function () {
            grecaptcha.execute('@reCaptchaSiteKey', { action: 'register' }).then(function (token) {
                document.getElementById('recaptchaToken').value = token;
                form.submit();
            });
        });
    });
</script>

<script>
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    // Realtime Username Uniqueness Verification
    (function () {
        const usernameInput = document.getElementById('regUsername');
        const statusDiv = document.getElementById('usernameStatus');
        const submitBtn = document.getElementById('btnRegisterSubmit');
        let debounceTimer = null;

        usernameInput.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            const username = this.value.trim();

            if (username.length < 3) {
                statusDiv.innerHTML = '<span style="color: var(--xyz-gray-400);"><i class="fa fa-circle-info"></i> Username must be at least 3 characters.</span>';
                usernameInput.style.borderColor = 'var(--xyz-gray-300)';
                submitBtn.disabled = true;
                return;
            }

            statusDiv.innerHTML = '<span style="color: var(--xyz-gray-500);"><i class="fa fa-spinner fa-spin"></i> Checking availability...</span>';

            debounceTimer = setTimeout(() => {
                fetch('/Account/CheckUsernameAvailability?username=' + encodeURIComponent(username))
                    .then(response => response.json())
                    .then(data => {
                        if (data.available) {
                            statusDiv.innerHTML = '<span style="color: #10B981; font-weight: 600;"><i class="fa fa-circle-check"></i> ' + data.message + '</span>';
                            usernameInput.style.borderColor = '#10B981';
                            submitBtn.disabled = false;
                        } else {
                            statusDiv.innerHTML = '<span style="color: var(--xyz-primary); font-weight: 600;"><i class="fa fa-circle-xmark"></i> ' + data.message + '</span>';
                            usernameInput.style.borderColor = 'var(--xyz-primary)';
                            submitBtn.disabled = true;
                        }
                    })
                    .catch(() => {
                        statusDiv.innerHTML = '';
                        submitBtn.disabled = false;
                    });
            }, 300);
        });
    })();
</script>
}
