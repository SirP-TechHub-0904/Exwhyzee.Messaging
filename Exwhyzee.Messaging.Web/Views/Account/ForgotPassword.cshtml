@using Exwhyzee.Messaging.Core.Models
@model ForgotPasswordViewModel

@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewBag.Title = "Recover Your Password";
}

<div class="xyz-auth-container">
    <!-- Left Showcase Side (Desktop) -->
    <div class="xyz-auth-side">
        <div>
            <a href="@Url.Action("Index", "Home")" class="xyz-brand" style="display:inline-block; background:#FFFFFF; padding:10px 20px; border-radius:10px; box-shadow:0 4px 14px rgba(0,0,0,0.2);">
                <img src="~/Content/image/SMS-LOGO.png" alt="Exwhyzee Bulk SMS" style="height:42px; width:auto; display:block;" />
            </a>
        </div>

        <div>
            <span style="display:inline-flex; align-items:center; gap:8px; background:rgba(229,9,20,0.15); color:var(--xyz-primary); border:1px solid rgba(229,9,20,0.3); padding:6px 14px; border-radius:var(--xyz-radius-full); font-size:0.8rem; font-weight:700; text-transform:uppercase; margin-bottom:16px;">
                <i class="fa fa-lock-open"></i> Account Recovery
            </span>
            <h2 style="font-size:2.2rem; font-weight:800; line-height:1.2; margin-bottom:16px;">
                Secure &amp; Instant Password Reset.
            </h2>
            <p style="color:var(--xyz-gray-400); font-size:1rem; line-height:1.6; max-width:400px;">
                Enter your registered email address to receive a secure 6-digit recovery OTP code and reset your password instantly.
            </p>
        </div>

        <div style="font-size:0.85rem; color:var(--xyz-gray-500);">
            &copy; @DateTime.UtcNow.Year <a href="https://exwhyzee.ng/" target="_blank" rel="noopener noreferrer" style="color:var(--xyz-gray-400); text-decoration:none; font-weight:700; transition:color 0.2s ease;">Exwhyzee Smart Solutions Limited</a>.
        </div>
    </div>

    <!-- Right Form Side -->
    <div class="xyz-auth-form-wrapper">
        <div class="xyz-auth-card" style="max-width:460px;">
            
            <!-- Mobile Brand Logo -->
            <div class="xyz-auth-mobile-logo" style="text-align:center; margin-bottom:20px;">
                <a href="@Url.Action("Index", "Home")" style="display:inline-block; background:#FFFFFF; padding:8px 18px; border-radius:8px; border:1px solid var(--xyz-gray-200); box-shadow:var(--xyz-shadow-sm);">
                    <img src="~/Content/image/SMS-LOGO.png" alt="Exwhyzee Bulk SMS" style="height:38px; width:auto; display:block;" />
                </a>
            </div>

            <div style="text-align:center; margin-bottom:28px;">
                <div style="width:54px; height:54px; background:rgba(229,9,20,0.1); color:var(--xyz-primary); border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:1.4rem; margin-bottom:12px;">
                    <i class="fa fa-key"></i>
                </div>
                <h1 style="font-size:1.6rem; font-weight:800; color:var(--xyz-dark-900); margin-bottom:6px;">Forgot Password</h1>
                <p style="color:var(--xyz-gray-500); font-size:0.9rem; margin:0;">Enter your email to receive a 6-digit reset code</p>
            </div>

            @if (TempData["error"] != null)
            {
                <div style="background:rgba(229,9,20,0.1); border:1px solid rgba(229,9,20,0.25); color:var(--xyz-primary); padding:12px 16px; border-radius:var(--xyz-radius-md); font-size:0.88rem; margin-bottom:18px; font-weight:600;">
                    <i class="fa fa-circle-exclamation"></i> @TempData["error"]
                </div>
            }

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { style = "color:var(--xyz-primary); font-size:0.88rem; margin-bottom:14px;" })

                <div class="xyz-input-icon-wrapper">
                    <i class="fa fa-envelope"></i>
                    <input type="email" class="xyz-calc-input" name="Email" placeholder="Enter Your Registered Email" required autofocus />
                    @Html.ValidationMessageFor(m => m.Email, "", new { style = "color:var(--xyz-primary); font-size:0.8rem;" })
                </div>

                <div style="margin-bottom:18px;">
                    <input type="hidden" name="g-recaptcha-response" id="recaptchaToken" />
                </div>

                <button type="submit" class="xyz-btn xyz-btn-primary" style="width:100%; padding:13px; font-weight:700;">
                    <i class="fa fa-paper-plane"></i> Send 6-Digit Reset Code
                </button>
            }

<script src="https://www.google.com/recaptcha/api.js?render=@(ViewBag.ReCaptchaSiteKey)"></script>
<script>
    document.querySelector('form').addEventListener('submit', function (e) {
        e.preventDefault();
        var form = this;
        grecaptcha.ready(function () {
            grecaptcha.execute('@(ViewBag.ReCaptchaSiteKey)', { action: 'forgot_password' }).then(function (token) {
                document.getElementById('recaptchaToken').value = token;
                form.submit();
            });
        });
    });
</script>

            <div style="text-align:center; margin-top:24px; padding-top:18px; border-top:1px solid var(--xyz-gray-200); font-size:0.9rem; color:var(--xyz-gray-600);">
                Remember your password?
                <a href="@Url.Action("Login", "Account")" style="color:var(--xyz-primary); font-weight:700; text-decoration:none;">
                    Sign In
                </a>
            </div>
        </div>
    </div>
</div>

@section styles {
<style>
    .xyz-auth-mobile-logo {
        display: none;
    }
    @@media (max-width: 900px) {
        .xyz-auth-mobile-logo {
            display: block !important;
        }
    }
</style>
}
