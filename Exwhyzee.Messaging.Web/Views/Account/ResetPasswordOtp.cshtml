@using Exwhyzee.Messaging.Core.Models
@model ResetPasswordOtpViewModel

@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewBag.Title = "Set New Password";
}

<div class="xyz-auth-container">
    <!-- Left Showcase Side (Desktop) -->
    <div class="xyz-auth-side">
        <div>
            <a href="@Url.Action("Index", "Home")" class="xyz-brand" style="display:inline-block; background:#FFFFFF; padding:10px 20px; border-radius:10px; box-shadow:0 4px 14px rgba(0,0,0,0.2);">
                <img src="~/Content/image/EXWHYZEE-BULK-SMS.png" alt="Exwhyzee Bulk SMS" style="height:42px; width:auto; display:block;" />
            </a>
        </div>

        <div>
            <span style="display:inline-flex; align-items:center; gap:8px; background:rgba(16,185,129,0.15); color:#10B981; border:1px solid rgba(16,185,129,0.3); padding:6px 14px; border-radius:var(--xyz-radius-full); font-size:0.8rem; font-weight:700; text-transform:uppercase; margin-bottom:16px;">
                <i class="fa fa-shield-alt"></i> Security Verification
            </span>
            <h2 style="font-size:2.2rem; font-weight:800; line-height:1.2; margin-bottom:16px;">
                Create a Strong New Password.
            </h2>
            <p style="color:var(--xyz-gray-300); font-size:1rem; line-height:1.6; max-width:400px;">
                Enter the 6-digit OTP code sent to your email along with your desired new password.
            </p>
        </div>

        <div style="font-size:0.85rem; color:var(--xyz-gray-500);">
            &copy; @DateTime.UtcNow.Year <a href="https://exwhyzee.ng/" target="_blank" rel="noopener noreferrer" style="color:var(--xyz-gray-400); text-decoration:none; font-weight:700; transition:color 0.2s ease;">Exwhyzee Smart Solutions Limited</a>.
        </div>
    </div>

    <!-- Right Form Side -->
    <div class="xyz-auth-form-wrapper">
        <div class="xyz-auth-card">
            
            <!-- Mobile Brand Logo -->
            <div class="xyz-auth-mobile-logo">
                <a href="@Url.Action("Index", "Home")" style="display:inline-block; background:#FFFFFF; padding:8px 18px; border-radius:8px; border:1px solid var(--xyz-gray-200); box-shadow:var(--xyz-shadow-sm);">
                    <img src="~/Content/image/EXWHYZEE-BULK-SMS.png" alt="Exwhyzee Bulk SMS" style="height:38px; width:auto; display:block;" />
                </a>
            </div>

            <div style="text-align:center; margin-bottom:24px;">
                <div style="width:56px; height:56px; background:rgba(229,9,20,0.1); color:var(--xyz-primary); border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:1.5rem; margin-bottom:12px;">
                    <i class="fa fa-key"></i>
                </div>
                <h1 style="font-size:1.6rem; font-weight:800; color:var(--xyz-dark-900); margin-bottom:6px;">Reset Password</h1>
                <p style="color:var(--xyz-gray-500); font-size:0.9rem; margin:0;">
                    Enter the code sent to <br/><strong style="color:var(--xyz-dark-900);">@Model.Email</strong>
                </p>
            </div>

            <div id="dynamicAlert"></div>

            @if (TempData["Success"] != null)
            {
                <div style="background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.3); color:#065f46; padding:12px 16px; border-radius:var(--xyz-radius-md); font-size:0.9rem; font-weight:600; margin-bottom:16px;">
                    <i class="fa fa-circle-check" style="color:#10B981; margin-right:6px;"></i> @TempData["Success"]
                </div>
            }

            @if (TempData["error"] != null || TempData["Error"] != null)
            {
                <div style="background:rgba(229,9,20,0.1); border:1px solid rgba(229,9,20,0.25); color:var(--xyz-primary); padding:12px 16px; border-radius:var(--xyz-radius-md); font-size:0.9rem; font-weight:600; margin-bottom:16px;">
                    <i class="fa fa-circle-exclamation" style="margin-right:6px;"></i> @(TempData["error"] ?? TempData["Error"])
                </div>
            }

            @using (Html.BeginForm("ResetPasswordOtp", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Email)
                @Html.ValidationSummary(true, "", new { style = "color:var(--xyz-primary); font-size:0.88rem; margin-bottom:14px;" })

                <div style="margin-bottom:16px;">
                    <input type="text" class="xyz-calc-input" name="OtpCode" placeholder="6-Digit Reset Code" maxlength="6" style="letter-spacing:6px; font-size:1.2rem; font-weight:700; text-align:center; height:48px; width:100%; box-sizing:border-box; border-radius:var(--xyz-radius-md); border:1px solid var(--xyz-gray-300);" required autofocus />
                    @Html.ValidationMessageFor(m => m.OtpCode, "", new { style = "color:var(--xyz-primary); font-size:0.8rem; text-align:center; display:block; margin-top:4px;" })
                </div>

                <div class="xyz-input-icon-wrapper">
                    <i class="fa fa-lock"></i>
                    <input type="password" id="newPassword" name="NewPassword" placeholder="New Password" required />
                    <button type="button" class="xyz-pwd-eye" onclick="togglePasswordVisibility('newPassword', this)">
                        <i class="fa fa-eye"></i>
                    </button>
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { style = "color:var(--xyz-primary); font-size:0.8rem;" })
                </div>

                <div class="xyz-input-icon-wrapper">
                    <i class="fa fa-lock"></i>
                    <input type="password" id="newConfirmPassword" name="ConfirmPassword" placeholder="Confirm New Password" required />
                    <button type="button" class="xyz-pwd-eye" onclick="togglePasswordVisibility('newConfirmPassword', this)">
                        <i class="fa fa-eye"></i>
                    </button>
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { style = "color:var(--xyz-primary); font-size:0.8rem;" })
                </div>

                <button type="submit" class="xyz-btn xyz-btn-primary" style="width:100%; padding:13px; font-weight:700; margin-top:4px;">
                    <i class="fa fa-lock"></i> Update Password &amp; Sign In
                </button>
            }

            <div style="text-align:center; margin-top:20px; font-size:0.9rem; color:var(--xyz-gray-600);">
                Didn't receive code?
                <span id="countdownWrapper" style="color:var(--xyz-gray-500); font-weight:600; margin-left:4px;">
                    Resend code in <strong id="countdownTimer" style="color:var(--xyz-primary);">60</strong>s
                </span>
                <a id="resendLink" href="javascript:void(0)" onclick="resendResetOtp(event)" style="display:none; color:var(--xyz-primary); font-weight:700; text-decoration:none; margin-left:4px;">
                    <i class="fa fa-rotate-right"></i> Resend Code
                </a>
            </div>

            <div style="text-align:center; margin-top:16px; padding-top:16px; border-top:1px solid var(--xyz-gray-200); font-size:0.88rem;">
                <a href="@Url.Action("Login", "Account")" style="color:var(--xyz-gray-500); text-decoration:none;">
                    &larr; Back to Sign In
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    let countdownInterval = null;

    function startCountdown(seconds) {
        let timeLeft = seconds;
        const timerElem = document.getElementById('countdownTimer');
        const wrapperElem = document.getElementById('countdownWrapper');
        const resendLink = document.getElementById('resendLink');

        if (wrapperElem) wrapperElem.style.display = 'inline';
        if (resendLink) resendLink.style.display = 'none';
        if (timerElem) timerElem.textContent = timeLeft;

        if (countdownInterval) clearInterval(countdownInterval);

        countdownInterval = setInterval(function () {
            timeLeft--;
            if (timerElem) {
                timerElem.textContent = timeLeft;
            }
            if (timeLeft <= 0) {
                clearInterval(countdownInterval);
                if (wrapperElem) wrapperElem.style.display = 'none';
                if (resendLink) resendLink.style.display = 'inline';
            }
        }, 1000);
    }

    function resendResetOtp(e) {
        if (e) e.preventDefault();
        const resendLink = document.getElementById('resendLink');
        const alertBox = document.getElementById('dynamicAlert');
        const email = '@Model.Email';

        if (resendLink) {
            resendLink.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Resending code...';
            resendLink.style.pointerEvents = 'none';
        }

        fetch('@Url.Action("ResendPasswordResetOtp", "Account")?email=' + encodeURIComponent(email), {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (resendLink) {
                resendLink.innerHTML = '<i class="fa fa-rotate-right"></i> Resend Code';
                resendLink.style.pointerEvents = 'auto';
            }

            if (data.success) {
                if (alertBox) {
                    alertBox.innerHTML = '<div style="background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.3); color:#065f46; padding:12px 16px; border-radius:var(--xyz-radius-md); font-size:0.9rem; font-weight:600; margin-bottom:16px; animation:fadeIn 0.3s ease;"><i class="fa fa-circle-check" style="color:#10B981; margin-right:6px;"></i> ' + data.message + '</div>';
                }
                startCountdown(60);
            } else {
                if (alertBox) {
                    alertBox.innerHTML = '<div style="background:rgba(229,9,20,0.1); border:1px solid rgba(229,9,20,0.25); color:var(--xyz-primary); padding:12px 16px; border-radius:var(--xyz-radius-md); font-size:0.9rem; font-weight:600; margin-bottom:16px; animation:fadeIn 0.3s ease;"><i class="fa fa-circle-exclamation" style="margin-right:6px;"></i> ' + data.message + '</div>';
                }
            }
        })
        .catch(err => {
            if (resendLink) {
                resendLink.innerHTML = '<i class="fa fa-rotate-right"></i> Resend Code';
                resendLink.style.pointerEvents = 'auto';
            }
            if (alertBox) {
                alertBox.innerHTML = '<div style="background:rgba(229,9,20,0.1); border:1px solid rgba(229,9,20,0.25); color:var(--xyz-primary); padding:12px 16px; border-radius:var(--xyz-radius-md); font-size:0.9rem; font-weight:600; margin-bottom:16px;"><i class="fa fa-circle-exclamation" style="margin-right:6px;"></i> Error resending code. Please try again.</div>';
            }
        });
    }

    // Start initial 60s countdown on page load
    startCountdown(60);
</script>
}
