@{
    ViewBag.Title = "Two-Factor Authentication Verification";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    var method = ViewBag.Method != null ? (Exwhyzee.Messaging.Core.Models.TwoFactorMethod)ViewBag.Method : Exwhyzee.Messaging.Core.Models.TwoFactorMethod.None;
    string target = ViewBag.MaskedTarget as string ?? "your device";
}

<style>
    .xyz-otp-card {
        background: #FFFFFF;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
        padding: 32px 28px;
        max-width: 440px;
        margin: 40px auto;
        text-align: center;
    }

    .xyz-otp-icon {
        width: 64px;
        height: 64px;
        background: #EFF6FF;
        color: #2563EB;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin-bottom: 16px;
    }

    .xyz-otp-input {
        letter-spacing: 12px;
        font-size: 1.8rem;
        font-weight: 800;
        text-align: center;
        height: 56px;
        border-radius: 10px;
        border: 2px solid #CBD5E1;
        color: #0F172A;
        font-family: 'JetBrains Mono', monospace;
        transition: all 0.2s ease;
    }

    .xyz-otp-input:focus {
        border-color: #2563EB;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
    }
</style>

<div class="xyz-otp-card">
    <div class="xyz-otp-icon">
        @if (method == Exwhyzee.Messaging.Core.Models.TwoFactorMethod.GoogleAuth)
        {
            <i class="fa fa-google"></i>
        }
        else if (method == Exwhyzee.Messaging.Core.Models.TwoFactorMethod.MicrosoftAuth)
        {
            <i class="fa fa-windows"></i>
        }
        else if (method == Exwhyzee.Messaging.Core.Models.TwoFactorMethod.SmsOtp)
        {
            <i class="fa fa-mobile-alt"></i>
        }
        else
        {
            <i class="fa fa-envelope-open-text"></i>
        }
    </div>

    <h3 style="font-weight: 800; color: #0F172A; margin: 0 0 8px 0; letter-spacing: -0.5px;">2-Step Verification</h3>
    <p style="color: #64748B; font-size: 0.9rem; margin-bottom: 24px;">
        @if (method == Exwhyzee.Messaging.Core.Models.TwoFactorMethod.GoogleAuth || method == Exwhyzee.Messaging.Core.Models.TwoFactorMethod.MicrosoftAuth)
        {
            <span>Enter the 6-digit code generated by your <strong>@(method == Exwhyzee.Messaging.Core.Models.TwoFactorMethod.GoogleAuth ? "Google Authenticator" : "Microsoft Authenticator")</strong> app.</span>
        }
        else if (method == Exwhyzee.Messaging.Core.Models.TwoFactorMethod.SmsOtp)
        {
            <span>Enter the 6-digit SMS verification code sent to <strong style="color: #0F172A;">@target</strong>.</span>
        }
        else
        {
            <span>Enter the 6-digit verification code sent to <strong style="color: #0F172A;">@target</strong>.</span>
        }
    </p>

    @Html.Partial("_ResponseMessagePartial")

    @using (Html.BeginForm("VerifyTwoFactor", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-group" style="margin-bottom: 24px;">
            <input type="text" name="code" class="form-control xyz-otp-input" placeholder="000000" maxlength="6" autofocus required autocomplete="off" />
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg" style="font-weight: 800; border-radius: 10px; height: 48px; background: #2563EB; font-size: 1rem;">
            <i class="fa fa-shield-alt"></i> Verify &amp; Login
        </button>
    }

    @if (method == Exwhyzee.Messaging.Core.Models.TwoFactorMethod.SmsOtp || method == Exwhyzee.Messaging.Core.Models.TwoFactorMethod.EmailOtp)
    {
        <div style="margin-top: 20px;">
            <button type="button" class="btn btn-link" id="btnResend" onclick="resendOtpCode()" style="color: #2563EB; font-weight: 700; font-size: 0.85rem; text-decoration: none;">
                <i class="fa fa-rotate-right"></i> Didn't receive code? Resend
            </button>
        </div>
    }

    <div style="margin-top: 24px; border-top: 1px solid #F1F5F9; padding-top: 16px;">
        <a href="@Url.Action("Login", "Account")" style="color: #64748B; font-weight: 600; font-size: 0.85rem;">
            <i class="fa fa-arrow-left"></i> Return to Login
        </a>
    </div>
</div>

<script>
    function resendOtpCode() {
        const btn = document.getElementById('btnResend');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Resending code...';
        }

        $.ajax({
            url: '@Url.Action("ResendTwoFactorCode", "Account")',
            type: 'POST',
            success: function (res) {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa fa-rotate-right"></i> Didn\'t receive code? Resend';
                }
                alert(res.message || 'Code resent.');
            },
            error: function () {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa fa-rotate-right"></i> Didn\'t receive code? Resend';
                }
                alert('Error resending code. Please try again.');
            }
        });
    }
</script>
