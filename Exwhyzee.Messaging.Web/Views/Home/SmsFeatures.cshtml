@{
    ViewBag.Title = "Platform Features & Capabilities";
}

<!-- Page Header Hero -->
<section class="xyz-hero" style="padding:50px 0 60px;">
    <div class="xyz-container" style="text-align:center; max-width:800px;">
        <span class="xyz-hero-badge">
            <i class="fa fa-sparkles"></i> Comprehensive Messaging Suite
        </span>
        <h1 class="xyz-hero-title">
            Enterprise Features Built for <span class="gradient-text">Speed & Deliverability</span>
        </h1>
        <p class="xyz-hero-subtitle" style="margin:0 auto 28px;">
            Whether you are broadcasting targeted customer appreciation notices, price updates, event announcements, or high-volume marketing campaigns, Exwhyzee Messaging provides the tools, speed, and reliability you need.
        </p>
        <div style="display:flex; justify-content:center; gap:14px;">
            <a href="@Url.Action("Register", "Account")" class="xyz-btn xyz-btn-primary">
                <i class="fa fa-user-plus"></i> Get Started Free
            </a>
            <a href="@Url.Action("SmsPlan", "Home")" class="xyz-btn xyz-btn-outline">
                <i class="fa fa-tags"></i> View Pricing
            </a>
        </div>
    </div>
</section>

<!-- Detailed Feature Grid -->
<section class="xyz-section">
    <div class="xyz-container">
        <div class="xyz-section-header">
            <span class="xyz-section-tag">Core Capabilities</span>
            <h2 class="xyz-section-title">Everything Needed for Modern Campaigns</h2>
            <p class="xyz-section-desc">
                From intelligent number filtering to instant webhook delivery notifications, explore our full feature ecosystem.
            </p>
        </div>

        <div class="xyz-feature-grid">
            <!-- Item 1 -->
            <div class="xyz-feature-card">
                <div class="xyz-feature-icon">
                    <i class="fa fa-route"></i>
                </div>
                <h3 class="xyz-feature-title">Smart Direct Carrier Routing</h3>
                <p class="xyz-feature-desc">
                    Our platform automatically detects network congestion and routes messages through the fastest direct telco gateway interconnects with automatic failover.
                </p>
            </div>

            <!-- Item 2 -->
            <div class="xyz-feature-card">
                <div class="xyz-feature-icon">
                    <i class="fa fa-signature"></i>
                </div>
                <h3 class="xyz-feature-title">Branded Alphanumeric Sender IDs</h3>
                <p class="xyz-feature-desc">
                    Register custom sender names (up to 11 characters) representing your company or brand name. Build immediate brand recognition with every SMS.
                </p>
            </div>

            <!-- Item 3 -->
            <div class="xyz-feature-card">
                <div class="xyz-feature-icon">
                    <i class="fa fa-file-excel"></i>
                </div>
                <h3 class="xyz-feature-title">CSV & Excel Contact Importer</h3>
                <p class="xyz-feature-desc">
                    Effortlessly upload contact lists with hundreds of thousands of phone numbers. Our engine automatically removes duplicates and formats national prefixes.
                </p>
            </div>

            <!-- Item 4 -->
            <div class="xyz-feature-card">
                <div class="xyz-feature-icon">
                    <i class="fa fa-calendar-check"></i>
                </div>
                <h3 class="xyz-feature-title">Scheduled & Recurring Broadcasts</h3>
                <p class="xyz-feature-desc">
                    Schedule messages for future dispatch — birthdays, meeting reminders, or festive greetings. Powered by reliable background job processors.
                </p>
            </div>

            <!-- Item 5 -->
            <div class="xyz-feature-card">
                <div class="xyz-feature-icon">
                    <i class="fa fa-chart-pie"></i>
                </div>
                <h3 class="xyz-feature-title">Live Delivery Receipts (DLR)</h3>
                <p class="xyz-feature-desc">
                    Track the exact delivery status of every phone number in real time. Download comprehensive delivery logs for reconciliation and reporting.
                </p>
            </div>

            <!-- Item 6 -->
            <div class="xyz-feature-card">
                <div class="xyz-feature-icon">
                    <i class="fa fa-shield-virus"></i>
                </div>
                <h3 class="xyz-feature-title">Anti-Spam & Blacklist Filter</h3>
                <p class="xyz-feature-desc">
                    Built-in content analysis proactively catches blacklisted phrases that could trigger telecom operator blocks, protecting your sender reputation.
                </p>
            </div>

            <!-- Item 7 -->
            <div class="xyz-feature-card">
                <div class="xyz-feature-icon">
                    <i class="fa fa-globe"></i>
                </div>
                <h3 class="xyz-feature-title">Global International Coverage</h3>
                <p class="xyz-feature-desc">
                    Reach recipients in over 200+ countries with automatic international dial code detection and transparent per-country unit pricing.
                </p>
            </div>

            <!-- Item 8 -->
            <div class="xyz-feature-card">
                <div class="xyz-feature-icon">
                    <i class="fa fa-ticket"></i>
                </div>
                <h3 class="xyz-feature-title">Scratch Voucher & Card Top-Up</h3>
                <p class="xyz-feature-desc">
                    In addition to instant online card payments, top up messaging credits using physical/digital scratch voucher PINs or bank wire transfers.
                </p>
            </div>

            <!-- Item 9 -->
            <div class="xyz-feature-card">
                <div class="xyz-feature-icon">
                    <i class="fa fa-code"></i>
                </div>
                <h3 class="xyz-feature-title">Full-Featured REST API</h3>
                <p class="xyz-feature-desc">
                    Integrate seamlessly into mobile apps, CRM systems, websites, or billing platforms with standard JSON REST endpoints and API Key security.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Comparison Matrix -->
<section class="xyz-section" style="background:var(--xyz-gray-100);">
    <div class="xyz-container">
        <div class="xyz-section-header">
            <span class="xyz-section-tag">Why Choose Us</span>
            <h2 class="xyz-section-title">Exwhyzee vs. Generic SMS Aggregators</h2>
            <p class="xyz-section-desc">
                See why businesses and software engineers choose Exwhyzee Messaging for mission-critical notifications.
            </p>
        </div>

        <div class="xyz-table-wrapper">
            <table class="xyz-table">
                <thead>
                    <tr>
                        <th>Platform Capability</th>
                        <th style="color:var(--xyz-primary);"><i class="fa fa-shield"></i> Exwhyzee Messaging</th>
                        <th>Generic SMS Platforms</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Direct Telco Interconnects</strong></td>
                        <td style="color:var(--xyz-success); font-weight:700;"><i class="fa fa-check-circle"></i> Direct Tier-1 Routes</td>
                        <td style="color:var(--xyz-gray-500);"><i class="fa fa-circle-xmark"></i> Shared / Multi-hop Hops</td>
                    </tr>
                    <tr>
                        <td><strong>Average Delivery Speed</strong></td>
                        <td style="color:var(--xyz-success); font-weight:700;"><i class="fa fa-bolt"></i> &lt; 2.4 Seconds</td>
                        <td style="color:var(--xyz-gray-500);">30 - 180 Seconds</td>
                    </tr>
                    <tr>
                        <td><strong>DND (Do-Not-Disturb) Auto-Bypass</strong></td>
                        <td style="color:var(--xyz-success); font-weight:700;"><i class="fa fa-check-circle"></i> Supported</td>
                        <td style="color:var(--xyz-gray-500);"><i class="fa fa-circle-xmark"></i> Frequently Dropped</td>
                    </tr>
                    <tr>
                        <td><strong>Credit Expiration Policy</strong></td>
                        <td style="color:var(--xyz-success); font-weight:700;"><i class="fa fa-check-circle"></i> Never Expires</td>
                        <td style="color:var(--xyz-gray-500);">Expires in 30–90 days</td>
                    </tr>
                    <tr>
                        <td><strong>Payment Methods</strong></td>
                        <td style="color:var(--xyz-success); font-weight:700;"><i class="fa fa-check-circle"></i> Card, Transfer, Vouchers, USSD</td>
                        <td style="color:var(--xyz-gray-500);">Card Only</td>
                    </tr>
                    <tr>
                        <td><strong>Developer REST API & Webhooks</strong></td>
                        <td style="color:var(--xyz-success); font-weight:700;"><i class="fa fa-check-circle"></i> Full JSON REST API</td>
                        <td style="color:var(--xyz-gray-500);">Legacy HTTP GET only</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- 3-Step Onboarding -->
<section class="xyz-section">
    <div class="xyz-container">
        <div class="xyz-section-header">
            <span class="xyz-section-tag">Easy Setup</span>
            <h2 class="xyz-section-title">How It Works in 3 Simple Steps</h2>
        </div>

        <div class="xyz-feature-grid">
            <div style="text-align:center; padding:20px;">
                <div style="width:60px; height:60px; border-radius:50%; background:var(--xyz-primary); color:white; font-size:1.5rem; font-weight:800; display:flex; align-items:center; justify-content:center; margin:0 auto 20px;">1</div>
                <h3 style="font-size:1.2rem; font-weight:700; margin-bottom:10px;">Create Free Account</h3>
                <p style="color:var(--xyz-gray-600); font-size:0.92rem;">Register in under 60 seconds with instant test messaging units loaded into your account.</p>
            </div>
            <div style="text-align:center; padding:20px;">
                <div style="width:60px; height:60px; border-radius:50%; background:var(--xyz-dark-900); color:white; font-size:1.5rem; font-weight:800; display:flex; align-items:center; justify-content:center; margin:0 auto 20px;">2</div>
                <h3 style="font-size:1.2rem; font-weight:700; margin-bottom:10px;">Top-Up Units Online</h3>
                <p style="color:var(--xyz-gray-600); font-size:0.92rem;">Purchase messaging credits using Paystack, scratch card vouchers, or direct bank transfer.</p>
            </div>
            <div style="text-align:center; padding:20px;">
                <div style="width:60px; height:60px; border-radius:50%; background:var(--xyz-success); color:white; font-size:1.5rem; font-weight:800; display:flex; align-items:center; justify-content:center; margin:0 auto 20px;">3</div>
                <h3 style="font-size:1.2rem; font-weight:700; margin-bottom:10px;">Broadcast & Monitor</h3>
                <p style="color:var(--xyz-gray-600); font-size:0.92rem;">Send campaigns via web dashboard or integrate our REST API to deliver at scale.</p>
            </div>
        </div>
    </div>
</section>
