@{
    ViewBag.Title = "About Us";
}

<!-- Section 1: Hero & Heritage -->
<section class="xyz-hero" style="padding:60px 0 70px;">
    <div class="xyz-container" style="text-align:center; max-width:850px;">
        <span class="xyz-hero-badge" style="background:rgba(229,9,20,0.1); color:var(--xyz-primary); border-color:rgba(229,9,20,0.25);">
            <i class="fa fa-award"></i> Trusted Since 2014 • Over a Decade of Excellence
        </span>
        <h1 class="xyz-hero-title">
            Pioneering Enterprise <span class="gradient-text">Messaging in Africa</span> Since 2014
        </h1>
        <p class="xyz-hero-subtitle" style="margin:0 auto 32px; font-size:1.15rem; line-height:1.7;">
            For over 12 years, <strong>Exwhyzee Smart Solutions Limited</strong> has powered mission-critical mobile communications for SMEs, educational institutions, religious bodies, fintechs, and multinational corporations across Africa.
        </p>

        <!-- Trust Metric Pills -->
        <div style="display:flex; justify-content:center; gap:20px; flex-wrap:wrap;">
            <div style="background:white; border:1px solid var(--xyz-gray-200); padding:12px 24px; border-radius:var(--xyz-radius-md); box-shadow:var(--xyz-shadow-sm);">
                <div style="font-size:1.6rem; font-weight:800; color:var(--xyz-primary);">2014</div>
                <div style="font-size:0.8rem; color:var(--xyz-gray-500); text-transform:uppercase; font-weight:600;">Year Founded</div>
            </div>
            <div style="background:white; border:1px solid var(--xyz-gray-200); padding:12px 24px; border-radius:var(--xyz-radius-md); box-shadow:var(--xyz-shadow-sm);">
                <div style="font-size:1.6rem; font-weight:800; color:var(--xyz-dark-900);">50M+</div>
                <div style="font-size:0.8rem; color:var(--xyz-gray-500); text-transform:uppercase; font-weight:600;">SMS Delivered</div>
            </div>
            <div style="background:white; border:1px solid var(--xyz-gray-200); padding:12px 24px; border-radius:var(--xyz-radius-md); box-shadow:var(--xyz-shadow-sm);">
                <div style="font-size:1.6rem; font-weight:800; color:var(--xyz-dark-900);">12,000+</div>
                <div style="font-size:0.8rem; color:var(--xyz-gray-500); text-transform:uppercase; font-weight:600;">Active Clients</div>
            </div>
            <div style="background:white; border:1px solid var(--xyz-gray-200); padding:12px 24px; border-radius:var(--xyz-radius-md); box-shadow:var(--xyz-shadow-sm);">
                <div style="font-size:1.6rem; font-weight:800; color:#10B981;">99.98%</div>
                <div style="font-size:0.8rem; color:var(--xyz-gray-500); text-transform:uppercase; font-weight:600;">Direct Uptime</div>
            </div>
        </div>
    </div>
</section>

<!-- Section 2: Journey & History Timeline -->
<section class="xyz-section" style="background:var(--xyz-gray-100);">
    <div class="xyz-container">
        <div class="xyz-section-header">
            <span class="xyz-section-tag">Our History</span>
            <h2 class="xyz-section-title">A Decade of Continuous Innovation</h2>
            <p class="xyz-section-desc">
                From our foundational launch in 2014 to powering modern high-velocity broadcasts today, explore our milestones.
            </p>
        </div>

        <div style="max-width:850px; margin:0 auto; position:relative; padding-left:30px; border-left:3px solid var(--xyz-primary);">
            
            <!-- Milestone 1 -->
            <div style="position:relative; margin-bottom:40px;">
                <div style="position:absolute; left:-41px; top:0; width:20px; height:20px; background:var(--xyz-primary); border:4px solid white; border-radius:50%; box-shadow:0 0 0 2px var(--xyz-primary);"></div>
                <span style="font-size:0.85rem; font-weight:800; color:var(--xyz-primary); background:rgba(229,9,20,0.1); padding:4px 10px; border-radius:4px;">2014</span>
                <h3 style="font-size:1.3rem; font-weight:800; color:var(--xyz-dark-900); margin:8px 0 6px;">Foundation & Platform Launch</h3>
                <p style="color:var(--xyz-gray-600); line-height:1.6; margin:0;">
                    Exwhyzee entered the digital communications space with a clear vision: to eliminate the frustrating delivery failures and opaque billing prevalent in early SMS gateways by offering transparent pay-as-you-go bulk SMS pipelines for Nigerian businesses.
                </p>
            </div>

            <!-- Milestone 2 -->
            <div style="position:relative; margin-bottom:40px;">
                <div style="position:absolute; left:-41px; top:0; width:20px; height:20px; background:var(--xyz-primary); border:4px solid white; border-radius:50%; box-shadow:0 0 0 2px var(--xyz-primary);"></div>
                <span style="font-size:0.85rem; font-weight:800; color:var(--xyz-primary); background:rgba(229,9,20,0.1); padding:4px 10px; border-radius:4px;">2017</span>
                <h3 style="font-size:1.3rem; font-weight:800; color:var(--xyz-dark-900); margin:8px 0 6px;">Tier-1 Direct Carrier Interconnects</h3>
                <p style="color:var(--xyz-gray-600); line-height:1.6; margin:0;">
                    Expanded our routing infrastructure with direct telecommunications host links across MTN, Airtel, Globacom, and 9mobile. This slashed average message latency to under 3 seconds and guaranteed rock-solid deliverability during peak festive periods.
                </p>
            </div>

            <!-- Milestone 3 -->
            <div style="position:relative; margin-bottom:40px;">
                <div style="position:absolute; left:-41px; top:0; width:20px; height:20px; background:var(--xyz-primary); border:4px solid white; border-radius:50%; box-shadow:0 0 0 2px var(--xyz-primary);"></div>
                <span style="font-size:0.85rem; font-weight:800; color:var(--xyz-primary); background:rgba(229,9,20,0.1); padding:4px 10px; border-radius:4px;">2020</span>
                <h3 style="font-size:1.3rem; font-weight:800; color:var(--xyz-dark-900); margin:8px 0 6px;">Instant Online Auto-Funding & DND Priority</h3>
                <p style="color:var(--xyz-gray-600); line-height:1.6; margin:0;">
                    Integrated Paystack for instant 24/7 online wallet top-ups (Card, Bank Transfer, USSD), removing the friction of manual bank proof uploads. Rolled out corporate hosted routes with automatic DND bypass capabilities.
                </p>
            </div>

            <!-- Milestone 4 -->
            <div style="position:relative; margin-bottom:40px;">
                <div style="position:absolute; left:-41px; top:0; width:20px; height:20px; background:var(--xyz-primary); border:4px solid white; border-radius:50%; box-shadow:0 0 0 2px var(--xyz-primary);"></div>
                <span style="font-size:0.85rem; font-weight:800; color:var(--xyz-primary); background:rgba(229,9,20,0.1); padding:4px 10px; border-radius:4px;">2023</span>
                <h3 style="font-size:1.3rem; font-weight:800; color:var(--xyz-dark-900); margin:8px 0 6px;">Developer REST API Ecosystem</h3>
                <p style="color:var(--xyz-gray-600); line-height:1.6; margin:0;">
                    Launched our public RESTful Developer API enabling engineers to embed high-volume SMS broadcast capabilities into third-party web apps, school portals, ERP systems, and mobile applications with pre-built SDKs.
                </p>
            </div>

            <!-- Milestone 5 -->
            <div style="position:relative;">
                <div style="position:absolute; left:-41px; top:0; width:20px; height:20px; background:#10B981; border:4px solid white; border-radius:50%; box-shadow:0 0 0 2px #10B981;"></div>
                <span style="font-size:0.85rem; font-weight:800; color:#10B981; background:rgba(16,185,129,0.1); padding:4px 10px; border-radius:4px;">2026 &amp; Beyond</span>
                <h3 style="font-size:1.3rem; font-weight:800; color:var(--xyz-dark-900); margin:8px 0 6px;">Africa's Premier High-Velocity SMS Platform</h3>
                <p style="color:var(--xyz-gray-600); line-height:1.6; margin:0;">
                    With over 50 million messages dispatched and dual physical headquarters in Abuja and Umuahia, we continue to lead the continent in messaging deliverability, transparent pricing, and 24/7 client satisfaction.
                </p>
            </div>

        </div>
    </div>
</section>

<!-- Section 3: Core Pillars & Enterprise Guarantees -->
<section class="xyz-section">
    <div class="xyz-container">
        <div class="xyz-section-header">
            <span class="xyz-section-tag">Why Choose Us</span>
            <h2 class="xyz-section-title">Built on Trust, Speed &amp; Integrity</h2>
            <p class="xyz-section-desc">
                Everything we build is engineered around providing unbeatable value and absolute peace of mind.
            </p>
        </div>

        <div class="xyz-feature-grid">
            <div class="xyz-feature-card">
                <div class="xyz-feature-icon" style="background:rgba(229,9,20,0.1); color:var(--xyz-primary);">
                    <i class="fa fa-route"></i>
                </div>
                <h3 class="xyz-feature-title">Guaranteed Deliverability</h3>
                <p class="xyz-feature-desc">
                    We maintain multi-carrier failover routing across all Nigerian and international networks, ensuring your broadcasts hit recipient inboxes in sub-seconds.
                </p>
            </div>

            <div class="xyz-feature-card">
                <div class="xyz-feature-icon" style="background:rgba(16,185,129,0.1); color:#10B981;">
                    <i class="fa fa-shield-halved"></i>
                </div>
                <h3 class="xyz-feature-title">Strict Data Confidentiality</h3>
                <p class="xyz-feature-desc">
                    Your contact phone books and uploaded recipient lists belong exclusively to you. We enforce zero third-party sharing and adhere strictly to NDPR guidelines.
                </p>
            </div>

            <div class="xyz-feature-card">
                <div class="xyz-feature-icon" style="background:rgba(99,102,241,0.1); color:var(--xyz-indigo);">
                    <i class="fa fa-clock-rotate-left"></i>
                </div>
                <h3 class="xyz-feature-title">Lifetime Credit Validity</h3>
                <p class="xyz-feature-desc">
                    Unlike other platforms that expire your balance after 30 days, messaging units on Exwhyzee never expire. What you purchase is yours until used.
                </p>
            </div>

            <div class="xyz-feature-card">
                <div class="xyz-feature-icon" style="background:rgba(245,158,11,0.1); color:var(--xyz-warning);">
                    <i class="fa fa-headset"></i>
                </div>
                <h3 class="xyz-feature-title">24/7 Human Customer Support</h3>
                <p class="xyz-feature-desc">
                    Our dedicated support engineers are on standby via live WhatsApp, phone, email, and desk tickets to resolve custom sender ID requests and queries promptly.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Section 4: Physical Presence & Call to Action -->
<section class="xyz-section" style="background:linear-gradient(135deg, var(--xyz-dark-900), var(--xyz-dark-800)); color:white; padding:60px 0;">
    <div class="xyz-container">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center;">
            <div>
                <span style="color:var(--xyz-primary); font-weight:800; text-transform:uppercase; font-size:0.85rem; letter-spacing:0.08em; display:block; margin-bottom:8px;">
                    Enterprise Footprint
                </span>
                <h2 style="font-size:2rem; font-weight:800; color:white; margin-bottom:16px; line-height:1.3;">
                    Physical Locations You Can Trust
                </h2>
                <p style="color:var(--xyz-gray-300); font-size:1rem; line-height:1.7; margin-bottom:24px;">
                    Behind our automated technology is a registered corporate organization with physical office branches ready to support your business expansion:
                </p>
                <div style="display:flex; flex-direction:column; gap:12px; font-size:0.95rem; color:var(--xyz-gray-300);">
                    <div>
                        <strong style="color:white;"><i class="fa fa-location-dot" style="color:var(--xyz-primary); margin-right:8px;"></i> Main Office:</strong>
                        No. 37 urban dwell estate, airport road, abuja
                    </div>
                    <div>
                        <strong style="color:white;"><i class="fa fa-location-dot" style="color:var(--xyz-primary); margin-right:8px;"></i> Branch Office:</strong>
                        NO. 44, Azikiwe Road, Umuahia.
                    </div>
                </div>
            </div>

            <div style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:var(--xyz-radius-lg); padding:36px; text-align:center;">
                <h3 style="font-size:1.5rem; font-weight:800; color:white; margin-bottom:10px;">Ready to Scale Your Reach?</h3>
                <p style="color:var(--xyz-gray-400); font-size:0.92rem; margin-bottom:24px; line-height:1.6;">
                    Join over 12,000 satisfied businesses, schools, churches, and brands broadcasting with confidence.
                </p>
                <div style="display:flex; flex-direction:column; gap:12px;">
                    <a href="@Url.Action("Register", "Account")" class="xyz-btn xyz-btn-primary xyz-btn-lg" style="width:100%;">
                        <i class="fa fa-user-plus"></i> Claim 20 Free Test Units
                    </a>
                    <a href="@Url.Action("Contact", "Home")" class="xyz-btn xyz-btn-outline xyz-btn-lg" style="width:100%; color:white; border-color:rgba(255,255,255,0.3);">
                        <i class="fa fa-headset"></i> Contact Our Team
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
