@{
    ViewBag.Title = "Developer API & Documentation";
}

<!-- Developer Hero -->
<section class="xyz-hero" style="background:radial-gradient(circle at 80% 20%, rgba(99,102,241,0.08) 0%, transparent 60%), var(--xyz-white); padding:50px 0 60px;">
    <div class="xyz-container" style="text-align:center; max-width:850px;">
        <span class="xyz-hero-badge" style="background:var(--xyz-indigo-light); color:var(--xyz-indigo); border-color:rgba(99,102,241,0.2);">
            <i class="fa fa-terminal"></i> REST API v1.1.0
        </span>
        <h1 class="xyz-hero-title">
            Programmatic Messaging for <span class="gradient-text">Developers</span>
        </h1>
        <p class="xyz-hero-subtitle" style="margin:0 auto 28px;">
            Send transactional alerts, OTPs, balance queries, sender ID checks, and high-volume broadcasts directly from your code with our lightning-fast, high-deliverability JSON REST API.
        </p>
        <div style="display:flex; justify-content:center; gap:14px; flex-wrap:wrap;">
            <a href="@Url.Action("Register", "Account")" class="xyz-btn xyz-btn-primary">
                <i class="fa fa-key"></i> Get Your Free API Key
            </a>
            <a href="#endpoints" class="xyz-btn xyz-btn-outline">
                <i class="fa fa-book-open"></i> Explore 5 Endpoints
            </a>
            <a href="@Url.Action("Documentation", "ApiSettings", new { area = "ClientPanel" })" target="_blank" class="xyz-btn" style="background:#0F172A; color:#FFFFFF; border:1px solid #1E293B;">
                <i class="fa fa-bolt" style="color:#F59E0B;"></i> Interactive Studio
            </a>
        </div>
    </div>
</section>

<!-- Authentication Guide -->
<section class="xyz-section" style="padding-top:20px; padding-bottom:30px;">
    <div class="xyz-container">
        <div class="xyz-feature-card" style="border-left:4px solid var(--xyz-primary);">
            <h3 class="xyz-feature-title" style="display:flex; align-items:center; gap:10px;">
                <i class="fa fa-shield-halved" style="color:var(--xyz-primary);"></i> Authentication Methods
            </h3>
            <p class="xyz-feature-desc" style="margin-bottom:16px;">
                Authenticate your API requests by providing the API Key generated in your <a href="@Url.Action("Index", "ApiSettings", new { area = "ClientPanel" })" style="font-weight:700; color:var(--xyz-primary);">Client Dashboard</a>. We support 3 flexible methods:
            </p>
            <div style="background:var(--xyz-dark-900); padding:18px 22px; border-radius:var(--xyz-radius-md); font-family:var(--xyz-font-mono); font-size:0.88rem; color:#E2E8F0; overflow-x:auto;">
                <span style="color:#94A3B8;"># Method 1: Custom Header (Recommended)</span><br/>
                <code>X-Api-Key: xyz_key_YOUR_API_KEY_HERE</code><br/><br/>
                <span style="color:#94A3B8;"># Method 2: Standard Bearer Token Header</span><br/>
                <code>Authorization: Bearer xyz_key_YOUR_API_KEY_HERE</code><br/><br/>
                <span style="color:#94A3B8;"># Method 3: Query Parameter</span><br/>
                <code>https://api.xyzsms.com/api/sms/balance?apikey=xyz_key_YOUR_API_KEY_HERE</code>
            </div>
        </div>
    </div>
</section>

<!-- Endpoints Section -->
<section class="xyz-section" id="endpoints" style="background:var(--xyz-gray-100); padding:50px 0 80px;">
    <div class="xyz-container">
        <div class="xyz-section-header">
            <span class="xyz-section-tag">API Reference</span>
            <h2 class="xyz-section-title">Core REST Endpoints</h2>
            <p class="xyz-section-desc">
                Simple, predictable HTTP endpoints with multi-language code snippets and standard JSON payloads.
            </p>
        </div>

        <div style="display:flex; flex-direction:column; gap:36px;">

            <!-- ========================================== -->
            <!-- ENDPOINT 1: SEND SMS (Single & Bulk)       -->
            <!-- ========================================== -->
            <div class="xyz-feature-card" style="padding:32px;">
                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:16px;">
                    <div style="display:flex; align-items:center; gap:12px;">
                        <span style="background:#10B981; color:white; font-weight:800; font-size:0.8rem; padding:4px 10px; border-radius:6px; font-family:var(--xyz-font-mono);">POST</span>
                        <h3 style="margin:0; font-size:1.35rem; font-family:var(--xyz-font-mono); color:var(--xyz-dark-900);">/api/sms/send</h3>
                    </div>
                    <span style="background:#EEF2FF; color:#4F46E5; font-size:0.82rem; font-weight:700; padding:4px 12px; border-radius:100px;">Single & Bulk Dispatch</span>
                </div>
                <p style="color:var(--xyz-gray-600); margin-bottom:20px; font-size:1.02rem;">
                    Dispatches a single message or high-volume bulk broadcast to one or multiple recipient phone numbers (comma or newline separated). Units are automatically debited in real-time.
                </p>

                <!-- Code Switcher Box -->
                <div class="xyz-code-block-wrapper" style="margin-bottom:24px;">
                    <div class="xyz-code-header" style="background:#0F172A; padding:10px 16px; border-top-left-radius:10px; border-top-right-radius:10px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                        <div class="xyz-code-tabs" style="display:flex; gap:6px;">
                            <button class="xyz-code-tab active" onclick="switchSnippet(this, 'send-curl')" style="background:transparent; border:none; color:#CBD5E1; font-weight:700; padding:6px 12px; border-radius:6px; cursor:pointer;">cURL</button>
                            <button class="xyz-code-tab" onclick="switchSnippet(this, 'send-csharp')" style="background:transparent; border:none; color:#94A3B8; font-weight:700; padding:6px 12px; border-radius:6px; cursor:pointer;">C# (.NET)</button>
                            <button class="xyz-code-tab" onclick="switchSnippet(this, 'send-python')" style="background:transparent; border:none; color:#94A3B8; font-weight:700; padding:6px 12px; border-radius:6px; cursor:pointer;">Python</button>
                            <button class="xyz-code-tab" onclick="switchSnippet(this, 'send-node')" style="background:transparent; border:none; color:#94A3B8; font-weight:700; padding:6px 12px; border-radius:6px; cursor:pointer;">Node.js</button>
                            <button class="xyz-code-tab" onclick="switchSnippet(this, 'send-php')" style="background:transparent; border:none; color:#94A3B8; font-weight:700; padding:6px 12px; border-radius:6px; cursor:pointer;">PHP</button>
                        </div>
                        <button type="button" onclick="copySnippet(this)" style="background:#1E293B; border:none; color:#94A3B8; font-weight:700; font-size:0.8rem; padding:6px 12px; border-radius:6px; cursor:pointer;">
                            <i class="fa fa-copy"></i> Copy
                        </button>
                    </div>

                    <pre id="send-curl" class="snippet-pane" style="margin:0; background:#020617; color:#E2E8F0; padding:20px; font-family:var(--xyz-font-mono); font-size:0.88rem; border-bottom-left-radius:10px; border-bottom-right-radius:10px; overflow-x:auto;"><code>curl -X POST "https://api.xyzsms.com/api/sms/send" \
  -H "X-Api-Key: xyz_key_YOUR_API_KEY" \
  -H "Content-Type: application/json" \
  -d '{
    "senderId": "XYZSMS",
    "recipients": "08012345678,08123456789",
    "messageContent": "Hello! Your one-time verification code is 849201. Valid for 10 minutes."
  }'</code></pre>

                    <pre id="send-csharp" class="snippet-pane" style="display:none; margin:0; background:#020617; color:#E2E8F0; padding:20px; font-family:var(--xyz-font-mono); font-size:0.88rem; border-bottom-left-radius:10px; border-bottom-right-radius:10px; overflow-x:auto;"><code>using System.Net.Http;
using System.Text;
using System.Text.Json;

using var client = new HttpClient();
client.DefaultRequestHeaders.Add("X-Api-Key", "xyz_key_YOUR_API_KEY");

var payload = new
{
    senderId = "XYZSMS",
    recipients = "08012345678,08123456789",
    messageContent = "Hello! Your one-time verification code is 849201. Valid for 10 minutes."
};

var content = new StringContent(JsonSerializer.Serialize(payload), Encoding.UTF8, "application/json");
var response = await client.PostAsync("https://api.xyzsms.com/api/sms/send", content);
string result = await response.Content.ReadAsStringAsync();
Console.WriteLine(result);</code></pre>

                    <pre id="send-python" class="snippet-pane" style="display:none; margin:0; background:#020617; color:#E2E8F0; padding:20px; font-family:var(--xyz-font-mono); font-size:0.88rem; border-bottom-left-radius:10px; border-bottom-right-radius:10px; overflow-x:auto;"><code>import requests

url = "https://api.xyzsms.com/api/sms/send"
headers = {
    "X-Api-Key": "xyz_key_YOUR_API_KEY",
    "Content-Type": "application/json"
}
payload = {
    "senderId": "XYZSMS",
    "recipients": "08012345678,08123456789",
    "messageContent": "Hello! Your one-time verification code is 849201. Valid for 10 minutes."
}

response = requests.post(url, json=payload, headers=headers)
print(response.json())</code></pre>

                    <pre id="send-node" class="snippet-pane" style="display:none; margin:0; background:#020617; color:#E2E8F0; padding:20px; font-family:var(--xyz-font-mono); font-size:0.88rem; border-bottom-left-radius:10px; border-bottom-right-radius:10px; overflow-x:auto;"><code>const response = await fetch("https://api.xyzsms.com/api/sms/send", {
  method: "POST",
  headers: {
    "X-Api-Key": "xyz_key_YOUR_API_KEY",
    "Content-Type": "application/json"
  },
  body: JSON.stringify({
    senderId: "XYZSMS",
    recipients: "08012345678,08123456789",
    messageContent: "Hello! Your one-time verification code is 849201. Valid for 10 minutes."
  })
});
const data = await response.json();
console.log(data);</code></pre>

                    <pre id="send-php" class="snippet-pane" style="display:none; margin:0; background:#020617; color:#E2E8F0; padding:20px; font-family:var(--xyz-font-mono); font-size:0.88rem; border-bottom-left-radius:10px; border-bottom-right-radius:10px; overflow-x:auto;"><code>&lt;?php
$payload = [
    "senderId" => "XYZSMS",
    "recipients" => "08012345678,08123456789",
    "messageContent" => "Hello! Your one-time verification code is 849201. Valid for 10 minutes."
];

$ch = curl_init("https://api.xyzsms.com/api/sms/send");
curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
curl_setopt($ch, CURLOPT_HTTPHEADER, [
    "X-Api-Key: xyz_key_YOUR_API_KEY",
    "Content-Type: application/json"
]);
curl_setopt($ch, CURLOPT_POST, true);
curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($payload));

$response = curl_exec($ch);
curl_close($ch);
echo $response;
?&gt;</code></pre>
                </div>

                <h4 style="font-size:0.95rem; font-weight:700; text-transform:uppercase; color:var(--xyz-gray-500); margin-bottom:8px;">Sample JSON Response (200 OK)</h4>
                <div style="background:var(--xyz-dark-900); padding:16px 20px; border-radius:var(--xyz-radius-md); font-family:var(--xyz-font-mono); font-size:0.85rem; color:#10B981; overflow-x:auto;">
<pre style="margin:0; color:inherit;">{
  "success": true,
  "message": "Message dispatched successfully",
  "totalUnitsUsed": 3.0,
  "recipientsCount": 2,
  "batchReference": "XYZ-TXN-840291"
}</pre>
                </div>
            </div>

