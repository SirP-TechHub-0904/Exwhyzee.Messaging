<!-- Interactive Language Switcher Script -->
<script>
    function switchSnippet(btn, paneId) {
        var wrapper = btn.closest('.xyz-code-block-wrapper');
        wrapper.querySelectorAll('.xyz-code-tab').forEach(function(tab) {
            tab.classList.remove('active');
            tab.style.color = '#94A3B8';
        });
        btn.classList.add('active');
        btn.style.color = '#CBD5E1';

        wrapper.querySelectorAll('.snippet-pane').forEach(function(pane) {
            pane.style.display = 'none';
        });
        var targetPane = document.getElementById(paneId);
        if (targetPane) {
            targetPane.style.display = 'block';
        }
    }

    function copySnippet(btn) {
        var wrapper = btn.closest('.xyz-code-block-wrapper');
        var activePane = wrapper.querySelector('.snippet-pane:not([style*="display: none"])') || wrapper.querySelector('.snippet-pane');
        if (activePane) {
            var text = activePane.innerText;
            navigator.clipboard.writeText(text).then(function() {
                var orig = btn.innerHTML;
                btn.innerHTML = '<i class="fa fa-check" style="color:#10B981;"></i> Copied!';
                setTimeout(function() {
                    btn.innerHTML = orig;
                }, 2000);
            });
        }
    }
</script>
