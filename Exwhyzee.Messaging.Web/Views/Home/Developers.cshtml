}</pre>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- ENDPOINT 3: DELIVERY HISTORY & LOGS        -->
            <!-- ========================================== -->
            <div class="xyz-feature-card" style="padding:32px;">
                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:16px;">
                    <div style="display:flex; align-items:center; gap:12px;">
                        <span style="background:#6366F1; color:white; font-weight:800; font-size:0.8rem; padding:4px 10px; border-radius:6px; font-family:var(--xyz-font-mono);">GET</span>
                        <h3 style="margin:0; font-size:1.35rem; font-family:var(--xyz-font-mono); color:var(--xyz-dark-900);">/api/sms/history</h3>
                    </div>
                    <span style="background:#FEF3C7; color:#D97706; font-size:0.82rem; font-weight:700; padding:4px 12px; border-radius:100px;">Paginated & Filterable</span>
                </div>
                <p style="color:var(--xyz-gray-600); margin-bottom:16px; font-size:1.02rem;">
                    Retrieves outbound message delivery logs with complete server-side pagination, total counts, and multi-parameter filters.
                </p>

                <!-- Query Parameters Table -->
                <div style="margin-bottom:20px; overflow-x:auto;">
                    <table class="table" style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px; width:100%; font-size:0.9rem;">
                        <thead>
                            <tr style="background:#F8FAFC; color:#475569;">
                                <th style="padding:10px 14px;">Parameter</th>
                                <th style="padding:10px 14px;">Type</th>
                                <th style="padding:10px 14px;">Default</th>
                                <th style="padding:10px 14px;">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="padding:10px 14px; font-family:var(--xyz-font-mono); font-weight:700; color:#6366F1;">page</td>
                                <td style="padding:10px 14px;">integer</td>
                                <td style="padding:10px 14px;">1</td>
                                <td style="padding:10px 14px;">Page number (1-based index).</td>
                            </tr>
                            <tr>
                                <td style="padding:10px 14px; font-family:var(--xyz-font-mono); font-weight:700; color:#6366F1;">pageSize</td>
                                <td style="padding:10px 14px;">integer</td>
                                <td style="padding:10px 14px;">50</td>
                                <td style="padding:10px 14px;">Number of records per page (max: 200).</td>
                            </tr>
                            <tr>
                                <td style="padding:10px 14px; font-family:var(--xyz-font-mono); font-weight:700; color:#6366F1;">senderId</td>
                                <td style="padding:10px 14px;">string</td>
                                <td style="padding:10px 14px;">null</td>
                                <td style="padding:10px 14px;">Optional filter by Sender ID (e.g. <code>XYZSMS</code>).</td>
                            </tr>
                            <tr>
                                <td style="padding:10px 14px; font-family:var(--xyz-font-mono); font-weight:700; color:#6366F1;">recipient</td>
                                <td style="padding:10px 14px;">string</td>
                                <td style="padding:10px 14px;">null</td>
                                <td style="padding:10px 14px;">Optional filter by recipient phone number.</td>
                            </tr>
                            <tr>
                                <td style="padding:10px 14px; font-family:var(--xyz-font-mono); font-weight:700; color:#6366F1;">status</td>
                                <td style="padding:10px 14px;">string</td>
                                <td style="padding:10px 14px;">null</td>
                                <td style="padding:10px 14px;">Optional filter by status (<code>Sent</code>, <code>Delivered</code>, <code>Failed</code>).</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div style="background:#0F172A; padding:16px 20px; border-radius:var(--xyz-radius-md); font-family:var(--xyz-font-mono); font-size:0.88rem; color:#E2E8F0; margin-bottom:20px; overflow-x:auto;">
                    <code>curl -X GET "https://api.xyzsms.com/api/sms/history?page=1&pageSize=20&senderId=XYZSMS" -H "X-Api-Key: xyz_key_YOUR_API_KEY"</code>
                </div>

                <h4 style="font-size:0.95rem; font-weight:700; text-transform:uppercase; color:var(--xyz-gray-500); margin-bottom:8px;">Sample JSON Response (200 OK)</h4>
