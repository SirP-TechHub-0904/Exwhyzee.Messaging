@{
    ViewBag.Title = "Frequently Asked Questions (FAQ)";
}

<!-- Hero Section -->
<section class="xyz-hero" style="padding:50px 0 60px;">
    <div class="xyz-container" style="text-align:center; max-width:800px;">
        <span class="xyz-hero-badge">
            <i class="fa fa-circle-question"></i> Help & Knowledge Base
        </span>
        <h1 class="xyz-hero-title">
            Frequently Asked <span class="gradient-text">Questions</span>
        </h1>
        <p class="xyz-hero-subtitle" style="margin:0 auto 20px;">
            Find quick answers to common questions about buying units, sender IDs, DND bypass, message deliverability, and developer APIs.
        </p>
    </div>
</section>

<!-- FAQ Accordion Section -->
<section class="xyz-section" style="padding-top:20px;">
    <div class="xyz-container" style="max-width:850px;">
        
        <div style="display:flex; flex-direction:column; gap:16px;">
            <!-- FAQ 1 -->
            <details class="xyz-feature-card" style="padding:24px; cursor:pointer;" open>
                <summary style="font-weight:700; font-size:1.15rem; color:var(--xyz-dark-900); list-style:none; display:flex; justify-content:space-between; align-items:center;">
                    <span>What is Bulk SMS and how does it benefit my business?</span>
                    <i class="fa fa-chevron-down" style="color:var(--xyz-primary); font-size:0.9rem;"></i>
                </summary>
                <div style="margin-top:16px; color:var(--xyz-gray-600); line-height:1.7; border-top:1px solid var(--xyz-gray-200); padding-top:14px; font-size:0.95rem;">
                    Bulk SMS allows you to send a single text message to thousands or millions of mobile phone numbers simultaneously within seconds. With a 98%+ open rate within 3 minutes of delivery, it is the most direct, cost-effective, and high-converting marketing and customer communication channel available today.
                </div>
            </details>

            <!-- FAQ 2 -->
            <details class="xyz-feature-card" style="padding:24px; cursor:pointer;">
                <summary style="font-weight:700; font-size:1.15rem; color:var(--xyz-dark-900); list-style:none; display:flex; justify-content:space-between; align-items:center;">
                    <span>Do purchased SMS units ever expire?</span>
                    <i class="fa fa-chevron-down" style="color:var(--xyz-primary); font-size:0.9rem;"></i>
                </summary>
                <div style="margin-top:16px; color:var(--xyz-gray-600); line-height:1.7; border-top:1px solid var(--xyz-gray-200); padding-top:14px; font-size:0.95rem;">
                    <strong>No.</strong> Your messaging units have <strong>lifetime validity</strong>. Once purchased, they remain securely credited to your wallet balance until you decide to use them, whether tomorrow, next month, or next year.
                </div>
            </details>

            <!-- FAQ 3 -->
            <details class="xyz-feature-card" style="padding:24px; cursor:pointer;">
                <summary style="font-weight:700; font-size:1.15rem; color:var(--xyz-dark-900); list-style:none; display:flex; justify-content:space-between; align-items:center;">
                    <span>How does Do-Not-Disturb (DND) delivery work on your platform?</span>
                    <i class="fa fa-chevron-down" style="color:var(--xyz-primary); font-size:0.9rem;"></i>
                </summary>
                <div style="margin-top:16px; color:var(--xyz-gray-600); line-height:1.7; border-top:1px solid var(--xyz-gray-200); padding-top:14px; font-size:0.95rem;">
                    Exwhyzee utilizes direct hosted corporate gateways that automatically route messages through prioritized telecommunications channels to deliver your broadcasts even to numbers with active DND (Do-Not-Disturb) restrictions at zero extra penalty.
                </div>
            </details>

            <!-- FAQ 4 -->
            <details class="xyz-feature-card" style="padding:24px; cursor:pointer;">
                <summary style="font-weight:700; font-size:1.15rem; color:var(--xyz-dark-900); list-style:none; display:flex; justify-content:space-between; align-items:center;">
                    <span>How many characters equal 1 SMS page?</span>
                    <i class="fa fa-chevron-down" style="color:var(--xyz-primary); font-size:0.9rem;"></i>
                </summary>
                <div style="margin-top:16px; color:var(--xyz-gray-600); line-height:1.7; border-top:1px solid var(--xyz-gray-200); padding-top:14px; font-size:0.95rem;">
                    A standard text message contains up to <strong>160 characters</strong> (including spaces and punctuation) for the 1st page. When a message exceeds 160 characters, it concatenates into a multi-part message where each subsequent page is calculated at 153 characters according to international GSM telecommunications standards.
                </div>
            </details>

            <!-- FAQ 5 -->
            <details class="xyz-feature-card" style="padding:24px; cursor:pointer;">
                <summary style="font-weight:700; font-size:1.15rem; color:var(--xyz-dark-900); list-style:none; display:flex; justify-content:space-between; align-items:center;">
                    <span>What payment methods can I use to top up my wallet?</span>
                    <i class="fa fa-chevron-down" style="color:var(--xyz-primary); font-size:0.9rem;"></i>
                </summary>
                <div style="margin-top:16px; color:var(--xyz-gray-600); line-height:1.7; border-top:1px solid var(--xyz-gray-200); padding-top:14px; font-size:0.95rem;">
                    We offer multiple convenient payment options:
                    <ul style="margin:8px 0 0 20px;">
                        <li><strong>Instant Online Card/Bank/USSD:</strong> Powered securely by Paystack for instant 24/7 wallet funding.</li>
                        <li><strong>Direct Bank Wire/Transfer:</strong> Transfer to our verified corporate bank accounts and submit your payment reference for fast manual crediting.</li>
                        <li><strong>Recharge Voucher Cards:</strong> Redeem pre-generated Exwhyzee SMS recharge pins directly on your dashboard.</li>
                    </ul>
                </div>
            </details>

            <!-- FAQ 6 -->
            <details class="xyz-feature-card" style="padding:24px; cursor:pointer;">
                <summary style="font-weight:700; font-size:1.15rem; color:var(--xyz-dark-900); list-style:none; display:flex; justify-content:space-between; align-items:center;">
                    <span>How can I register a custom Sender ID?</span>
                    <i class="fa fa-chevron-down" style="color:var(--xyz-primary); font-size:0.9rem;"></i>
                </summary>
                <div style="margin-top:16px; color:var(--xyz-gray-600); line-height:1.7; border-top:1px solid var(--xyz-gray-200); padding-top:14px; font-size:0.95rem;">
                    Sender IDs can be up to 11 alphanumeric characters (e.g. <code>YourBrand</code>, <code>GraceChurch</code>, <code>ApexSchool</code>). You can specify your sender ID when composing messages. For corporate or financial institution sender IDs requiring official carrier pre-registration, contact our support team or submit your request via your client dashboard.
                </div>
            </details>

            <!-- FAQ 7 -->
            <details class="xyz-feature-card" style="padding:24px; cursor:pointer;">
                <summary style="font-weight:700; font-size:1.15rem; color:var(--xyz-dark-900); list-style:none; display:flex; justify-content:space-between; align-items:center;">
                    <span>Can I integrate Exwhyzee SMS into my website, CRM, or software?</span>
                    <i class="fa fa-chevron-down" style="color:var(--xyz-primary); font-size:0.9rem;"></i>
                </summary>
                <div style="margin-top:16px; color:var(--xyz-gray-600); line-height:1.7; border-top:1px solid var(--xyz-gray-200); padding-top:14px; font-size:0.95rem;">
                    <strong>Yes!</strong> We provide powerful, high-throughput REST APIs with code samples in cURL, C#, Python, Node.js, and PHP. Check out our <a href="@Url.Action("Developers", "Home")" style="color:var(--xyz-primary); font-weight:700;">Developers & API Documentation</a> to get started in minutes.
                </div>
            </details>
        </div>

        <!-- Help Desk CTA Box -->
        <div class="xyz-feature-card" style="margin-top:40px; padding:32px; text-align:center; background:linear-gradient(135deg, var(--xyz-dark-900), var(--xyz-dark-800)); color:white;">
            <h3 style="font-size:1.4rem; font-weight:800; margin-bottom:8px; color:white;">Still Have Questions?</h3>
            <p style="color:var(--xyz-gray-400); font-size:0.95rem; margin-bottom:20px;">
                Our 24/7 dedicated support team is available via live chat, WhatsApp, email, and phone.
            </p>
            <div style="display:flex; justify-content:center; gap:16px; flex-wrap:wrap;">
                <a href="https://wa.me/2348068669344" target="_blank" class="xyz-btn xyz-btn-primary">
                    <i class="fab fa-whatsapp"></i> Chat on WhatsApp
                </a>
                <a href="@Url.Action("Contact", "Home")" class="xyz-btn xyz-btn-outline" style="color:white; border-color:rgba(255,255,255,0.3);">
                    <i class="fa fa-envelope"></i> Contact Support Desk
                </a>
            </div>
        </div>

    </div>
</section>
