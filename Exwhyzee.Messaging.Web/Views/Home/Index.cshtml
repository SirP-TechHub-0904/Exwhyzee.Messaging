        <div class="xyz-code-block-wrapper">
            <div class="xyz-code-header">
                <div class="xyz-code-tabs">
                    <button class="xyz-code-tab active" data-lang="curl">cURL</button>
                    <button class="xyz-code-tab" data-lang="csharp">C# (.NET)</button>
                    <button class="xyz-code-tab" data-lang="python">Python</button>
                    <button class="xyz-code-tab" data-lang="node">Node.js</button>
                    <button class="xyz-code-tab" data-lang="php">PHP</button>
                </div>
                <button class="xyz-copy-btn" id="xyzCopyCodeBtn">
                    <i class="fa fa-copy"></i> Copy Code
                </button>
            </div>
            <pre class="xyz-code-content"><code>curl -X POST "https://api.xyzsms.com/api/sms/send" \
  -H "ApiKey: YOUR_API_TOKEN_HERE" \
  -H "Content-Type: application/json" \
  -d '{
    "senderId": "YourBrand",
    "recipients": "2348012345678,2348098765432",
    "content": "Dear Customer, thank you for your patronage! Enjoy 10% off with code THANKYOU."
  }'</code></pre>
        </div>

