@{
    ViewBag.Title = "Enterprise Bulk SMS Broadcast Platform";
    var admin = ViewBag.AdminSetting as Exwhyzee.Messaging.Core.Models.AdminSetting;
    decimal pricePerUnit = admin != null && admin.PricePerUnit > 0 ? admin.PricePerUnit : 2.00m;
}

