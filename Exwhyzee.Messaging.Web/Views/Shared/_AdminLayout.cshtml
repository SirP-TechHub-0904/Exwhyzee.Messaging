@using Microsoft.AspNetCore.Identity
@using Exwhyzee.Messaging.Core.Services
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - XYZSMS Admin</title>
    <link href="/Content/image/xyzico.png" rel="shortcut icon" type="image/x-icon" />

    <!-- Google Fonts & Font Awesome 6 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Core Layout Stylesheets -->
    <link rel="stylesheet" href="/Content/Dashboard/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/Content/Dashboard/dist/css/AdminLTE.min.css" />
    <link rel="stylesheet" href="/Content/Dashboard/dist/css/skins/_all-skins.min.css" />
    <link rel="stylesheet" href="/Content/Dashboard/plugins/datepicker/datepicker3.css" />
    <link href="/Content/css/modern-theme.css" rel="stylesheet" />

    <style>
        :root {
            --xyz-dash-header-h: 76px;
            --xyz-dash-sidebar-w: 290px;
            --xyz-dash-bg: #F8FAFC;
            --xyz-dash-card-bg: #FFFFFF;
            --xyz-dash-text: #0F172A;
            --xyz-dash-muted: #64748B;
            --xyz-dash-border: #E2E8F0;
        }

        /* ========================================================
           GLOBAL COMPACT TYPOGRAPHY SCALE FOR ADMIN PANEL (-40%)
           ======================================================== */
        html {
            font-size: 13px !important;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
            font-size: 1rem !important;
            line-height: 1.45 !important;
            color: var(--xyz-dash-text);
            background-color: var(--xyz-dash-bg) !important;
        }

        h1, .h1 { font-size: 1.35rem !important; font-weight: 700 !important; letter-spacing: -0.2px !important; }
        h2, .h2 { font-size: 1.2rem !important; font-weight: 700 !important; }
        h3, .h3 { font-size: 1.08rem !important; font-weight: 700 !important; }
        h4, .h4 { font-size: 0.98rem !important; font-weight: 600 !important; }
        h5, .h5 { font-size: 0.9rem !important; font-weight: 600 !important; }
        h6, .h6 { font-size: 0.82rem !important; font-weight: 600 !important; }

        p, span, div, li, td, th { font-size: 0.96rem; }
        small, .small { font-size: 0.78rem !important; }

        label, .control-label {
            font-size: 0.88rem !important;
            font-weight: 600 !important;
            margin-bottom: 3px !important;
            color: var(--xyz-dash-text) !important;
        }

        .form-control, input[type="text"], input[type="password"], input[type="email"], input[type="number"], input[type="date"], select, textarea {
            font-size: 0.92rem !important;
            min-height: 34px !important;
            padding: 6px 10px !important;
            border-radius: 6px !important;
            color: var(--xyz-dash-text) !important;
        }

        .btn {
            font-size: 0.88rem !important;
            font-weight: 600 !important;
            padding: 6px 14px !important;
            border-radius: 6px !important;
        }

        .btn-lg { font-size: 0.96rem !important; padding: 8px 20px !important; border-radius: 8px !important; }
        .btn-sm { font-size: 0.8rem !important; padding: 4px 8px !important; border-radius: 5px !important; }
        .btn-xs { font-size: 0.72rem !important; padding: 2px 6px !important; border-radius: 4px !important; }
        .badge { font-size: 0.75rem !important; padding: 3px 7px !important; border-radius: 4px !important; }

        .table th, .table td {
            font-size: 0.88rem !important;
            padding: 7px 9px !important;
            vertical-align: middle !important;
        }

        .alert { font-size: 0.88rem !important; padding: 9px 14px !important; border-radius: 6px !important; }
        .alert strong { font-size: 0.95rem !important; }
        .modal-title { font-size: 1.05rem !important; font-weight: 700 !important; }
        .modal-body { font-size: 0.88rem !important; }
        code, kbd, pre { font-size: 0.82rem !important; }

        body.xyz-dark-theme {
            --xyz-dash-bg: #0B0F19;
            --xyz-dash-card-bg: #131B2E;
            --xyz-dash-text: #F8FAFC;
            --xyz-dash-muted: #94A3B8;
            --xyz-dash-border: rgba(255, 255, 255, 0.08);
            background-color: #0B0F19 !important;
            color: #F8FAFC !important;
        }

        body.xyz-dark-theme .content-wrapper,
        body.xyz-dark-theme .main-footer {
            background-color: #0B0F19 !important;
            color: #F8FAFC !important;
            border-color: var(--xyz-dash-border) !important;
        }

        body.xyz-dark-theme .xyz-panel-card,
        body.xyz-dark-theme .box {
            background: #131B2E !important;
            border-color: rgba(255, 255, 255, 0.08) !important;
            color: #F8FAFC !important;
        }

        body.xyz-dark-theme .table { color: #E2E8F0 !important; }
        body.xyz-dark-theme .table-striped > tbody > tr:nth-of-type(odd) { background-color: rgba(255, 255, 255, 0.02) !important; }
        body.xyz-dark-theme .table-bordered,
        body.xyz-dark-theme .table-bordered > tbody > tr > td,
        body.xyz-dark-theme .table-bordered > thead > tr > th { border-color: rgba(255, 255, 255, 0.06) !important; }

        /* Unified Modern Header */
        .main-header {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            height: var(--xyz-dash-header-h) !important;
            max-height: var(--xyz-dash-header-h) !important;
            background: #0B0F19 !important;
            z-index: 1030 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            padding: 0 24px !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15) !important;
        }

        .main-header .sidebar-toggle:before {
            display: none !important;
            content: "" !important;
        }

        /* Topbar Controls */
        .xyz-topbar-controls {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .xyz-icon-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #FFFFFF;
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
            font-size: 1.25rem;
            text-decoration: none !important;
        }

        .xyz-icon-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            color: #FFFFFF;
        }

        .xyz-badge-dot {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 9px;
            height: 9px;
            background: #E50914;
            border-radius: 50%;
            border: 2px solid #0B0F19;
        }

        /* Modern Sidebar */
        .main-sidebar {
            position: fixed !important;
            top: var(--xyz-dash-header-h) !important;
            left: 0 !important;
            bottom: 0 !important;
            height: calc(100vh - var(--xyz-dash-header-h)) !important;
            overflow-y: auto !important;
            background: #0B0F19 !important;
            border-right: 1px solid rgba(255, 255, 255, 0.06) !important;
            width: var(--xyz-dash-sidebar-w) !important;
            padding-top: 0 !important;
            z-index: 1020 !important;
            transition: transform 0.3s ease, width 0.3s ease !important;
        }

        .sidebar-user-card {
            padding: 18px 20px;
            margin: 18px 16px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .sidebar-user-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #6366F1;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.35rem;
            box-shadow: 0 4px 12px rgba(99,102,241,0.35);
            flex-shrink: 0;
        }

        .sidebar-user-name {
            font-size: 1.2rem;
            font-weight: 800;
            color: #FFFFFF;
            margin: 0 0 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar-user-status {
            font-size: 0.95rem;
            font-weight: 600;
            color: #10B981;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .sidebar-menu {
            padding-bottom: 140px !important;
        }

        .sidebar-menu > li.header {
            color: #64748B !important;
            background: transparent !important;
            font-size: 0.92rem !important;
            font-weight: 800 !important;
            letter-spacing: 0.8px !important;
            padding: 20px 22px 10px !important;
        }

        .sidebar-menu > li > a {
            color: #94A3B8 !important;
            border-left: 3px solid transparent !important;
            padding: 14px 22px !important;
            font-size: 1.15rem !important;
            font-weight: 600 !important;
            display: flex !important;
            align-items: center !important;
            gap: 14px !important;
            transition: all 0.2s ease !important;
        }

        .sidebar-menu > li > a i {
            font-size: 1.35rem !important;
            width: 24px !important;
            text-align: center !important;
            color: #64748B !important;
            transition: color 0.2s ease !important;
        }

        .sidebar-menu > li:hover > a,
        .sidebar-menu > li.active > a {
            color: #FFFFFF !important;
            background: rgba(99, 102, 241, 0.1) !important;
            border-left-color: #6366F1 !important;
        }

        .sidebar-menu > li:hover > a i,
        .sidebar-menu > li.active > a i {
            color: #6366F1 !important;
        }

        .sidebar-menu .treeview-menu {
            background: rgba(0, 0, 0, 0.25) !important;
            padding: 8px 0 !important;
        }

        .sidebar-menu .treeview-menu > li > a {
            color: #94A3B8 !important;
            padding: 10px 22px 10px 48px !important;
            font-size: 1.05rem !important;
            font-weight: 500 !important;
        }

        .sidebar-menu .treeview-menu > li > a:hover {
            color: #FFFFFF !important;
        }

        /* Content Wrapper */
        .content-wrapper {
            margin-top: var(--xyz-dash-header-h) !important;
            margin-left: var(--xyz-dash-sidebar-w) !important;
            min-height: calc(100vh - var(--xyz-dash-header-h) - 50px) !important;
            background: var(--xyz-dash-bg) !important;
            padding: 32px 40px !important;
            transition: margin-left 0.3s ease, background 0.3s ease !important;
        }

        /* Desktop Mini-Sidebar Collapse Behavior (Show Only Icons) */
        @@media (min-width: 992px) {
            body.sidebar-collapse .main-sidebar {
                width: 78px !important;
                transform: none !important;
            }

            body.sidebar-collapse .content-wrapper,
            body.sidebar-collapse .main-footer {
                margin-left: 78px !important;
            }

            body.sidebar-collapse .sidebar-user-card {
                padding: 10px 0 !important;
                margin: 12px 6px !important;
                justify-content: center !important;
                border: none !important;
                background: transparent !important;
            }

            body.sidebar-collapse .sidebar-user-card > div:last-child {
                display: none !important;
            }

            body.sidebar-collapse .sidebar-user-avatar {
                width: 44px !important;
                height: 44px !important;
                font-size: 1.2rem !important;
                margin: 0 auto !important;
            }

            body.sidebar-collapse .sidebar-menu > li.header {
                display: none !important;
            }

            body.sidebar-collapse .sidebar-menu > li > a {
                padding: 16px 0 !important;
                justify-content: center !important;
                text-align: center !important;
                gap: 0 !important;
            }

            body.sidebar-collapse .sidebar-menu > li > a span {
                display: none !important;
            }

            body.sidebar-collapse .sidebar-menu > li > a .pull-right-container {
                display: none !important;
            }

            body.sidebar-collapse .sidebar-menu > li > a i {
                font-size: 1.5rem !important;
                width: 100% !important;
                margin: 0 !important;
            }
        }

        /* Footer */
        .main-footer {
            margin-left: var(--xyz-dash-sidebar-w) !important;
            background: #FFFFFF;
            border-top: 1px solid #E2E8F0;
            padding: 18px 40px;
            font-size: 1rem;
            color: var(--xyz-dash-muted);
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: margin-left 0.3s ease !important;
        }

        /* Responsive Mobile */
        @@media (max-width: 991px) {
            .xyz-desktop-only { display: none !important; }
            .main-sidebar { transform: translateX(-100%) !important; }
            body.sidebar-open .main-sidebar { transform: translateX(0) !important; }
            .content-wrapper, .main-footer { margin-left: 0 !important; padding: 20px 16px !important; }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body class="hold-transition skin-blue sidebar-mini">
    <div class="wrapper">

        <!-- Unified Modern Header -->
        <header class="main-header">
            <!-- Left Side: Logo + Divider + Sidebar Toggle -->
            <div style="display:flex; align-items:center; gap:14px;">
                <a href="@Url.Action("Index", "Main", new { area = "Adminpanel" })" style="display:inline-flex; align-items:center; text-decoration:none;">
                    <div style="background:#FFFFFF; padding:6px 14px; border-radius:8px; display:inline-flex; align-items:center; box-shadow:0 2px 8px rgba(0,0,0,0.15);">
                        <img src="/Content/image/EXWHYZEE-BULK-SMS.png" alt="XYZSMS Admin" style="height:32px; width:auto; display:block;" />
                    </div>
                </a>

                <div style="width:1px; height:26px; background:rgba(255,255,255,0.12);" class="hidden-xs"></div>

                <!-- Sidebar Toggle Button -->
                <a href="#" class="sidebar-toggle xyz-icon-btn" data-toggle="offcanvas" role="button" title="Toggle Sidebar">
                    <i class="fa fa-bars"></i>
                    <span class="sr-only">Toggle navigation</span>
                </a>
            </div>

            <!-- Right Side: Controls -->
            <div class="xyz-topbar-controls">
                <!-- Pending Transactions Badge -->
                <a href="@Url.Content("~/adminpanel/transactions")" class="xyz-icon-btn" title="Pending Transactions" style="position:relative;">
                    <i class="fa fa-receipt"></i>
                    <span class="xyz-badge-dot"></span>
                </a>

                <!-- Dark / Light Switcher -->
                <button type="button" class="xyz-icon-btn xyz-desktop-only" id="xyzThemeToggleBtn" title="Toggle Dark/Light Mode">
                    <i class="fa fa-moon" id="xyzThemeIcon"></i>
                </button>

                <!-- Fullscreen Toggle -->
                <button type="button" class="xyz-icon-btn xyz-desktop-only" id="xyzFullscreenToggleBtn" title="Toggle Fullscreen">
                    <i class="fa fa-expand" id="xyzFullscreenIcon"></i>
                </button>

                <!-- User Account Dropdown -->
                <div class="dropdown" style="display:inline-block;">
                    <button class="dropdown-toggle" data-toggle="dropdown" style="background:transparent; border:none; display:flex; align-items:center; gap:10px; padding:0; cursor:pointer;">
                        <div class="sidebar-user-avatar" style="width:42px; height:42px; font-size:1.15rem;">
                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "A")
                        </div>
                        <span class="hidden-xs" style="color:#FFFFFF; font-weight:800; font-size:1.05rem;">
                            @User.Identity.Name
                            <i class="fa fa-angle-down" style="margin-left:4px; font-size:0.9rem; color:#94A3B8;"></i>
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-right" style="right:0; left:auto; min-width:260px; border-radius:14px; padding:0; box-shadow:0 10px 30px rgba(0,0,0,0.18); overflow:hidden;">
                        <li style="padding:16px 20px; background:#0B0F19; color:#FFFFFF;">
                            <div style="font-weight:800; font-size:1.1rem;">@User.Identity.Name</div>
                            <div style="font-size:0.9rem; color:#94A3B8;">System Administrator</div>
                        </li>
                        <li style="padding:8px 0;">
                            <a href="@Url.Content("~/clientpanel/dashboard")" style="padding:11px 20px; display:flex; align-items:center; gap:10px; font-size:1rem; color:#334155;">
                                <i class="fa fa-gauge-high" style="color:#10B981; width:18px;"></i> Client Dashboard
                            </a>
                            <a href="@Url.Action("ChangePassword", "Account", new { area = "" })" style="padding:11px 20px; display:flex; align-items:center; gap:10px; font-size:1rem; color:#334155;">
                                <i class="fa fa-lock" style="color:#64748B; width:18px;"></i> Change Password
                            </a>
                            <!-- Mobile Theme Toggle -->
                            <a href="javascript:void(0)" id="xyzMobileThemeToggle" style="padding:11px 20px; display:flex; align-items:center; gap:10px; font-size:1rem; color:#334155;">
                                <i class="fa fa-moon" style="color:#64748B; width:18px;"></i> Toggle Theme
                            </a>
                        </li>
                        <li role="separator" class="divider" style="margin:4px 0;"></li>
                        <li style="padding:4px 0 10px;">
                            @using (Html.BeginForm("LogOff", "Account", new { area = "" }, FormMethod.Post, new { id = "adminLogoutForm" }))
                            {
                                @Html.AntiForgeryToken()
                                <a href="javascript:document.getElementById('adminLogoutForm').submit()" style="padding:11px 20px; color:#E50914; font-weight:800; display:flex; align-items:center; gap:10px; font-size:1rem;">
                                    <i class="fa fa-right-from-bracket"></i> Log Off
                                </a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Left Sidebar Navigation -->
        <aside class="main-sidebar">
            <section class="sidebar">
                <!-- User Profile Mini-Card -->
                <div class="sidebar-user-card">
                    <div class="sidebar-user-avatar">
                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <div style="overflow:hidden;">
                        <div class="sidebar-user-name">@User.Identity.Name</div>
                        <div class="sidebar-user-status">
                            <span style="width:9px; height:9px; background:#10B981; border-radius:50%; display:inline-block;"></span> Online
                        </div>
                    </div>
                </div>

                <!-- Navigation Menu -->
                <ul class="sidebar-menu">
                    <li class="header">MAIN NAVIGATION</li>
                    <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Main" ? "active" : "")">
                        <a href="@Url.Content("~/adminpanel/main")">
                            <i class="fa fa-gauge-high"></i> <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Content("~/clientpanel/dashboard")">
                            <i class="fa fa-desktop"></i> <span>Client's Dashboard</span>
                        </a>
                    </li>

                    <li class="header">USER MANAGEMENT</li>
                    <li>
                        <a href="@Url.Content("~/adminpanel/manageusers")">
                            <i class="fa fa-users"></i> <span>Manage Users</span>
                        </a>
                    </li>

                    <li class="header">BILLING &amp; FINANCE</li>
                    <li class="treeview">
                        <a href="#">
                            <i class="fa fa-receipt"></i> <span>Transactions</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            <li><a href="@Url.Content("~/adminpanel/transactions")"><i class="fa fa-circle" style="font-size:0.5rem;"></i> Transactions</a></li>
                            <li><a href="@Url.Content("~/adminpanel/transactions/ClientUnits")"><i class="fa fa-circle" style="font-size:0.5rem;"></i> Client Units</a></li>
                        </ul>
                    </li>
                    <li>
                        <a href="@Url.Content("~/adminpanel/transactions/paystackoutflow")">
                            <i class="fa fa-credit-card"></i> <span>Paystack Transactions</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Content("~/adminpanel/pricesettings")">
                            <i class="fa fa-tags"></i> <span>Price Settings</span>
                        </a>
                    </li>

                    <li class="header">PLATFORM CONFIG</li>
                    <li>
                        <a href="@Url.Content("~/adminpanel/apisettings")">
                            <i class="fa fa-key"></i> <span>API Settings</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Content("~/adminpanel/xyzsenderids/index")">
                            <i class="fa fa-tag"></i> <span>Sender IDs</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Content("~/adminpanel/main/messages")">
                            <i class="fa fa-clock-rotate-left"></i> <span>Message History</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Content("~/adminpanel/emaillogs")">
                            <i class="fa fa-envelope-open-text"></i> <span>Email Audit Logs</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Content("~/adminpanel/adminsettings/editsettings")">
                            <i class="fa fa-gears"></i> <span>Admin Settings</span>
                        </a>
                    </li>

                    <li class="header">CONTENT</li>
                    <li>
                        <a href="@Url.Content("~/adminpanel/modalinfoes")">
                            <i class="fa fa-window-restore"></i> <span>Modal Info</span>
                        </a>
                    </li>

                    <li class="header">RESOURCES</li>
                    <li>
                        <a href="@Url.Action("Developers", "Home", new { area = "" })" target="_blank">
                            <i class="fa fa-book-bookmark"></i> <span>Documentation</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Content("~/Home/")">
                            <i class="fa fa-globe"></i> <span>Home</span>
                        </a>
                    </li>
                </ul>
            </section>
        </aside>

        <!-- Main Content Body -->
        <div class="content-wrapper">
            @RenderBody()
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <div>
                &copy; @DateTime.UtcNow.Year <a href="https://exwhyzee.ng/" target="_blank" rel="noopener noreferrer" style="color:#6366F1; font-weight:800; text-decoration:none;">Exwhyzee Smart Solutions Limited</a>. All rights reserved.
            </div>
            <div class="hidden-xs" style="font-weight:700;">
                XYZSMS Admin Panel v3.5
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="/Content/Dashboard/plugins/jQuery/jquery-2.2.3.min.js"></script>
    <script src="/Content/Dashboard/plugins/jQuery/jquery-ui-1.12.0.min.js"></script>
    <script src="/Content/Dashboard/bootstrap/js/bootstrap.min.js"></script>
    <script src="/Content/Dashboard/plugins/datepicker/bootstrap-datepicker.js"></script>
    <script src="/Content/Dashboard/dist/js/app.min.js"></script>
    <script src="/Scripts/modern-app.js"></script>

    <!-- Theme & Fullscreen Scripts -->
    <script>
        (function () {
            // Dark / Light Mode Switcher
            function toggleTheme() {
                document.body.classList.toggle('xyz-dark-theme');
                var isDark = document.body.classList.contains('xyz-dark-theme');
                localStorage.setItem('xyz_theme', isDark ? 'dark' : 'light');
                var themeIcon = document.getElementById('xyzThemeIcon');
                if (themeIcon) {
                    themeIcon.className = isDark ? 'fa fa-sun' : 'fa fa-moon';
                }
                if (window.xyzToast) {
                    xyzToast.info(isDark ? 'Dark Mode Enabled' : 'Light Mode Enabled', 'Theme Updated');
                }
            }

            var themeBtn = document.getElementById('xyzThemeToggleBtn');
            var mobileThemeBtn = document.getElementById('xyzMobileThemeToggle');
            var themeIcon = document.getElementById('xyzThemeIcon');
            var savedTheme = localStorage.getItem('xyz_theme');

            if (savedTheme === 'dark') {
                document.body.classList.add('xyz-dark-theme');
                if (themeIcon) themeIcon.className = 'fa fa-sun';
            }

            if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
            if (mobileThemeBtn) mobileThemeBtn.addEventListener('click', toggleTheme);

            // Fullscreen Toggle
            var fsBtn = document.getElementById('xyzFullscreenToggleBtn');
            var fsIcon = document.getElementById('xyzFullscreenIcon');

            if (fsBtn) {
                fsBtn.addEventListener('click', function () {
                    if (!document.fullscreenElement) {
                        document.documentElement.requestFullscreen().catch(function(){});
                        if (fsIcon) fsIcon.className = 'fa fa-compress';
                    } else {
                        if (document.exitFullscreen) {
                            document.exitFullscreen().catch(function(){});
                        }
                        if (fsIcon) fsIcon.className = 'fa fa-expand';
                    }
                });
            }
        })();
    </script>

    <!-- Toast Alerts Listener for TempData -->
    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (window.xyzToast) {
                    window.xyzToast.success("@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["Success"].ToString()))", "Success");
                }
            });
        </script>
    }
    @if (TempData["Error"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (window.xyzToast) {
                    window.xyzToast.error("@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["Error"].ToString()))", "Error");
                }
            });
        </script>
    }
    @if (TempData["error"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (window.xyzToast) {
                    window.xyzToast.error("@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["error"].ToString()))", "Error");
                }
            });
        </script>
    }
    @if (TempData["Info"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (window.xyzToast) {
                    window.xyzToast.info("@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["Info"].ToString()))", "Information");
                }
            });
        </script>
    }

    @RenderSection("scripts", required: false)
</body>
</html>
