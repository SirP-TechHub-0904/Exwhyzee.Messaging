@model X.PagedList.IPagedList<Exwhyzee.Messaging.Core.Models.Transaction>
@using X.PagedList.Mvc.Core;
<link href="~/Content/PagedList.css" rel="stylesheet" />
@using Exwhyzee.Messaging.Core.Services

@{
    ViewBag.Title = "Platform Transactions Ledger";
}

<style>
    .xyz-id-chip {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 800;
        font-size: 0.8rem;
        background: #F1F5F9;
        color: #334155;
        padding: 2px 6px;
        border-radius: 4px;
        border: 1px solid #E2E8F0;
    }
    .xyz-badge {
        font-size: 0.72rem;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 6px;
        display: inline-block;
        text-transform: uppercase;
    }
    .xyz-badge-paystack { background: #E0F2FE; color: #0369A1; border: 1px solid #BAE6FD; }
    .xyz-badge-admin { background: #F3E8FF; color: #6B21A8; border: 1px solid #E9D5FF; }
    .xyz-badge-bank { background: #FEF3C7; color: #92400E; border: 1px solid #FDE68A; }
    .xyz-badge-voucher { background: #E0E7FF; color: #3730A3; border: 1px solid #C7D2FE; }
</style>

<div class="xyz-panel-card" style="margin-bottom: 24px; padding: 20px; background:#ffffff; border-radius:12px; border:1px solid #E2E8F0; box-shadow:0 4px 20px rgba(0,0,0,0.04);">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div>
            <h2 style="margin:0 0 4px; font-weight:800; font-size:1.35rem; color:#0F172A;">
                <i class="fa fa-receipt" style="color:#6366F1;"></i> All Platform Transactions
            </h2>
            <p style="margin:0; color:#64748B; font-size:0.88rem;">Audit ledger of all client wallet top-ups, admin credits, and online payments.</p>
        </div>
        <div style="display:flex; gap:10px;">
            <a href="@Url.Action("PaystackOutflow", "Transactions", new { area = "Adminpanel" })" class="btn btn-sm btn-primary" style="font-weight:800; border-radius:8px; background:#0284C7; border:none;">
                <i class="fa fa-credit-card"></i> Paystack Outflow Studio &rarr;
            </a>
            <a href="@Url.Action("Index", "Main", new { area = "Adminpanel" })" class="btn btn-sm btn-default" style="font-weight:800; border-radius:8px;">
                &larr; Back to Dashboard
            </a>
        </div>
    </div>
</div>

<div class="box" style="border-radius:12px; border:1px solid #E2E8F0; box-shadow:0 4px 20px rgba(0,0,0,0.04);">
    <div class="box-header" style="padding:16px 20px; border-bottom:1px solid #E2E8F0; background:#FAFAFA; border-top-left-radius:12px; border-top-right-radius:12px;">
        <h3 class="box-title" style="font-weight:800; font-size:1rem; color:#0F172A;">Transactions Ledger</h3>
    </div>
    <div class="box-body table-responsive" style="padding:20px;">
        @using (Html.BeginForm("Index", "Transactions", FormMethod.Get, new { @class = "form-inline", style = "margin-bottom:20px;" }))
        {
            <div class="form-group">
                <input type="text" name="SearchString" class="form-control" placeholder="Search by Username, Ref, Source..." value="@ViewContext.HttpContext.Request.Query["SearchString"]" style="width:300px; border-radius:8px;" />
                <button type="submit" class="btn btn-primary" style="font-weight:800; border-radius:8px; margin-left:6px;">
                    <i class="fa fa-search"></i> Search
                </button>
            </div>
        }

        <table class="table table-hover" style="vertical-align:middle; font-size:0.88rem;">
            <thead style="background:#F8FAFC; font-weight:800; font-size:0.75rem; color:#475569; text-transform:uppercase;">
                <tr>
                    <th style="padding:10px 14px;">Trans ID</th>
                    <th>Client</th>
                    <th>Source &amp; Type</th>
                    <th>Amount Paid</th>
                    <th>Units</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th style="text-align:right; padding:10px 14px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="padding:10px 14px;">
                            <span class="xyz-id-chip">#@item.TransactionId</span>
                        </td>
                        <td>
                            <strong style="color:#1E293B;">@GeneralServices.ClientName(item.ClientId)</strong>
                            <small style="color:#64748B; display:block;">By: @GeneralServices.UserName(item.UserId)</small>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.PaymentSource) && item.PaymentSource.Equals("Paystack", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="xyz-badge xyz-badge-paystack">
                                    <i class="fa fa-credit-card"></i> Paystack
                                </span>
                            }
                            else if (item.TransactionType == Exwhyzee.Messaging.Core.Models.TransactionType.BankDeposit)
                            {
                                <span class="xyz-badge xyz-badge-bank">
                                    <i class="fa fa-building-columns"></i> Bank Deposit
                                </span>
                            }
                            else if (item.TransactionType == Exwhyzee.Messaging.Core.Models.TransactionType.ByVoucher)
                            {
                                <span class="xyz-badge xyz-badge-voucher">
                                    <i class="fa fa-ticket"></i> Voucher
                                </span>
                            }
                            else
                            {
                                <span class="xyz-badge xyz-badge-admin">
                                    <i class="fa fa-user-gear"></i> Admin Top-Up
                                </span>
                            }
                        </td>
                        <td>
                            <strong style="color:#10B981; font-family:'JetBrains Mono', monospace;">
                                &#x20A6;@((item.AmountPaid.HasValue && item.AmountPaid > 0 ? item.AmountPaid.Value : item.Amount).ToString("N2"))
                            </strong>
                        </td>
                        <td>
                            <span class="xyz-id-chip">+@item.Units.ToString("N0") Units</span>
                        </td>
                        <td>
                            <small style="color:#64748B;">@(item.DateApproved != null ? item.DateApproved.Value.ToString("yyyy-MM-dd HH:mm") : item.DateCreated.ToString("yyyy-MM-dd"))</small>
                        </td>
                        <td>
                            @if (item.Status == Exwhyzee.Messaging.Core.Models.TransactionStatus.Approved || item.DateApproved != null)
                            {
                                <span class="xyz-badge" style="background:#DCFCE7; color:#166534; border:1px solid #BBF7D0;">Approved</span>
                            }
                            else if (item.Status == Exwhyzee.Messaging.Core.Models.TransactionStatus.Pending)
                            {
                                <span class="xyz-badge" style="background:#FEF3C7; color:#92400E; border:1px solid #FDE68A;">Pending</span>
                            }
                            else
                            {
                                <span class="xyz-badge" style="background:#FEE2E2; color:#991B1B; border:1px solid #FECACA;">@item.Status</span>
                            }
                        </td>
                        <td style="text-align:right; padding:10px 14px;">
                            @Html.ActionLink("Details", "Details", new { id = item.TransactionId }, new { @class = "btn btn-primary btn-xs", style = "font-weight:700; border-radius:6px;" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="container text-center page" style="margin-top:20px;">
            <p>Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</p>
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
        </div>
    </div>
</div>
