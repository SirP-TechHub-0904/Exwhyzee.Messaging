                    <h4 class="modal-title" style="font-weight:800; font-size:1.15rem; margin:0; color:#FFFFFF;">
                        <i class="fa fa-receipt" style="color:#38BDF8; margin-right:6px;"></i> Paystack Outflow Transfer
                    </h4>
                    <span id="tdTransferCode" style="font-family:'JetBrains Mono', monospace; font-weight:800; font-size:0.9rem; background:#1E293B; color:#38BDF8; padding:3px 10px; border-radius:6px; border:1px solid #334155;"></span>
                    <span id="tdStatusBadge"></span>
