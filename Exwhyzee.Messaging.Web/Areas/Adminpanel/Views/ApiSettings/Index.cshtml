@model IEnumerable<Exwhyzee.Messaging.Core.Models.ApiSetting>

@{
    ViewBag.Title = "SMS Gateway API Configurations";
}

<style>
    .xyz-api-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #E2E8F0;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        padding: 24px;
        margin-bottom: 24px;
    }

    .xyz-gateway-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #E2E8F0;
        box-shadow: 0 4px 18px rgba(0,0,0,0.03);
        margin-bottom: 24px;
        overflow: hidden;
        transition: all 0.2s ease;
    }
    .xyz-gateway-card:hover {
        box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        border-color: #CBD5E1;
    }

    .xyz-gateway-header {
        padding: 18px 24px;
        background: #F8FAFC;
        border-bottom: 1px solid #E2E8F0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .xyz-gateway-body {
        padding: 24px;
    }

    .xyz-url-block {
        background: #F1F5F9;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 14px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.84rem;
        color: #334155;
        word-break: break-all;
    }

    .xyz-url-label {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-weight: 800;
        font-size: 0.72rem;
        color: #64748B;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: block;
        margin-bottom: 6px;
    }

    .xyz-badge-default {
        background: #DCFCE7;
        color: #166534;
        border: 1px solid #BBF7D0;
        font-weight: 800;
        font-size: 0.78rem;
        padding: 5px 12px;
        border-radius: 9999px;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .xyz-badge-secondary {
        background: #F1F5F9;
        color: #64748B;
        border: 1px solid #E2E8F0;
        font-weight: 700;
        font-size: 0.78rem;
        padding: 5px 12px;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
    }
</style>

@Html.Partial("_ResponseMessagePartial")

<!-- Hero Header Card -->
<div class="xyz-api-card">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div>
            <h2 style="margin:0 0 4px; font-weight:800; font-size:1.4rem; color:#0F172A;">
                <i class="fa fa-plug" style="color:#0284C7;"></i> SMS Gateway API Configurations
            </h2>
            <p style="margin:0; color:#64748B; font-size:0.9rem;">Manage telecom API keys, gateway endpoints, and default broadcast dispatch routing.</p>
        </div>
        <div>
            <a href="@Url.Action("Create", "ApiSettings", new { area = "Adminpanel" })" class="btn btn-primary" style="background:#0284C7; border:none; font-weight:800; font-size:0.95rem; padding:10px 22px; border-radius:10px; box-shadow:0 4px 14px rgba(2,132,199,0.3);">
                <i class="fa fa-plus"></i> Add New API Setting
            </a>
        </div>
    </div>
</div>

<!-- Gateway Cards Grid -->
@if (Model == null || !Model.Any())
{
    <div class="xyz-api-card" style="text-align:center; padding:60px 24px; color:#94A3B8;">
        <i class="fa fa-plug" style="font-size:3rem; display:block; margin-bottom:16px; color:#CBD5E1;"></i>
        <h4 style="font-weight:800; color:#475569; margin:0 0 8px;">No API Settings Configured</h4>
        <p style="margin:0 0 20px;">Click the button above to add your first SMS Gateway provider endpoint.</p>
        <a href="@Url.Action("Create", "ApiSettings", new { area = "Adminpanel" })" class="btn btn-primary" style="background:#0284C7; border:none; font-weight:800; border-radius:8px; padding:10px 20px;">
            <i class="fa fa-plus"></i> Add API Setting
        </a>
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-sm-12">
                <div class="xyz-gateway-card">
                    <!-- Gateway Card Header -->
                    <div class="xyz-gateway-header">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <h3 style="margin:0; font-weight:800; font-size:1.15rem; color:#0F172A;">
                                <i class="fa fa-server" style="color:#0284C7; margin-right:6px;"></i> @item.Name
                            </h3>
                            @if (item.IsDefault)
                            {
                                <span class="xyz-badge-default"><i class="fa fa-star" style="font-size:0.65rem;"></i> Primary Default</span>
                            }
                            else
                            {
                                <span class="xyz-badge-secondary">Secondary</span>
                            }
                        </div>
                        <div style="display:flex; gap:6px;">
                            <a href="@Url.Action("Edit", "ApiSettings", new { area = "Adminpanel", id = item.ApiSettingId })" class="btn btn-xs btn-default" style="font-weight:700; border-radius:6px; padding:5px 12px;" title="Edit Gateway">
                                <i class="fa fa-pen-to-square"></i> Edit
                            </a>
                            <a href="@Url.Action("Details", "ApiSettings", new { area = "Adminpanel", id = item.ApiSettingId })" class="btn btn-xs btn-info" style="font-weight:700; border-radius:6px; background:#0284C7; border:none; padding:5px 12px;" title="View Details">
                                <i class="fa fa-eye"></i> Details
                            </a>
                            <a href="@Url.Action("Delete", "ApiSettings", new { area = "Adminpanel", id = item.ApiSettingId })" class="btn btn-xs btn-default" style="color:#EF4444; font-weight:700; border-radius:6px; padding:5px 10px;" title="Delete Gateway">
                                <i class="fa fa-trash"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Gateway Card Body -->
                    <div class="xyz-gateway-body">
                        <!-- Secret Token -->
                        <div style="margin-bottom:16px;">
                            <span class="xyz-url-label"><i class="fa fa-key" style="color:#E50914;"></i> API Secret Token</span>
                            <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:8px; padding:10px 14px; font-family:'JetBrains Mono', monospace; font-size:0.85rem; font-weight:700; color:#0284C7; word-break:break-all;">
                                @(string.IsNullOrEmpty(item.Token) ? "No token configured" : item.Token)
                            </div>
                        </div>

                        <!-- Sending Endpoint -->
                        <div class="xyz-url-block">
                            <span class="xyz-url-label"><i class="fa fa-paper-plane" style="color:#0284C7;"></i> Sending Broadcast Endpoint URL</span>
                            @(string.IsNullOrEmpty(item.Sending) ? "Not set" : item.Sending)
                        </div>

                        <!-- Balance Check Endpoint -->
                        <div class="xyz-url-block" style="margin-bottom:0;">
                            <span class="xyz-url-label"><i class="fa fa-wallet" style="color:#10B981;"></i> Balance Check Endpoint URL</span>
                            @(string.IsNullOrEmpty(item.CheckBalance) ? "Not set" : item.CheckBalance)
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
