@model Exwhyzee.Messaging.Core.Models.ApiSetting

@{
    ViewBag.Title = "Delete API Setting";
}

<style>
    .xyz-danger-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #FCA5A5;
        box-shadow: 0 4px 20px rgba(229,9,20,0.06);
        padding: 28px;
        max-width: 600px;
        margin: 0 auto 30px;
    }
</style>

@Html.Partial("_ResponseMessagePartial")

<div class="xyz-danger-card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; border-bottom:1px solid #FEE2E2; padding-bottom:14px;">
        <h3 style="margin:0; font-weight:800; font-size:1.25rem; color:#991B1B;">
            <i class="fa fa-triangle-exclamation" style="color:#DC2626;"></i> Confirm Gateway Deletion
        </h3>
        <a href="@Url.Action("Index", "ApiSettings", new { area = "Adminpanel" })" class="btn btn-sm btn-default" style="font-weight:700; border-radius:8px;">
            &larr; Cancel
        </a>
    </div>

    <div style="background:#FEF2F2; border:1px solid #FCA5A5; border-radius:10px; padding:16px; margin-bottom:20px; color:#991B1B; font-weight:700; font-size:0.92rem;">
        Are you sure you want to permanently remove this API gateway setting?
    </div>

    <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:10px; padding:18px; margin-bottom:20px;">
        <div style="margin-bottom:10px;">
            <small style="color:#64748B; font-weight:700; text-transform:uppercase; font-size:0.75rem; display:block;">Gateway Name</small>
            <strong style="font-size:1.05rem; color:#0F172A;">@Model.Name</strong>
        </div>
        <div style="margin-bottom:10px;">
            <small style="color:#64748B; font-weight:700; text-transform:uppercase; font-size:0.75rem; display:block;">Dispatch Endpoint</small>
            <code style="font-family:'JetBrains Mono', monospace; font-size:0.85rem; color:#334155;">@Model.Sending</code>
        </div>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger btn-block" style="background:#DC2626; border:none; font-weight:800; font-size:1rem; padding:12px; border-radius:10px; box-shadow:0 4px 14px rgba(220,38,38,0.3);" onclick="return confirm('Permanently delete this API setting?');">
            <i class="fa fa-trash"></i> Delete API Setting
        </button>
    }
</div>
