@model Exwhyzee.Messaging.Core.Models.ApiSetting

@{
    ViewBag.Title = "Edit API Setting";
}

<style>
    .xyz-form-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #E2E8F0;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        padding: 28px;
        max-width: 680px;
        margin: 0 auto 30px;
    }
</style>

@Html.Partial("_ResponseMessagePartial")

<div class="xyz-form-card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; border-bottom:1px solid #E2E8F0; padding-bottom:16px;">
        <h3 style="margin:0; font-weight:800; font-size:1.3rem; color:#0F172A;">
            <i class="fa fa-pen-to-square" style="color:#0284C7;"></i> Edit API Setting #@Model.ApiSettingId
        </h3>
        <a href="@Url.Action("Index", "ApiSettings", new { area = "Adminpanel" })" class="btn btn-sm btn-default" style="font-weight:700; border-radius:8px;">
            &larr; Back to List
        </a>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger", style = "margin-bottom:16px;" })
        @Html.HiddenFor(model => model.ApiSettingId)

        <div class="form-group" style="margin-bottom:16px;">
            <label style="font-weight:700; font-size:0.85rem; color:#334155;">Gateway Display Name <span style="color:#E50914;">*</span></label>
            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", style = "border-radius:8px; height:42px; font-weight:600;", required = "required" } })
            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom:16px;">
            <label style="font-weight:700; font-size:0.85rem; color:#334155;">API Secret Token / Key <span style="color:#E50914;">*</span></label>
            @Html.EditorFor(model => model.Token, new { htmlAttributes = new { @class = "form-control", style = "border-radius:8px; height:42px; font-family:'JetBrains Mono', monospace; font-weight:600;", required = "required" } })
            @Html.ValidationMessageFor(model => model.Token, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom:16px;">
            <label style="font-weight:700; font-size:0.85rem; color:#334155;">SMS Broadcast Dispatch Endpoint URL <span style="color:#E50914;">*</span></label>
            @Html.EditorFor(model => model.Sending, new { htmlAttributes = new { @class = "form-control", style = "border-radius:8px; height:42px; font-weight:600;", required = "required" } })
            @Html.ValidationMessageFor(model => model.Sending, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom:16px;">
            <label style="font-weight:700; font-size:0.85rem; color:#334155;">Check Gateway Balance Endpoint URL</label>
            @Html.EditorFor(model => model.CheckBalance, new { htmlAttributes = new { @class = "form-control", style = "border-radius:8px; height:42px; font-weight:600;" } })
            @Html.ValidationMessageFor(model => model.CheckBalance, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom:20px; background:#F8FAFC; border:1px solid #E2E8F0; padding:12px 16px; border-radius:10px;">
            <label style="font-weight:800; font-size:0.95rem; color:#0F172A; margin:0; display:flex; align-items:center; gap:8px;">
                @Html.CheckBoxFor(model => model.IsDefault) Set as Primary Default Gateway for SMS Dispatch
            </label>
            <small style="color:#64748B; font-size:0.82rem; margin-top:4px; display:block;">
                When checked, all outbound broadcasts will route through this gateway token by default.
            </small>
        </div>

        <button type="submit" class="btn btn-success btn-block" style="background:#059669; border:none; font-weight:800; font-size:1rem; padding:12px; border-radius:10px; box-shadow:0 4px 14px rgba(5,150,105,0.3);">
            <i class="fa fa-save"></i> Update API Configuration
        </button>
    }
</div>
