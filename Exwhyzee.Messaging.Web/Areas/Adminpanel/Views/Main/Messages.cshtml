@model X.PagedList.IPagedList<Exwhyzee.Messaging.Core.Models.Message>
@using X.PagedList.Mvc.Core;
<link href="~/Content/PagedList.css" rel="stylesheet" />
@using Exwhyzee.Messaging.Core.Services

@{
    ViewBag.Title = "Platform Message History";
    string currentFilter = ViewBag.CurrentFilter as string;
}

<style>
    .xyz-sender-tag {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 800;
        background: #EEF2FF;
        color: #4F46E5;
        border: 1px solid #C7D2FE;
        padding: 3px 10px;
        border-radius: 6px;
        font-size: 0.82rem;
        display: inline-block;
    }
    .xyz-badge-status {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
    }
    .xyz-status-sent, .xyz-status-delivered, .xyz-status-approved { background: #DCFCE7; color: #166534; border: 1px solid #BBF7D0; }
    .xyz-status-pending, .xyz-status-queued { background: #FEF3C7; color: #92400E; border: 1px solid #FDE68A; }
    .xyz-status-failed, .xyz-status-rejected { background: #FEE2E2; color: #991B1B; border: 1px solid #FCA5A5; }
    .xyz-status-draft { background: #F1F5F9; color: #475569; border: 1px solid #E2E8F0; }
</style>

@Html.Partial("_ResponseMessagePartial")

<div class="xyz-panel-card" style="margin-bottom: 24px; padding: 24px; background:#ffffff; border-radius:12px; border:1px solid #E2E8F0; box-shadow:0 4px 20px rgba(0,0,0,0.04);">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div>
            <h2 style="margin:0 0 4px; font-weight:800; font-size:1.4rem; color:#0F172A;">
                <i class="fa fa-comments" style="color:#0284C7;"></i> Platform Message Broadcast History
            </h2>
            <p style="margin:0; color:#64748B; font-size:0.9rem;">Audit, inspect, and monitor all outbound SMS broadcast dispatches across platform clients.</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Main", new { area = "Adminpanel" })" class="btn btn-sm btn-default" style="font-weight:800; border-radius:8px;">
                &larr; Back to Dashboard
            </a>
        </div>
    </div>
</div>

<div class="box" style="border-radius:12px; border:1px solid #E2E8F0; box-shadow:0 4px 20px rgba(0,0,0,0.04); background:#ffffff;">
    <div class="box-header" style="padding:16px 20px; border-bottom:1px solid #E2E8F0; background:#FAFAFA; border-top-left-radius:12px; border-top-right-radius:12px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <h3 class="box-title" style="font-weight:800; font-size:1.1rem; color:#0F172A; margin:0;">
            <i class="fa fa-list" style="color:#10B981;"></i> Outbound Broadcast Ledger
        </h3>

        @using (Html.BeginForm("Messages", "Main", new { area = "Adminpanel" }, FormMethod.Get, null, new { @class = "form-inline", style = "margin:0;" }))
        {
            <div class="input-group" style="display:flex; width:300px;">
                <input type="text" name="searchString" value="@currentFilter" placeholder="Search content, sender ID, recipient..." class="form-control" style="border-top-left-radius:8px; border-bottom-left-radius:8px; border-top-right-radius:0; border-bottom-right-radius:0; height:38px; font-size:0.85rem;" />
                <span class="input-group-btn">
                    <button type="submit" class="btn btn-primary" style="border-top-right-radius:8px; border-bottom-right-radius:8px; border-top-left-radius:0; border-bottom-left-radius:0; height:38px; font-weight:800; background:#0284C7; border:none;">
                        <i class="fa fa-search"></i> Search
                    </button>
                </span>
            </div>
        }
    </div>

    <div class="box-body table-responsive" style="padding:20px;">
        <table class="table table-hover" style="vertical-align:middle; font-size:0.88rem;">
            <thead style="background:#F8FAFC; font-weight:800; font-size:0.75rem; color:#475569; text-transform:uppercase;">
                <tr>
                    <th style="padding:12px 16px;">Msg ID</th>
                    <th>Sender ID</th>
                    <th>Submitted By</th>
                    <th>Content Snippet</th>
                    <th>Units Used</th>
                    <th>Delivered Date</th>
                    <th>Status</th>
                    <th style="text-align:right; padding-right:16px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" style="text-align:center; padding:40px; color:#94A3B8;">
                            <i class="fa fa-comment-slash" style="font-size:2.5rem; display:block; margin-bottom:10px; color:#CBD5E1;"></i>
                            No broadcast messages found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        string statusStr = item.Status.ToString().ToLower();
                        string badgeClass = "xyz-status-sent";
                        if (statusStr.Contains("fail") || statusStr.Contains("rej")) { badgeClass = "xyz-status-failed"; }
                        else if (statusStr.Contains("pend") || statusStr.Contains("queue")) { badgeClass = "xyz-status-pending"; }
                        else if (statusStr.Contains("draft")) { badgeClass = "xyz-status-draft"; }

                        string contentSnippet = (item.MessageContent ?? "");
                        if (contentSnippet.Length > 55) { contentSnippet = contentSnippet.Substring(0, 55) + "..."; }

                        string userName = item.User?.UserName ?? GeneralServices.UserName(item.UserId);

                        <tr>
                            <td style="padding:14px 16px;">
                                <span style="font-family:'JetBrains Mono', monospace; font-weight:800; font-size:0.8rem; background:#F1F5F9; color:#334155; padding:2px 6px; border-radius:4px; border:1px solid #E2E8F0;">#@item.MessageId</span>
                            </td>
                            <td>
                                <div class="xyz-sender-tag">
                                    <i class="fa fa-tag"></i> @(item.SenderId ?? "SYSTEM")
                                </div>
                            </td>
                            <td>
                                <strong style="color:#0F172A;">@userName</strong>
                            </td>
                            <td style="color:#475569; max-width:280px;" title="@item.MessageContent">
                                @contentSnippet
                            </td>
                            <td>
                                <span style="font-weight:700; color:#334155;">@item.UnitsUsed.ToString("N0") Units</span>
                            </td>
                            <td>
                                <small style="color:#64748B;">@(item.DeliveredDate.HasValue ? item.DeliveredDate.Value.ToString("yyyy-MM-dd HH:mm") : (item.Scheduleddate.HasValue ? item.Scheduleddate.Value.ToString("yyyy-MM-dd HH:mm") : "N/A"))</small>
                            </td>
                            <td>
                                <span class="xyz-badge-status @badgeClass">
                                    <i class="fa fa-circle" style="font-size:0.55rem; margin-right:4px;"></i> @item.Status
                                </span>
                            </td>
                            <td style="text-align:right; padding-right:16px;">
                                @Html.ActionLink("Details", "MessageDetails", new { id = item.MessageId }, new { @class = "btn btn-xs btn-primary", style = "font-weight:800; border-radius:6px; background:#0284C7; border:none;" })
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="container text-center page" style="margin-top:20px;">
            <p>Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</p>
            @Html.PagedListPager(Model, page => Url.Action("Messages", new { page, currentFilter }))
        </div>
    </div>
</div>
