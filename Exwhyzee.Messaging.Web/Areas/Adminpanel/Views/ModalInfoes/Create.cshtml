@model Exwhyzee.Messaging.Core.Models.ModalInfo

@{
    ViewBag.Title = "Create Dashboard Announcement Modal";
}

<!-- Summernote WYSIWYG Editor Styles -->
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs4.min.css" rel="stylesheet">

<style>
    .xyz-form-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #E2E8F0;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        padding: 28px;
        width: 100%;
        margin: 0 0 30px;
    }
    .note-editor.note-frame {
        border-radius: 10px !important;
        border-color: #CBD5E1 !important;
        overflow: hidden;
    }
    .note-toolbar {
        background: #F8FAFC !important;
        border-bottom: 1px solid #E2E8F0 !important;
    }
</style>

@Html.Partial("_ResponseMessagePartial")

<div class="xyz-form-card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; border-bottom:1px solid #E2E8F0; padding-bottom:16px;">
        <h3 style="margin:0; font-weight:800; font-size:1.3rem; color:#0F172A;">
            <i class="fa fa-plus-circle" style="color:#0284C7;"></i> Create Dashboard Announcement Modal
        </h3>
        <a href="@Url.Action("Index", "ModalInfoes", new { area = "Adminpanel" })" class="btn btn-sm btn-default" style="font-weight:700; border-radius:8px;">
            &larr; Back to List
        </a>
    </div>

    @using (Html.BeginForm("Create", "ModalInfoes", new { area = "Adminpanel" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger", style = "margin-bottom:16px;" })

        <div class="form-group" style="margin-bottom:16px;">
            <label style="font-weight:700; font-size:0.85rem; color:#334155;">Announcement Title</label>
            @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g. 📢 Important Platform Upgrade Notice", style = "border-radius:8px; height:42px; font-weight:700;" } })
            @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom:16px;">
            <label style="font-weight:700; font-size:0.85rem; color:#334155;">Upload Banner Image (Optional)</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" style="border-radius:8px; height:44px; padding:8px 12px;" />
            <small style="color:#64748B; font-size:0.8rem; margin-top:4px; display:block;">Supported formats: PNG, JPG, WEBP.</small>
        </div>

        <div class="form-group" style="margin-bottom:20px;">
            <label style="font-weight:700; font-size:0.85rem; color:#334155;">Announcement Write-Up Message (Summernote Rich Text)</label>
            @Html.TextAreaFor(model => model.ContentHtml, new { id = "summernoteEditor", @class = "form-control", rows = 8 })
            @Html.ValidationMessageFor(model => model.ContentHtml, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom:20px; background:#F8FAFC; border:1px solid #E2E8F0; padding:14px 18px; border-radius:10px;">
            <label style="font-weight:800; font-size:0.95rem; color:#0F172A; margin-bottom:10px; display:block;">
                <i class="fa fa-sliders" style="color:#0284C7;"></i> Modal Display Elements (Choose at least one):
            </label>
            <div style="display:flex; gap:24px; flex-wrap:wrap;">
                <label style="font-weight:700; font-size:0.9rem; color:#334155; cursor:pointer; margin:0;">
                    @Html.CheckBoxFor(model => model.UseImage, new { style = "width:18px; height:18px; vertical-align:middle; margin-right:6px;" }) Display Image Banner
                </label>
                <label style="font-weight:700; font-size:0.9rem; color:#334155; cursor:pointer; margin:0;">
                    @Html.CheckBoxFor(model => model.UseText, new { style = "width:18px; height:18px; vertical-align:middle; margin-right:6px;" }) Display Write-Up / Text
                </label>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 form-group" style="margin-bottom:16px;">
                <label style="font-weight:700; font-size:0.85rem; color:#334155;">Repeat Display Frequency (Days) <span style="color:#E50914;">*</span></label>
                @Html.EditorFor(model => model.ShowFrequencyDays, new { htmlAttributes = new { @class = "form-control", style = "border-radius:8px; height:42px; font-weight:700;", required = "required" } })
                <small style="color:#64748B; font-size:0.8rem; margin-top:4px; display:block;">Show once every <strong>X</strong> days to returning users (e.g. 7 days).</small>
                @Html.ValidationMessageFor(model => model.ShowFrequencyDays, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6 form-group" style="margin-bottom:16px; margin-top:24px;">
                <label style="font-weight:800; font-size:0.95rem; color:#0F172A; cursor:pointer;">
                    @Html.CheckBoxFor(model => model.IsActive, new { style = "width:20px; height:20px; vertical-align:middle;" }) Set as Active Announcement
                </label>
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block" style="background:#0284C7; border:none; font-weight:800; font-size:1rem; padding:12px; border-radius:10px; box-shadow:0 4px 14px rgba(2,132,199,0.3);">
            <i class="fa fa-save"></i> Save Announcement Modal
        </button>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs4.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#summernoteEditor').summernote({
                placeholder: 'Type formatted announcement message...',
                tabsize: 2,
                height: 240,
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'italic', 'underline', 'clear']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture']],
                    ['view', ['fullscreen', 'codeview']]
                ]
            });
        });
    </script>
}
