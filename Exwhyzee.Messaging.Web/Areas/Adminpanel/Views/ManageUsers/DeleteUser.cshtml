@model Exwhyzee.Messaging.Core.Models.ApplicationUser
@{
    ViewBag.Title = "Delete User Account";
    string username = Model?.UserName ?? "User";
    string email = Model?.Email ?? "";
    string phone = Model?.PhoneNumber ?? "";
}

<style>
    .xyz-delete-card {
        background: #FFFFFF;
        border: 1px solid #FCA5A5;
        border-radius: 14px;
        box-shadow: 0 4px 16px rgba(220, 38, 38, 0.08);
        padding: 28px;
        margin-bottom: 24px;
    }

    .xyz-delete-header {
        background: linear-gradient(135deg, #7F1D1D 0%, #B91C1C 100%);
        color: #FFFFFF;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 4px 16px rgba(185, 28, 28, 0.2);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .xyz-audit-item {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
</style>

<div class="container-fluid" style="padding-top: 10px;">
    @Html.Partial("_ResponseMessagePartial")

    <!-- HEADER WARNING BANNER -->
    <div class="xyz-delete-header">
        <div>
            <h2 style="font-weight: 800; margin: 0 0 4px 0; font-size: 1.5rem;">
                <i class="fa fa-user-slash" style="color: #FCA5A5; margin-right: 8px;"></i> Soft-Delete &amp; Anonymize Account
            </h2>
            <p style="color: #FEE2E2; margin: 0; font-size: 0.9rem;">
                Account Profile: <strong style="color: #FFF;">@@@username</strong> &bull; Email: <strong style="color: #FFF;">@email</strong>
            </p>
        </div>
        <div>
            <a href="@Url.Action("Index", "ManageUsers", new { area = "Adminpanel" })" class="btn btn-default" style="font-weight: 800; border-radius: 8px; padding: 10px 16px; background: #FFF; color: #7F1D1D; border: none;">
                <i class="fa fa-arrow-left"></i> Cancel &amp; Return
            </a>
        </div>
    </div>

    <!-- MAIN CONFIRMATION CARD -->
    <div class="row">
        <div class="col-md-8 col-md-offset-2">
            <div class="xyz-delete-card">
                <div style="text-align: center; margin-bottom: 24px;">
                    <div style="width: 64px; height: 64px; background: #FEE2E2; color: #DC2626; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 12px;">
                        <i class="fa fa-user-slash"></i>
                    </div>
                    <h3 style="font-weight: 800; color: #991B1B; margin: 0 0 6px 0;">Are you sure you want to soft-delete this user?</h3>
                    <p style="color: #64748B; max-width: 540px; margin: 0 auto; font-size: 0.9rem;">
                        This action will scrub personal identifying information (PII), revoke all API keys, clear credentials, and permanently lock the account while preserving transaction ledgers for accounting compliance.
                    </p>
                </div>

                <!-- AUDIT PRESERVATION BREAKDOWN -->
                <div style="margin-bottom: 24px;">
                    <h4 style="font-weight: 800; color: #0F172A; font-size: 0.95rem; margin-bottom: 12px;">
                        <i class="fa fa-list-check" style="color: #4F46E5;"></i> Automated Deletion Operations
                    </h4>

                    <div class="xyz-audit-item">
                        <div>
                            <strong style="color: #0F172A; display: block;">Personal Credentials (PII) Scrubbed</strong>
                            <small style="color: #64748B;">Username, Email, Phone Number anonymized; Password hash cleared.</small>
                        </div>
                        <span class="badge" style="background: #EF4444;">Anonymized</span>
                    </div>

                    <div class="xyz-audit-item">
                        <div>
                            <strong style="color: #0F172A; display: block;">API Keys &amp; Access Revoked</strong>
                            <small style="color: #64748B;">API keys cleared; 100-year permanent security lockout applied.</small>
                        </div>
                        <span class="badge" style="background: #F59E0B;">Revoked</span>
                    </div>

                    <div class="xyz-audit-item">
                        <div>
                            <strong style="color: #0F172A; display: block;">Financial Ledgers &amp; SMS History Preserved</strong>
                            <small style="color: #64748B;">All past Paystack recharges and message logs kept for accounting audits.</small>
                        </div>
                        <span class="badge" style="background: #10B981;">Preserved</span>
                    </div>

                    <div class="xyz-audit-item">
                        <div>
                            <strong style="color: #0F172A; display: block;">Active User Directory Visibility</strong>
                            <small style="color: #64748B;">Account will be permanently hidden from User Management lists.</small>
                        </div>
                        <span class="badge" style="background: #64748B;">Hidden</span>
                    </div>
                </div>

                <!-- CONFIRMATION FORM -->
                @using (Html.BeginForm("DeleteUser", "ManageUsers", new { area = "Adminpanel", id = Model.Id }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #E2E8F0; padding-top: 20px;">
                        <a href="@Url.Action("Index", "ManageUsers", new { area = "Adminpanel" })" class="btn btn-default" style="font-weight: 700; border-radius: 8px; padding: 10px 20px; border-color: #CBD5E1;">
                            Cancel &amp; Go Back
                        </a>
                        <button type="submit" class="btn btn-danger" style="font-weight: 800; border-radius: 8px; padding: 12px 28px; background: #DC2626; box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);">
                            <i class="fa fa-trash"></i> Confirm Soft-Delete &amp; Anonymize
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
