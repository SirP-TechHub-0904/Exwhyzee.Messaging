@model IEnumerable<Exwhyzee.Messaging.Core.Models.Transaction>
@using Exwhyzee.Messaging.Core.Models
@using Exwhyzee.Messaging.Core.Dtos

@{
    ViewBag.Title = "Client Transactions Studio";
    var client = ViewBag.Client as Client;
    var stats = ViewBag.Stats as TransactionLedgerStatsDto ?? new TransactionLedgerStatsDto();
    int clientId = client?.ClientId ?? 0;
    string clientName = client != null ? $"{client.FirstName} {client.Surname} {client.OtherNames}".Trim() : "Client Profile";
    if (string.IsNullOrWhiteSpace(clientName)) { clientName = client?.User?.UserName ?? "Client"; }

    string search = ViewBag.Search as string ?? "";
    string statusFilter = ViewBag.StatusFilter as string ?? "all";
    string sourceFilter = ViewBag.SourceFilter as string ?? "all";
    string cardFilter = ViewBag.CardFilter as string ?? "all";
    string dateFrom = ViewBag.DateFrom as string ?? "";
    string dateTo = ViewBag.DateTo as string ?? "";
    string sortOrder = ViewBag.SortOrder as string ?? "date_desc";
    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 20;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    int totalCount = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : 0;

    int startItem = totalCount == 0 ? 0 : (pageSize <= 0 ? 1 : ((currentPage - 1) * pageSize) + 1);
    int endItem = totalCount == 0 ? 0 : (pageSize <= 0 ? totalCount : Math.Min(currentPage * pageSize, totalCount));
    int sn = startItem > 0 ? startItem : 1;

    string CardUrl(string cf) => Url.Action("UserTransactions", "ManageUsers", new
    {
        area = "Adminpanel",
        id = clientId,
        search,
        statusFilter,
        sourceFilter,
        cardFilter = cf,
        dateFrom,
        dateTo,
        sortOrder,
        page = 1,
        pageSize
    });

    string PageUrl(int p) => Url.Action("UserTransactions", "ManageUsers", new
    {
        area = "Adminpanel",
        id = clientId,
        search,
        statusFilter,
        sourceFilter,
        cardFilter,
        dateFrom,
        dateTo,
        sortOrder,
        page = p,
        pageSize
    });

    string ExportUrl(string fmt) => Url.Action("ExportUserTransactions", "ManageUsers", new
    {
        area = "Adminpanel",
        id = clientId,
        format = fmt,
        search,
        statusFilter,
        sourceFilter,
        cardFilter,
        dateFrom,
        dateTo,
        sortOrder
    });
}

<style>
    .ut-wrap { font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif; color: #1e293b; }
    .ut-hero {
        background: linear-gradient(135deg, #0b0f19 0%, #1e293b 100%);
        color: #fff;
        border-radius: 14px;
        padding: 20px 24px;
        margin-bottom: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.14);
    }
    .ut-hero h2 { margin: 0; font-size: 20px; font-weight: 800; color: #fff; }
    .ut-hero p { margin: 4px 0 0; font-size: 13px; color: #cbd5e1; }

    /* 8 Clickable Reactive Mini-Dashboard Cards */
    .ut-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 18px; }
    @@media (max-width: 1100px) { .ut-kpi-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 600px) { .ut-kpi-grid { grid-template-columns: 1fr; } }

    .ut-kpi { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 16px; text-decoration: none !important; color: inherit !important; display: flex; align-items: center; gap: 12px; transition: all .18s ease; box-shadow: 0 1px 4px rgba(15,23,42,0.02); }
    .ut-kpi:hover { transform: translateY(-2px); border-color: #94a3b8; box-shadow: 0 6px 14px rgba(15,23,42,0.06); }
    .ut-kpi.active { border: 2px solid #0284c7; background: #f0f9ff; }
    .ut-kpi-icon { width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 17px; flex-shrink: 0; }
    .ut-kpi-lbl { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; color: #64748b; }
    .ut-kpi-val { font-size: 17.5px; font-weight: 800; color: #0f172a; line-height: 1.25; margin-top: 2px; }
    .ut-kpi-sub { font-size: 11px; color: #64748b; font-weight: 600; margin-top: 2px; }

    /* Filter Box */
    .ut-filter-box { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 18px 20px; margin-bottom: 18px; box-shadow: 0 2px 6px rgba(15,23,42,0.03); }
    .ut-lbl { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; color: #475569; margin-bottom: 5px; display: block; }
    .ut-input { width: 100%; height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 0 11px; font-size: 13px; color: #0f172a; background: #fff; }
    .ut-preset-btn { display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; border-radius: 7px; font-size: 11.5px; font-weight: 700; border: 1px solid #cbd5e1; background: #f8fafc; color: #334155; cursor: pointer; text-decoration: none !important; }
    .ut-preset-btn:hover { background: #e2e8f0; color: #0f172a; }

    /* Table */
    .ut-table-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 8px rgba(15,23,42,0.03); }
    .ut-table { width: 100%; border-collapse: collapse; margin: 0; }
    .ut-table th { background: #f8fafc; padding: 12px 14px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .6px; color: #475569; border-bottom: 1px solid #e2e8f0; text-align: left; }
    .ut-table td { padding: 12px 14px; border-bottom: 1px solid #f1f5f9; font-size: 13px; vertical-align: middle; }
    .ut-table tr:hover td { background: #f8fafc; }

    /* Smart Pagination */
    .ut-pager { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }
    .ut-page-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 34px; height: 34px; padding: 0 10px; border-radius: 8px; border: 1px solid #cbd5e1; background: #fff; color: #1e293b; font-size: 12.5px; font-weight: 700; text-decoration: none !important; transition: all .15s; }
    .ut-page-btn:hover:not(.disabled):not(.active) { background: #f1f5f9; border-color: #94a3b8; }
    .ut-page-btn.active { background: #0284c7; border-color: #0284c7; color: #fff !important; }
    .ut-page-btn.disabled { opacity: .45; pointer-events: none; background: #f8fafc; }
    .ut-page-dots { padding: 0 6px; color: #64748b; font-weight: 800; }
</style>

<div class="container-fluid ut-wrap" style="padding-top: 10px;">
    @Html.Partial("_ResponseMessagePartial")

    <!-- Hero Header & Spaced Actions -->
    <div class="ut-hero">
        <div>
            <h2>
                <i class="fa fa-receipt" style="color: #38bdf8; margin-right: 8px;"></i> Client Transaction Studio: @clientName
            </h2>
            <p>
                Client ID: <strong style="color:#fff;">#@clientId</strong> &bull;
                Username: <strong style="color:#38bdf8;">@@@(client?.User?.UserName ?? "N/A")</strong> &bull;
                Email: <strong style="color:#fff;">@(client?.User?.Email ?? "N/A")</strong> &bull;
                Phone: <strong style="color:#fff;">@(client?.User?.PhoneNumber ?? "N/A")</strong>
            </p>
        </div>

        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
            <a href="@ExportUrl("excel")" class="btn btn-sm" style="background:#16a34a; color:#fff; font-weight:700; border-radius:8px; padding:7px 13px;">
                <i class="fa fa-file-excel-o"></i> Excel
            </a>
            <a href="@ExportUrl("word")" class="btn btn-sm" style="background:#2563eb; color:#fff; font-weight:700; border-radius:8px; padding:7px 13px;">
                <i class="fa fa-file-word-o"></i> Word
            </a>
            <a href="@ExportUrl("pdf")" target="_blank" class="btn btn-sm" style="background:#dc2626; color:#fff; font-weight:700; border-radius:8px; padding:7px 13px;">
                <i class="fa fa-file-pdf-o"></i> PDF
            </a>
            @if (!string.IsNullOrEmpty(client?.UserId))
            {
                <a href="@Url.Action("ClientDetails", "ManageUsers", new { area = "Adminpanel", id = client.UserId })" class="btn btn-sm" style="background:#4f46e5; color:#fff; font-weight:700; border-radius:8px; padding:7px 14px;">
                    <i class="fa fa-id-card"></i> Full User Dossier
                </a>
            }
            <a href="@Url.Action("ManageUnits", "ManageUsers", new { area = "Adminpanel", searchString = client?.User?.UserName })" class="btn btn-sm" style="background:#0284c7; color:#fff; font-weight:700; border-radius:8px; padding:7px 14px;">
                <i class="fa fa-wallet"></i> Manage Units
            </a>
            <a href="@Url.Action("Index", "ManageUsers", new { area = "Adminpanel" })" class="btn btn-sm btn-default" style="font-weight:700; border-radius:8px; padding:7px 14px;">
                <i class="fa fa-arrow-left"></i> Users
            </a>
        </div>
    </div>

    <!-- 8 Clickable Reactive Mini-Dashboard Cards -->
    <div class="ut-kpi-grid">
        <a href="@CardUrl("all")" class="ut-kpi @(cardFilter == "all" ? "active" : "")">
            <div class="ut-kpi-icon" style="background:#e0f2fe; color:#0284c7;"><i class="fa fa-list-ul"></i></div>
            <div>
                <div class="ut-kpi-lbl">Filtered Transactions</div>
                <div class="ut-kpi-val">@stats.TotalTransactions.ToString("N0")</div>
                <div class="ut-kpi-sub">@stats.ApprovedCount.ToString("N0") approved records</div>
            </div>
        </a>

        <a href="@CardUrl("approved")" class="ut-kpi @(cardFilter == "approved" ? "active" : "")">
            <div class="ut-kpi-icon" style="background:#dcfce7; color:#15803d;"><i class="fa fa-money"></i></div>
            <div>
                <div class="ut-kpi-lbl">Approved Revenue Paid</div>
                <div class="ut-kpi-val" style="color:#15803d;">&#8358;@stats.ApprovedRevenueNgn.ToString("N2")</div>
                <div class="ut-kpi-sub">Confirmed payments</div>
            </div>
        </a>

        <a href="@CardUrl("approved")" class="ut-kpi">
            <div class="ut-kpi-icon" style="background:#ede9fe; color:#6d28d9;"><i class="fa fa-coins"></i></div>
            <div>
                <div class="ut-kpi-lbl">Approved Units Credited</div>
                <div class="ut-kpi-val" style="color:#6d28d9;">+@stats.ApprovedUnitsCredited.ToString("N2")</div>
                <div class="ut-kpi-sub">Total units funded</div>
            </div>
        </a>

        <a href="@Url.Action("ManageUnits", "ManageUsers", new { area = "Adminpanel", searchString = client?.User?.UserName })" class="ut-kpi">
            <div class="ut-kpi-icon" style="background:#e0e7ff; color:#4f46e5;"><i class="fa fa-wallet"></i></div>
            <div>
                <div class="ut-kpi-lbl">Current Wallet Balance</div>
                <div class="ut-kpi-val" style="color:#4f46e5;">@((client?.Units ?? 0m).ToString("N2")) Units</div>
                <div class="ut-kpi-sub">Click to top-up / deduct</div>
            </div>
        </a>

        <a href="@CardUrl("pending")" class="ut-kpi @(cardFilter == "pending" ? "active" : "")">
            <div class="ut-kpi-icon" style="background:#fef3c7; color:#d97706;"><i class="fa fa-clock-o"></i></div>
            <div>
                <div class="ut-kpi-lbl">Pending Recharges</div>
                <div class="ut-kpi-val" style="color:#b45309;">@stats.PendingCount.ToString("N0")</div>
                <div class="ut-kpi-sub">&#8358;@stats.PendingAmountNgn.ToString("N2") awaiting approval</div>
            </div>
        </a>

        <a href="@CardUrl("paystack")" class="ut-kpi @(cardFilter == "paystack" ? "active" : "")">
            <div class="ut-kpi-icon" style="background:#e0f2fe; color:#0369a1;"><i class="fa fa-credit-card"></i></div>
            <div>
                <div class="ut-kpi-lbl">Paystack Online</div>
                <div class="ut-kpi-val" style="color:#0369a1;">@stats.PaystackCount.ToString("N0")</div>
                <div class="ut-kpi-sub">&#8358;@stats.PaystackRevenueNgn.ToString("N2") approved</div>
            </div>
        </a>

        <a href="@CardUrl("bank")" class="ut-kpi @(cardFilter == "bank" ? "active" : "")">
            <div class="ut-kpi-icon" style="background:#f1f5f9; color:#334155;"><i class="fa fa-university"></i></div>
            <div>
                <div class="ut-kpi-lbl">Bank Deposits</div>
                <div class="ut-kpi-val">@stats.BankDepositCount.ToString("N0")</div>
                <div class="ut-kpi-sub">&#8358;@stats.BankDepositRevenueNgn.ToString("N2") approved</div>
            </div>
        </a>

        <a href="@CardUrl("admin")" class="ut-kpi @(cardFilter == "admin" ? "active" : "")">
            <div class="ut-kpi-icon" style="background:#fae8ff; color:#a21caf;"><i class="fa fa-user-shield"></i></div>
            <div>
                <div class="ut-kpi-lbl">Admin Top-Up &amp; Vouchers</div>
                <div class="ut-kpi-val" style="color:#a21caf;">@stats.AdminTopUpCount.ToString("N0")</div>
                <div class="ut-kpi-sub">+@stats.AdminTopUpUnits.ToString("N2") units</div>
            </div>
        </a>
    </div>

    <!-- Multi-Criteria Filter Panel -->
    <div class="ut-filter-box">
        <form method="get" action="@Url.Action("UserTransactions", "ManageUsers", new { area = "Adminpanel", id = clientId })" id="utFilterForm">
            <input type="hidden" name="cardFilter" value="@cardFilter" />
            <input type="hidden" name="page" value="1" />

            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:12px;">
                <div style="font-size:13px; font-weight:800; color:#0f172a;">
                    <i class="fa fa-sliders" style="color:#0284c7; margin-right:6px;"></i> Filter Client Transaction History
                    @if (cardFilter != "all")
                    {
                        <span style="background:#e0f2fe; color:#0369a1; padding:3px 9px; border-radius:6px; font-size:11px; margin-left:8px;">
                            Card Filter: @cardFilter.ToUpperInvariant()
                        </span>
                    }
                </div>
                <div style="display:flex; gap:6px; flex-wrap:wrap;">
                    <button type="button" class="ut-preset-btn" onclick="setUtDatePreset('today')"><i class="fa fa-clock-o"></i> Today</button>
                    <button type="button" class="ut-preset-btn" onclick="setUtDatePreset('7days')"><i class="fa fa-calendar"></i> Last 7 Days</button>
                    <button type="button" class="ut-preset-btn" onclick="setUtDatePreset('month')"><i class="fa fa-calendar-o"></i> This Month</button>
                    <a href="@Url.Action("UserTransactions", "ManageUsers", new { area = "Adminpanel", id = clientId })" class="ut-preset-btn" style="color:#dc2626; border-color:#fecaca; background:#fef2f2;">
                        <i class="fa fa-refresh"></i> Reset All
                    </a>
                </div>
            </div>

            <div class="row" style="margin-bottom:10px;">
                <div class="col-md-3 col-sm-6" style="margin-bottom:10px;">
                    <label class="ut-lbl">Search Reference / Note / Trans ID</label>
                    <input type="text" name="search" value="@search" class="ut-input" placeholder="Reference, Note, #TransID..." />
                </div>
                <div class="col-md-2 col-sm-6" style="margin-bottom:10px;">
                    <label class="ut-lbl">Status</label>
                    <select name="statusFilter" class="ut-input">
                        <option value="all" selected="@(statusFilter == "all" ? "selected" : null)">All Statuses</option>
                        <option value="Approved" selected="@(statusFilter == "Approved" ? "selected" : null)">Approved</option>
                        <option value="Pending" selected="@(statusFilter == "Pending" ? "selected" : null)">Pending</option>
                        <option value="Failed" selected="@(statusFilter == "Failed" ? "selected" : null)">Failed</option>
                        <option value="Cancelled" selected="@(statusFilter == "Cancelled" ? "selected" : null)">Cancelled</option>
                        <option value="Revoked" selected="@(statusFilter == "Revoked" ? "selected" : null)">Revoked</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-6" style="margin-bottom:10px;">
                    <label class="ut-lbl">Payment Source</label>
                    <select name="sourceFilter" class="ut-input">
                        <option value="all" selected="@(sourceFilter == "all" ? "selected" : null)">All Sources</option>
                        <option value="Paystack" selected="@(sourceFilter == "Paystack" ? "selected" : null)">Paystack Online</option>
                        <option value="Bank Deposit" selected="@(sourceFilter == "Bank Deposit" ? "selected" : null)">Bank Deposit</option>
                        <option value="Admin Top-Up" selected="@(sourceFilter == "Admin Top-Up" ? "selected" : null)">Admin Top-Up</option>
                        <option value="Voucher" selected="@(sourceFilter == "Voucher" ? "selected" : null)">Voucher</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-6" style="margin-bottom:10px;">
                    <label class="ut-lbl">Date From</label>
                    <input type="date" id="utDateFrom" name="dateFrom" value="@dateFrom" class="ut-input" />
                </div>
                <div class="col-md-2 col-sm-6" style="margin-bottom:10px;">
                    <label class="ut-lbl">Date To</label>
                    <input type="date" id="utDateTo" name="dateTo" value="@dateTo" class="ut-input" />
                </div>
                <div class="col-md-1 col-sm-6" style="margin-bottom:10px;">
                    <label class="ut-lbl">Rows</label>
                    <select name="pageSize" class="ut-input" onchange="this.form.submit()">
                        <option value="20" selected="@(pageSize == 20 ? "selected" : null)">20</option>
                        <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50</option>
                        <option value="100" selected="@(pageSize == 100 ? "selected" : null)">100</option>
                        <option value="200" selected="@(pageSize == 200 ? "selected" : null)">200</option>
                        <option value="500" selected="@(pageSize == 500 ? "selected" : null)">500</option>
                        <option value="0" selected="@(pageSize == 0 ? "selected" : null)">All</option>
                    </select>
                </div>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
                <div style="display:flex; align-items:center; gap:10px;">
                    <label class="ut-lbl" style="margin:0;">Sort By:</label>
                    <select name="sortOrder" class="ut-input" style="width:210px; height:34px;" onchange="this.form.submit()">
                        <option value="date_desc" selected="@(sortOrder == "date_desc" ? "selected" : null)">Newest First</option>
                        <option value="date_asc" selected="@(sortOrder == "date_asc" ? "selected" : null)">Oldest First</option>
                        <option value="amount_desc" selected="@(sortOrder == "amount_desc" ? "selected" : null)">Highest Amount Paid</option>
                        <option value="units_desc" selected="@(sortOrder == "units_desc" ? "selected" : null)">Highest Units Credited</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-sm" style="background:#0284c7; border:none; border-radius:8px; font-weight:800; padding:8px 18px;">
                    <i class="fa fa-filter"></i> Apply Filter
                </button>
            </div>
        </form>
    </div>

    <!-- Transactions Table & Smart Pagination -->
    <div class="ut-table-card">
        <div style="padding:12px 16px; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <div style="font-size:13px; color:#475569; font-weight:700;">
                Showing <strong>@startItem.ToString("N0")</strong> – <strong>@endItem.ToString("N0")</strong> of <strong>@totalCount.ToString("N0")</strong> transactions for <strong>@clientName</strong>
            </div>
        </div>

        <div class="table-responsive">
            <table class="ut-table">
                <thead>
                    <tr>
                        <th style="width:50px;">S/N</th>
                        <th>Trans ID &amp; Date</th>
                        <th>Source &amp; Type</th>
                        <th>Reference &amp; Note</th>
                        <th>Amount Paid (&#8358;)</th>
                        <th>Units Credited</th>
                        <th>Approval Audit</th>
                        <th>Status</th>
                        <th style="text-align:right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            decimal paidAmt = item.AmountPaid.HasValue && item.AmountPaid > 0 ? item.AmountPaid.Value : item.Amount;
                            string src = (item.PaymentSource ?? "").Trim();
                            string srcLabel = src.IndexOf("Paystack", StringComparison.OrdinalIgnoreCase) >= 0 || item.TransactionType == TransactionType.OnlinePayment ? "PAYSTACK"
                                : src.IndexOf("Bank", StringComparison.OrdinalIgnoreCase) >= 0 || item.TransactionType == TransactionType.BankDeposit ? "BANK DEPOSIT"
                                : src.IndexOf("Voucher", StringComparison.OrdinalIgnoreCase) >= 0 ? "VOUCHER"
                                : "ADMIN TOP-UP";

                            string srcBg = srcLabel == "PAYSTACK" ? "#e0f2fe" : srcLabel == "BANK DEPOSIT" ? "#f1f5f9" : "#f3e8ff";
                            string srcFg = srcLabel == "PAYSTACK" ? "#0369a1" : srcLabel == "BANK DEPOSIT" ? "#334155" : "#7e22ce";

                            string stBg = "#fef3c7"; string stFg = "#b45309";
                            if (item.Status == TransactionStatus.Approved) { stBg = "#dcfce7"; stFg = "#15803d"; }
                            else if (item.Status == TransactionStatus.Failed || item.Status == TransactionStatus.Revoked) { stBg = "#fee2e2"; stFg = "#dc2626"; }
                            else if (item.Status == TransactionStatus.Cancelled) { stBg = "#f1f5f9"; stFg = "#475569"; }

                            <tr>
                                <td style="font-weight:700; color:#64748b;">@(sn++)</td>
                                <td style="white-space:nowrap;">
                                    <div style="font-weight:800; color:#0f172a; font-family:'JetBrains Mono', monospace;">#@item.TransactionId</div>
                                    <div style="font-size:11.5px; color:#64748b;">@item.DateCreated.ToString("dd MMM yyyy, HH:mm")</div>
                                </td>
                                <td>
                                    <span style="display:inline-block; padding:4px 9px; border-radius:6px; font-size:11px; font-weight:800; background:@srcBg; color:@srcFg;">
                                        @srcLabel
                                    </span>
                                    <div style="font-size:11px; color:#64748b; margin-top:2px;">@item.TransactionType</div>
                                </td>
                                <td style="max-width:260px;">
                                    @if (!string.IsNullOrWhiteSpace(item.TransactionReference))
                                    {
                                        <div style="font-weight:700; font-size:12px; color:#0f172a; font-family:'JetBrains Mono', monospace;">@item.TransactionReference</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Note))
                                    {
                                        <div style="font-size:11.5px; color:#64748b; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@item.Note">@item.Note</div>
                                    }
                                    @if (string.IsNullOrWhiteSpace(item.TransactionReference) && string.IsNullOrWhiteSpace(item.Note))
                                    {
                                        <span style="color:#94a3b8;">—</span>
                                    }
                                </td>
                                <td>
                                    <strong style="color:#059669; font-family:'JetBrains Mono', monospace; font-size:13.5px;">&#8358;@paidAmt.ToString("N2")</strong>
                                    @if (item.AmountPaid.HasValue && item.AmountPaid > 0 && item.AmountPaid != item.Amount)
                                    {
                                        <div style="font-size:11px; color:#94a3b8;">Subtotal: &#8358;@item.Amount.ToString("N2")</div>
                                    }
                                </td>
                                <td>
                                    <span style="display:inline-block; padding:4px 10px; border-radius:7px; background:#f8fafc; border:1px solid #e2e8f0; font-weight:800; color:#1d4ed8; font-family:'JetBrains Mono', monospace; font-size:12.5px;">
                                        +@item.Units.ToString("N2") Units
                                    </span>
                                </td>
                                <td>
                                    @if (item.DateApproved.HasValue)
                                    {
                                        <div style="font-size:12px; font-weight:600; color:#334155;">@item.DateApproved.Value.ToString("dd MMM yyyy, HH:mm")</div>
                                        <div style="font-size:11px; color:#64748b;">By: @(string.IsNullOrEmpty(item.ApprovedBy) ? "System" : item.ApprovedBy)</div>
                                    }
                                    else
                                    {
                                        <span style="font-size:11.5px; color:#94a3b8; font-style:italic;">Awaiting Approval</span>
                                    }
                                </td>
                                <td>
                                    <span style="display:inline-block; padding:4px 10px; border-radius:999px; font-size:11px; font-weight:800; text-transform:uppercase; background:@stBg; color:@stFg;">
                                        @item.Status
                                    </span>
                                </td>
                                <td style="text-align:right; white-space:nowrap;">
                                    <a href="@Url.Action("Details", "Transactions", new { area = "Adminpanel", id = item.TransactionId })" class="btn btn-xs btn-primary" style="background:#0284c7; border:none; border-radius:6px; font-weight:700; padding:5px 10px;">
                                        <i class="fa fa-eye"></i> Trans Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" style="text-align:center; padding:45px 20px; color:#64748b;">
                                <i class="fa fa-receipt" style="font-size:30px; color:#cbd5e1; display:block; margin-bottom:10px;"></i>
                                <div style="font-weight:800; font-size:15px; color:#334155;">No transaction records match your current filter</div>
                                <div style="font-size:12.5px; margin-top:4px;">Try clearing your search or resetting the filter criteria.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Smart Pagination Footer -->
        <div style="padding:14px 18px; background:#f8fafc; border-top:1px solid #e2e8f0; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
            <div style="font-size:12.5px; color:#64748b; font-weight:600;">
                Page <strong>@currentPage</strong> of <strong>@totalPages</strong> &bull; Total <strong>@totalCount.ToString("N0")</strong> transactions
            </div>

            @if (totalPages > 1 && pageSize > 0)
            {
                int startPage = Math.Max(1, currentPage - 2);
                int endPage = Math.Min(totalPages, currentPage + 2);

                <div class="ut-pager">
                    <a href="@PageUrl(1)" class="ut-page-btn @(currentPage == 1 ? "disabled" : "")" title="First Page">&laquo;</a>
                    <a href="@PageUrl(Math.Max(1, currentPage - 1))" class="ut-page-btn @(currentPage == 1 ? "disabled" : "")" title="Previous Page">&lsaquo;</a>

                    @if (startPage > 1)
                    {
                        <a href="@PageUrl(1)" class="ut-page-btn">1</a>
                        if (startPage > 2)
                        {
                            <span class="ut-page-dots">...</span>
                        }
                    }

                    @for (int p = startPage; p <= endPage; p++)
                    {
                        <a href="@PageUrl(p)" class="ut-page-btn @(p == currentPage ? "active" : "")">@p</a>
                    }

                    @if (endPage < totalPages)
                    {
                        if (endPage < totalPages - 1)
                        {
                            <span class="ut-page-dots">...</span>
                        }
                        <a href="@PageUrl(totalPages)" class="ut-page-btn">@totalPages</a>
                    }

                    <a href="@PageUrl(Math.Min(totalPages, currentPage + 1))" class="ut-page-btn @(currentPage == totalPages ? "disabled" : "")" title="Next Page">&rsaquo;</a>
                    <a href="@PageUrl(totalPages)" class="ut-page-btn @(currentPage == totalPages ? "disabled" : "")" title="Last Page">&raquo;</a>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function setUtDatePreset(preset) {
        var now = new Date();
        var yyyy = now.getFullYear();
        var mm = String(now.getMonth() + 1).padStart(2, '0');
        var dd = String(now.getDate()).padStart(2, '0');
        var todayStr = yyyy + '-' + mm + '-' + dd;

        if (preset === 'today') {
            document.getElementById('utDateFrom').value = todayStr;
            document.getElementById('utDateTo').value = todayStr;
        } else if (preset === '7days') {
            var past = new Date(now.getTime() - (7 * 24 * 60 * 60 * 1000));
            var py = past.getFullYear();
            var pm = String(past.getMonth() + 1).padStart(2, '0');
            var pd = String(past.getDate()).padStart(2, '0');
            document.getElementById('utDateFrom').value = py + '-' + pm + '-' + pd;
            document.getElementById('utDateTo').value = todayStr;
        } else if (preset === 'month') {
            document.getElementById('utDateFrom').value = yyyy + '-' + mm + '-01';
            document.getElementById('utDateTo').value = todayStr;
        }
        document.getElementById('utFilterForm').submit();
    }
</script>
