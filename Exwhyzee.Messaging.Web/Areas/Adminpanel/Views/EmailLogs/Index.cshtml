@model IEnumerable<Exwhyzee.Messaging.Core.Dtos.EmailLogItemDto>
@using Exwhyzee.Messaging.Core.Dtos

@{
    ViewData["Title"] = "Outbound Email Audit Studio";
    var stats = ViewBag.Stats as EmailLogStatsDto ?? new EmailLogStatsDto();
    string search = ViewBag.Search as string ?? "";
    string statusFilter = ViewBag.StatusFilter as string ?? "all";
    string categoryFilter = ViewBag.CategoryFilter as string ?? "all";
    string cardFilter = ViewBag.CardFilter as string ?? "all";
    string dateFrom = ViewBag.DateFrom as string ?? "";
    string dateTo = ViewBag.DateTo as string ?? "";
    string sortOrder = ViewBag.SortOrder as string ?? "date_desc";
    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 20;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    int totalCount = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : 0;

    int startItem = totalCount == 0 ? 0 : (pageSize <= 0 ? 1 : ((currentPage - 1) * pageSize) + 1);
    int endItem = totalCount == 0 ? 0 : (pageSize <= 0 ? totalCount : Math.Min(currentPage * pageSize, totalCount));

    string CardUrl(string cf) => Url.Action("Index", "EmailLogs", new
    {
        area = "Adminpanel",
        search,
        statusFilter,
        categoryFilter,
        cardFilter = cf,
        dateFrom,
        dateTo,
        sortOrder,
        page = 1,
        pageSize
    });

    string PageUrl(int p) => Url.Action("Index", "EmailLogs", new
    {
        area = "Adminpanel",
        search,
        statusFilter,
        categoryFilter,
        cardFilter,
        dateFrom,
        dateTo,
        sortOrder,
        page = p,
        pageSize
    });

    string ExportUrl(string fmt) => Url.Action("ExportEmailLogs", "EmailLogs", new
    {
        area = "Adminpanel",
        format = fmt,
        search,
        statusFilter,
        categoryFilter,
        cardFilter,
        dateFrom,
        dateTo,
        sortOrder
    });
}

<style>
    .em-wrap { font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif; color: #1e293b; }
    .em-header { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 18px 22px; margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; box-shadow: 0 2px 6px rgba(15,23,42,0.03); }
    .em-header h2 { margin: 0; font-size: 20px; font-weight: 800; color: #0f172a; }
    .em-header p { margin: 4px 0 0; font-size: 13px; color: #64748b; }

    /* Reactive Clickable Mini-Dashboard */
    .em-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 18px; }
    @@media (max-width: 1100px) { .em-kpi-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 600px) { .em-kpi-grid { grid-template-columns: 1fr; } }

    .em-kpi { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 16px; text-decoration: none !important; color: inherit !important; display: flex; align-items: center; gap: 13px; transition: all .18s ease; box-shadow: 0 1px 4px rgba(15,23,42,0.02); position: relative; }
    .em-kpi:hover { transform: translateY(-2px); border-color: #94a3b8; box-shadow: 0 6px 14px rgba(15,23,42,0.06); }
    .em-kpi.active { border: 2px solid #0284c7; background: #f0f9ff; }
    .em-kpi-icon { width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 17px; flex-shrink: 0; }
    .em-kpi-lbl { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; color: #64748b; }
    .em-kpi-val { font-size: 18px; font-weight: 800; color: #0f172a; line-height: 1.25; margin-top: 2px; }
    .em-kpi-sub { font-size: 11px; color: #64748b; font-weight: 600; margin-top: 2px; }

    /* Filter Panel */
    .em-filter-box { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 18px 20px; margin-bottom: 18px; box-shadow: 0 2px 6px rgba(15,23,42,0.03); }
    .em-lbl { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; color: #475569; margin-bottom: 5px; display: block; }
    .em-input { width: 100%; height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 0 11px; font-size: 13px; color: #0f172a; background: #fff; }
    .em-input:focus { border-color: #0284c7; outline: none; }

    .em-preset-btn { display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; border-radius: 7px; font-size: 11.5px; font-weight: 700; border: 1px solid #cbd5e1; background: #f8fafc; color: #334155; cursor: pointer; text-decoration: none !important; }
    .em-preset-btn:hover { background: #e2e8f0; color: #0f172a; }

    /* Table */
    .em-table-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 8px rgba(15,23,42,0.03); }
    .em-table { width: 100%; border-collapse: collapse; margin: 0; }
    .em-table th { background: #f8fafc; padding: 12px 14px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .6px; color: #475569; border-bottom: 1px solid #e2e8f0; text-align: left; }
    .em-table td { padding: 12px 14px; border-bottom: 1px solid #f1f5f9; font-size: 13px; vertical-align: middle; }
    .em-table tr:hover td { background: #f8fafc; }

    /* Smart Pagination */
    .em-pager { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }
    .em-page-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 34px; height: 34px; padding: 0 10px; border-radius: 8px; border: 1px solid #cbd5e1; background: #fff; color: #1e293b; font-size: 12.5px; font-weight: 700; text-decoration: none !important; transition: all .15s; }
    .em-page-btn:hover:not(.disabled):not(.active) { background: #f1f5f9; border-color: #94a3b8; }
    .em-page-btn.active { background: #0284c7; border-color: #0284c7; color: #fff !important; }
    .em-page-btn.disabled { opacity: .45; pointer-events: none; background: #f8fafc; }
    .em-page-dots { padding: 0 6px; color: #64748b; font-weight: 800; }
</style>

<div class="em-wrap" style="padding: 15px;">
    @Html.Partial("_ResponseMessagePartial")

    <!-- Top Studio Header & Spaced Actions -->
    <div class="em-header">
        <div>
            <h2><i class="fa fa-envelope-open-text" style="color:#0284c7; margin-right:8px;"></i> Outbound Email Audit Studio</h2>
            <p>Reactive analytics, multi-criteria filtering, and audit logs for all system emails dispatched via ZeptoMail.</p>
        </div>
        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
            <a href="@ExportUrl("excel")" class="btn btn-sm" style="background:#16a34a; color:#fff; font-weight:700; border-radius:8px; padding:7px 13px;">
                <i class="fa fa-file-excel-o"></i> Excel
            </a>
            <a href="@ExportUrl("word")" class="btn btn-sm" style="background:#2563eb; color:#fff; font-weight:700; border-radius:8px; padding:7px 13px;">
                <i class="fa fa-file-word-o"></i> Word
            </a>
            <a href="@ExportUrl("pdf")" target="_blank" class="btn btn-sm" style="background:#dc2626; color:#fff; font-weight:700; border-radius:8px; padding:7px 13px;">
                <i class="fa fa-file-pdf-o"></i> PDF
            </a>
            <button type="button" class="btn btn-sm" data-toggle="modal" data-target="#testEmailModal" style="background:#0284c7; color:#fff; font-weight:700; border-radius:8px; padding:7px 14px;">
                <i class="fa fa-paper-plane"></i> Send Test Email
            </button>
            <div class="dropdown" style="display:inline-block;">
                <button class="btn btn-default btn-sm dropdown-toggle" type="button" data-toggle="dropdown" style="font-weight:700; border-radius:8px; padding:7px 13px;">
                    <i class="fa fa-trash-can" style="color:#dc2626;"></i> Purge Old Logs <span class="caret"></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-right">
                    <li>
                        <form asp-action="PurgeOlderThan" method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="days" value="7" />
                            <button type="submit" class="btn btn-link" style="color:#334155; font-weight:600;" onclick="return confirm('Purge all email logs older than 7 days?');">Purge Older Than 7 Days</button>
                        </form>
                    </li>
                    <li>
                        <form asp-action="PurgeOlderThan" method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="days" value="30" />
                            <button type="submit" class="btn btn-link" style="color:#334155; font-weight:600;" onclick="return confirm('Purge all email logs older than 30 days?');">Purge Older Than 30 Days</button>
                        </form>
                    </li>
                    <li>
                        <form asp-action="PurgeOlderThan" method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="days" value="90" />
                            <button type="submit" class="btn btn-link" style="color:#334155; font-weight:600;" onclick="return confirm('Purge all email logs older than 90 days?');">Purge Older Than 90 Days</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- 8 Clickable Reactive Mini-Dashboard Cards (Outcome of Active Filter) -->
    <div class="em-kpi-grid">
        <a href="@CardUrl("all")" class="em-kpi @(cardFilter == "all" ? "active" : "")">
            <div class="em-kpi-icon" style="background:#e0f2fe; color:#0284c7;"><i class="fa fa-envelope"></i></div>
            <div>
                <div class="em-kpi-lbl">Total Filtered Emails</div>
                <div class="em-kpi-val">@stats.TotalFiltered.ToString("N0")</div>
                <div class="em-kpi-sub">@stats.DeliveryRatePercent.ToString("N1")% Delivery Rate</div>
            </div>
        </a>

        <a href="@CardUrl("delivered")" class="em-kpi @(cardFilter == "delivered" ? "active" : "")">
            <div class="em-kpi-icon" style="background:#dcfce7; color:#15803d;"><i class="fa fa-check-circle"></i></div>
            <div>
                <div class="em-kpi-lbl">Delivered Successfully</div>
                <div class="em-kpi-val" style="color:#15803d;">@stats.DeliveredCount.ToString("N0")</div>
                <div class="em-kpi-sub">Dispatched via ZeptoMail</div>
            </div>
        </a>

        <a href="@CardUrl("failed")" class="em-kpi @(cardFilter == "failed" ? "active" : "")">
            <div class="em-kpi-icon" style="background:#fee2e2; color:#dc2626;"><i class="fa fa-exclamation-triangle"></i></div>
            <div>
                <div class="em-kpi-lbl">Dispatch Failures</div>
                <div class="em-kpi-val" style="color:#dc2626;">@stats.FailedCount.ToString("N0")</div>
                <div class="em-kpi-sub">Click to inspect errors</div>
            </div>
        </a>

        <a href="@CardUrl("today")" class="em-kpi @(cardFilter == "today" ? "active" : "")">
            <div class="em-kpi-icon" style="background:#ede9fe; color:#6d28d9;"><i class="fa fa-calendar-check-o"></i></div>
            <div>
                <div class="em-kpi-lbl">Dispatched Today</div>
                <div class="em-kpi-val" style="color:#6d28d9;">@stats.SentTodayCount.ToString("N0")</div>
                <div class="em-kpi-sub">Sent today (UTC)</div>
            </div>
        </a>

        <a href="@CardUrl("otp")" class="em-kpi @(cardFilter == "otp" ? "active" : "")">
            <div class="em-kpi-icon" style="background:#fef3c7; color:#d97706;"><i class="fa fa-shield"></i></div>
            <div>
                <div class="em-kpi-lbl">OTP &amp; Security Alerts</div>
                <div class="em-kpi-val" style="color:#b45309;">@stats.OtpSecurityCount.ToString("N0")</div>
                <div class="em-kpi-sub">2FA, OTP &amp; Password Reset</div>
            </div>
        </a>

        <a href="@CardUrl("receipt")" class="em-kpi @(cardFilter == "receipt" ? "active" : "")">
            <div class="em-kpi-icon" style="background:#dcfce7; color:#059669;"><i class="fa fa-credit-card"></i></div>
            <div>
                <div class="em-kpi-lbl">Payment &amp; Wallet Receipts</div>
                <div class="em-kpi-val" style="color:#059669;">@stats.PaymentReceiptCount.ToString("N0")</div>
                <div class="em-kpi-sub">Top-up &amp; billing notices</div>
            </div>
        </a>

        <a href="@CardUrl("welcome")" class="em-kpi @(cardFilter == "welcome" ? "active" : "")">
            <div class="em-kpi-icon" style="background:#e0e7ff; color:#4f46e5;"><i class="fa fa-user-plus"></i></div>
            <div>
                <div class="em-kpi-lbl">Welcome &amp; Account</div>
                <div class="em-kpi-val" style="color:#4f46e5;">@stats.WelcomeNoticeCount.ToString("N0")</div>
                <div class="em-kpi-sub">Onboarding &amp; KYC notices</div>
            </div>
        </a>

        <a href="@CardUrl("all")" class="em-kpi">
            <div class="em-kpi-icon" style="background:#f1f5f9; color:#334155;"><i class="fa fa-users"></i></div>
            <div>
                <div class="em-kpi-lbl">Unique Recipients</div>
                <div class="em-kpi-val">@stats.UniqueRecipientsCount.ToString("N0")</div>
                <div class="em-kpi-sub">Distinct email addresses</div>
            </div>
        </a>
    </div>

    <!-- Serious Multi-Criteria Filter Panel -->
    <div class="em-filter-box">
        <form method="get" action="@Url.Action("Index", "EmailLogs", new { area = "Adminpanel" })" id="emFilterForm">
            <input type="hidden" name="cardFilter" value="@cardFilter" />
            <input type="hidden" name="page" value="1" />

            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:12px;">
                <div style="font-size:13px; font-weight:800; color:#0f172a;">
                    <i class="fa fa-sliders" style="color:#0284c7; margin-right:6px;"></i> Filter &amp; Search Email Audit Ledger
                    @if (cardFilter != "all")
                    {
                        <span style="background:#e0f2fe; color:#0369a1; padding:3px 9px; border-radius:6px; font-size:11px; margin-left:8px;">
                            Card Filter: @cardFilter.ToUpperInvariant()
                        </span>
                    }
                </div>
                <div style="display:flex; gap:6px; flex-wrap:wrap;">
                    <button type="button" class="em-preset-btn" onclick="setEmDatePreset('today')"><i class="fa fa-clock-o"></i> Today</button>
                    <button type="button" class="em-preset-btn" onclick="setEmDatePreset('7days')"><i class="fa fa-calendar"></i> Last 7 Days</button>
                    <button type="button" class="em-preset-btn" onclick="setEmDatePreset('month')"><i class="fa fa-calendar-o"></i> This Month</button>
                    <a href="@Url.Action("Index", "EmailLogs", new { area = "Adminpanel" })" class="em-preset-btn" style="color:#dc2626; border-color:#fecaca; background:#fef2f2;">
                        <i class="fa fa-refresh"></i> Reset All
                    </a>
                </div>
            </div>

            <div class="row" style="margin-bottom:10px;">
                <div class="col-md-3 col-sm-6" style="margin-bottom:10px;">
                    <label class="em-lbl">Search Recipient / Subject / User</label>
                    <input type="text" name="search" value="@search" class="em-input" placeholder="Email, Subject, Error, Username, #ID..." />
                </div>
                <div class="col-md-2 col-sm-6" style="margin-bottom:10px;">
                    <label class="em-lbl">Delivery Status</label>
                    <select name="statusFilter" class="em-input">
                        <option value="all" selected="@(statusFilter == "all" ? "selected" : null)">All Statuses</option>
                        <option value="Delivered" selected="@(statusFilter == "Delivered" || statusFilter == "Success" ? "selected" : null)">Delivered Only</option>
                        <option value="Failed" selected="@(statusFilter == "Failed" ? "selected" : null)">Failed Only</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-6" style="margin-bottom:10px;">
                    <label class="em-lbl">Email Category</label>
                    <select name="categoryFilter" class="em-input">
                        <option value="all" selected="@(categoryFilter == "all" ? "selected" : null)">All Categories</option>
                        <option value="OTP & Security" selected="@(categoryFilter == "OTP & Security" ? "selected" : null)">OTP &amp; Security</option>
                        <option value="Payment Receipt" selected="@(categoryFilter == "Payment Receipt" ? "selected" : null)">Payment Receipt</option>
                        <option value="Welcome & Account" selected="@(categoryFilter == "Welcome & Account" ? "selected" : null)">Welcome &amp; Account</option>
                        <option value="Support Ticket" selected="@(categoryFilter == "Support Ticket" ? "selected" : null)">Support Ticket</option>
                        <option value="System Alert" selected="@(categoryFilter == "System Alert" ? "selected" : null)">System Alert</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-6" style="margin-bottom:10px;">
                    <label class="em-lbl">Date From</label>
                    <input type="date" id="emDateFrom" name="dateFrom" value="@dateFrom" class="em-input" />
                </div>
                <div class="col-md-2 col-sm-6" style="margin-bottom:10px;">
                    <label class="em-lbl">Date To</label>
                    <input type="date" id="emDateTo" name="dateTo" value="@dateTo" class="em-input" />
                </div>
                <div class="col-md-1 col-sm-6" style="margin-bottom:10px;">
                    <label class="em-lbl">Rows</label>
                    <select name="pageSize" class="em-input" onchange="this.form.submit()">
                        <option value="20" selected="@(pageSize == 20 ? "selected" : null)">20</option>
                        <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50</option>
                        <option value="100" selected="@(pageSize == 100 ? "selected" : null)">100</option>
                        <option value="200" selected="@(pageSize == 200 ? "selected" : null)">200</option>
                        <option value="500" selected="@(pageSize == 500 ? "selected" : null)">500</option>
                        <option value="0" selected="@(pageSize == 0 ? "selected" : null)">All</option>
                    </select>
                </div>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
                <div style="display:flex; align-items:center; gap:10px;">
                    <label class="em-lbl" style="margin:0;">Sort By:</label>
                    <select name="sortOrder" class="em-input" style="width:210px; height:34px;" onchange="this.form.submit()">
                        <option value="date_desc" selected="@(sortOrder == "date_desc" ? "selected" : null)">Newest First</option>
                        <option value="date_asc" selected="@(sortOrder == "date_asc" ? "selected" : null)">Oldest First</option>
                        <option value="failed_first" selected="@(sortOrder == "failed_first" ? "selected" : null)">Failures First</option>
                        <option value="recipient_asc" selected="@(sortOrder == "recipient_asc" ? "selected" : null)">Recipient Email (A–Z)</option>
                        <option value="subject_asc" selected="@(sortOrder == "subject_asc" ? "selected" : null)">Subject (A–Z)</option>
                    </select>
                </div>
                <div style="display:flex; gap:8px;">
                    <button type="submit" class="btn btn-primary btn-sm" style="background:#0284c7; border:none; border-radius:8px; font-weight:800; padding:8px 18px;">
                        <i class="fa fa-filter"></i> Apply Filter
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Batch Delete & Email Audit Table -->
    <form asp-action="BatchDelete" method="post" id="batchForm">
        @Html.AntiForgeryToken()

        <div class="em-table-card">
            <div style="padding:12px 16px; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
                <div style="font-size:13px; color:#475569; font-weight:700;">
                    Showing <strong>@startItem.ToString("N0")</strong> – <strong>@endItem.ToString("N0")</strong> of <strong>@totalCount.ToString("N0")</strong> email logs
                </div>
                <button type="submit" class="btn btn-danger btn-xs" style="border-radius:7px; font-weight:700; padding:6px 12px;" onclick="return confirm('Delete all selected email log entries?');">
                    <i class="fa fa-trash"></i> Delete Selected
                </button>
            </div>

            <div class="table-responsive">
                <table class="em-table">
                    <thead>
                        <tr>
                            <th style="width:38px; text-align:center;">
                                <input type="checkbox" id="selectAll" />
                            </th>
                            <th>Log ID &amp; Date (UTC)</th>
                            <th>Recipient &amp; User</th>
                            <th>Category</th>
                            <th>Subject</th>
                            <th>Status</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td style="text-align:center;">
                                        <input type="checkbox" name="selectedIds" value="@item.Id" class="logCheckbox" />
                                    </td>
                                    <td style="white-space:nowrap;">
                                        <div style="font-weight:800; color:#0f172a; font-size:12.5px;">#@item.Id</div>
                                        <div style="font-size:11.5px; color:#64748b;">@item.DateSent.ToString("dd MMM yyyy, HH:mm:ss")</div>
                                    </td>
                                    <td>
                                        <div style="font-weight:800; color:#0f172a; word-break:break-all;">@item.RecipientEmail</div>
                                        @if (!string.IsNullOrEmpty(item.MatchedUserId))
                                        {
                                            <div style="font-size:11.5px; color:#0284c7; font-weight:700; margin-top:2px;">
                                                <i class="fa fa-user"></i> @item.MatchedFullName (@item.MatchedUserName)
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            string catBg = "#f1f5f9";
                                            string catFg = "#475569";
                                            if (item.Category == "OTP & Security") { catBg = "#fef3c7"; catFg = "#b45309"; }
                                            else if (item.Category == "Payment Receipt") { catBg = "#dcfce7"; catFg = "#15803d"; }
                                            else if (item.Category == "Welcome & Account") { catBg = "#e0e7ff"; catFg = "#4338ca"; }
                                            else if (item.Category == "Support Ticket") { catBg = "#e0f2fe"; catFg = "#0369a1"; }
                                        }
                                        <span style="display:inline-block; padding:4px 9px; border-radius:6px; font-size:11px; font-weight:800; background:@catBg; color:@catFg;">
                                            @item.Category
                                        </span>
                                    </td>
                                    <td style="max-width:300px;">
                                        <div style="font-weight:600; color:#1e293b; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@item.Subject">
                                            @item.Subject
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.IsSuccess)
                                        {
                                            <span style="display:inline-flex; align-items:center; gap:5px; padding:4px 10px; border-radius:999px; font-size:11.5px; font-weight:800; background:#dcfce7; color:#15803d;">
                                                <i class="fa fa-check-circle"></i> Delivered
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="display:inline-flex; align-items:center; gap:5px; padding:4px 10px; border-radius:999px; font-size:11.5px; font-weight:800; background:#fee2e2; color:#dc2626;" title="@item.ErrorMessage">
                                                <i class="fa fa-times-circle"></i> Failed
                                            </span>
                                            @if (!string.IsNullOrEmpty(item.ErrorMessage))
                                            {
                                                <div style="font-size:11px; color:#dc2626; margin-top:3px; max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@item.ErrorMessage">
                                                    @item.ErrorMessage
                                                </div>
                                            }
                                        }
                                    </td>
                                    <td style="text-align:right; white-space:nowrap;">
                                        <div style="display:inline-flex; gap:6px; align-items:center;">
                                            <button type="button" class="btn btn-xs btn-info" onclick="previewEmail(@item.Id)" style="border-radius:6px; font-weight:700; padding:4px 9px;">
                                                <i class="fa fa-eye"></i> View
                                            </button>
                                            <button type="button" class="btn btn-xs btn-default" onclick="resendEmailLog(@item.Id, '@item.RecipientEmail')" style="border-radius:6px; font-weight:700; padding:4px 9px; border-color:#cbd5e1;" title="Re-dispatch this email">
                                                <i class="fa fa-rotate-right"></i> Resend
                                            </button>
                                            @if (!string.IsNullOrEmpty(item.MatchedUserId))
                                            {
                                                <a href="@Url.Action("ClientDetails", "ManageUsers", new { area = "Adminpanel", id = item.MatchedUserId })" class="btn btn-xs" style="background:#4f46e5; color:#fff; border-radius:6px; font-weight:700; padding:4px 9px;" title="Open User Full Dossier">
                                                    <i class="fa fa-id-card"></i> User
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" style="text-align:center; padding:45px 20px; color:#64748b;">
                                    <i class="fa fa-envelope-open-o" style="font-size:32px; color:#94a3b8; display:block; margin-bottom:10px;"></i>
                                    <div style="font-weight:800; font-size:15px; color:#334155;">No email audit logs match your current filter</div>
                                    <div style="font-size:12.5px; margin-top:4px;">Try clearing your search or selecting a broader date range.</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Smart Pagination Footer -->
            <div style="padding:14px 18px; background:#f8fafc; border-top:1px solid #e2e8f0; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
                <div style="font-size:12.5px; color:#64748b; font-weight:600;">
                    Page <strong>@currentPage</strong> of <strong>@totalPages</strong> &bull; Total <strong>@totalCount.ToString("N0")</strong> matching email logs
                </div>

                @if (totalPages > 1 && pageSize > 0)
                {
                    int startPage = Math.Max(1, currentPage - 2);
                    int endPage = Math.Min(totalPages, currentPage + 2);

                    <div class="em-pager">
                        <a href="@PageUrl(1)" class="em-page-btn @(currentPage == 1 ? "disabled" : "")" title="First Page">&laquo;</a>
                        <a href="@PageUrl(Math.Max(1, currentPage - 1))" class="em-page-btn @(currentPage == 1 ? "disabled" : "")" title="Previous Page">&lsaquo;</a>

                        @if (startPage > 1)
                        {
                            <a href="@PageUrl(1)" class="em-page-btn">1</a>
                            if (startPage > 2)
                            {
                                <span class="em-page-dots">...</span>
                            }
                        }

                        @for (int p = startPage; p <= endPage; p++)
                        {
                            <a href="@PageUrl(p)" class="em-page-btn @(p == currentPage ? "active" : "")">@p</a>
                        }

                        @if (endPage < totalPages)
                        {
                            if (endPage < totalPages - 1)
                            {
                                <span class="em-page-dots">...</span>
                            }
                            <a href="@PageUrl(totalPages)" class="em-page-btn">@totalPages</a>
                        }

                        <a href="@PageUrl(Math.Min(totalPages, currentPage + 1))" class="em-page-btn @(currentPage == totalPages ? "disabled" : "")" title="Next Page">&rsaquo;</a>
                        <a href="@PageUrl(totalPages)" class="em-page-btn @(currentPage == totalPages ? "disabled" : "")" title="Last Page">&raquo;</a>
                    </div>
                }
            </div>
        </div>
    </form>
</div>

<!-- PREVIEW MODAL -->
<div class="modal fade" id="emailPreviewModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" style="border-radius:16px; overflow:hidden;">
            <div class="modal-header" style="background:#0f172a; color:#ffffff; padding:16px 24px;">
                <button type="button" class="close" data-dismiss="modal" style="color:#ffffff; opacity:0.8;">&times;</button>
                <h4 class="modal-title" style="font-weight:800; font-size:1.1rem;" id="modalSubject">Email Preview</h4>
            </div>
            <div class="modal-body" style="padding:24px;">
                <div style="background:#f8fafc; border-radius:8px; padding:12px 16px; margin-bottom:16px; font-size:0.88rem;">
                    <div><strong>To:</strong> <span id="modalRecipient"></span></div>
                    <div><strong>Date Sent:</strong> <span id="modalDate"></span></div>
                </div>
                <iframe id="emailFrame" style="width:100%; height:450px; border:1px solid #e2e8f0; border-radius:8px;"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- SEND TEST EMAIL MODAL -->
<div class="modal fade" id="testEmailModal" tabindex="-1" role="dialog" aria-labelledby="testEmailModalLabel">
    <div class="modal-dialog modal-sm" style="max-width: 440px;" role="document">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
            <div class="modal-header" style="background: #0b0f19; color: #ffffff; padding: 18px 24px; border-bottom: 3px solid #0284c7;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: #ffffff; opacity: 0.8;">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="testEmailModalLabel" style="font-weight: 800; font-size: 1.1rem;">
                    <i class="fa fa-paper-plane" style="color: #0284c7;"></i> Send Test Email
                </h4>
            </div>
            <div class="modal-body" style="padding: 24px;">
                @using (Html.BeginForm("SendTestEmail", "EmailLogs", new { area = "Adminpanel" }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 700; color: #334155; font-size: 0.88rem;">Recipient Email Address</label>
                        <input type="email" name="testRecipientEmail" class="form-control" placeholder="admin@example.com" required style="height: 44px; border-radius: 8px; border-color: #cbd5e1;" />
                        <small style="color: #64748b; margin-top: 4px; display: block;">We will send a live HTML test email via ZeptoMail to verify deliverability and logging.</small>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block btn-lg" style="font-weight: 800; border-radius: 8px; height: 46px; background: #0284c7; border: none;">
                        <i class="fa fa-paper-plane"></i> Dispatch Test Email
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- HIDDEN FORM FOR RESEND -->
<form id="resendForm" asp-action="ResendEmail" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="resendLogId" />
</form>

<script>
    document.getElementById('selectAll').addEventListener('change', function () {
        var checkboxes = document.querySelectorAll('.logCheckbox');
        for (var i = 0; i < checkboxes.length; i++) {
            checkboxes[i].checked = this.checked;
        }
    });

    function setEmDatePreset(preset) {
        var now = new Date();
        var yyyy = now.getFullYear();
        var mm = String(now.getMonth() + 1).padStart(2, '0');
        var dd = String(now.getDate()).padStart(2, '0');
        var todayStr = yyyy + '-' + mm + '-' + dd;

        if (preset === 'today') {
            document.getElementById('emDateFrom').value = todayStr;
            document.getElementById('emDateTo').value = todayStr;
        } else if (preset === '7days') {
            var past = new Date(now.getTime() - (7 * 24 * 60 * 60 * 1000));
            var py = past.getFullYear();
            var pm = String(past.getMonth() + 1).padStart(2, '0');
            var pd = String(past.getDate()).padStart(2, '0');
            document.getElementById('emDateFrom').value = py + '-' + pm + '-' + pd;
            document.getElementById('emDateTo').value = todayStr;
        } else if (preset === 'month') {
            document.getElementById('emDateFrom').value = yyyy + '-' + mm + '-01';
            document.getElementById('emDateTo').value = todayStr;
        }
        document.getElementById('emFilterForm').submit();
    }

    function previewEmail(id) {
        $.get('/Adminpanel/EmailLogs/GetBody/' + id, function (data) {
            if (data.success) {
                $('#modalSubject').text(data.subject);
                $('#modalRecipient').text(data.recipient);
                $('#modalDate').text(data.date);

                var doc = document.getElementById('emailFrame').contentWindow.document;
                doc.open();
                doc.write(data.html);
                doc.close();

                $('#emailPreviewModal').modal('show');
            } else {
                alert(data.error || 'Unable to load email preview.');
            }
        });
    }

    function resendEmailLog(id, recipient) {
        if (confirm('Are you sure you want to re-send this email to ' + recipient + '?')) {
            document.getElementById('resendLogId').value = id;
            document.getElementById('resendForm').submit();
        }
    }
</script>
