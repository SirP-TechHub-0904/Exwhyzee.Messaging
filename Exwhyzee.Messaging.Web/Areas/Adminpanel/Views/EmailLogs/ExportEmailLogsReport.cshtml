@model IEnumerable<Exwhyzee.Messaging.Core.Dtos.EmailLogItemDto>
@using Exwhyzee.Messaging.Core.Dtos

@{
    Layout = null;
    var stats = ViewBag.Stats as EmailLogStatsDto ?? new EmailLogStatsDto();
    DateTime generatedAt = ViewBag.GeneratedAt != null ? (DateTime)ViewBag.GeneratedAt : DateTime.UtcNow.AddHours(1);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Outbound Email Audit Report — Exwhyzee Messaging</title>
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; color: #0f172a; margin: 24px; font-size: 12px; }
        .top-bar { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #0f172a; padding-bottom: 12px; margin-bottom: 16px; }
        .top-bar h1 { margin: 0; font-size: 18px; font-weight: 800; }
        .top-bar p { margin: 3px 0 0; color: #475569; font-size: 11.5px; }
        .summary-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
        .summary-box { border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px 14px; background: #f8fafc; min-width: 130px; }
        .summary-box .lbl { font-size: 10px; text-transform: uppercase; color: #64748b; font-weight: 700; }
        .summary-box .val { font-size: 15px; font-weight: 800; margin-top: 2px; }
        table { width: 100%; border-collapse: collapse; }
        th { background: #0f172a; color: #fff; padding: 8px; font-size: 11px; text-align: left; border: 1px solid #0f172a; }
        td { padding: 7px 8px; border: 1px solid #cbd5e1; font-size: 11.5px; vertical-align: top; }
        tr:nth-child(even) td { background: #f8fafc; }
        .print-btn { background: #0284c7; color: #fff; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 700; cursor: pointer; }
        @@media print { .no-print { display: none !important; } body { margin: 0; } }
    </style>
</head>
<body onload="window.print()">
    <div class="top-bar">
        <div>
            <h1>Exwhyzee Messaging — Outbound Email Audit Report</h1>
            <p>Generated: @generatedAt.ToString("dd MMM yyyy, hh:mm tt")</p>
        </div>
        <div class="no-print">
            <button class="print-btn" onclick="window.print()">Print / Save PDF</button>
        </div>
    </div>

    <div class="summary-row">
        <div class="summary-box">
            <div class="lbl">Total Filtered</div>
            <div class="val">@stats.TotalFiltered.ToString("N0")</div>
        </div>
        <div class="summary-box">
            <div class="lbl">Delivered</div>
            <div class="val" style="color:#15803d;">@stats.DeliveredCount.ToString("N0") (@stats.DeliveryRatePercent.ToString("N1")%)</div>
        </div>
        <div class="summary-box">
            <div class="lbl">Failed</div>
            <div class="val" style="color:#dc2626;">@stats.FailedCount.ToString("N0")</div>
        </div>
        <div class="summary-box">
            <div class="lbl">Unique Recipients</div>
            <div class="val">@stats.UniqueRecipientsCount.ToString("N0")</div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Log ID</th>
                <th>Date &amp; Time (UTC)</th>
                <th>Recipient Email</th>
                <th>User</th>
                <th>Category</th>
                <th>Subject</th>
                <th>Status</th>
                <th>Error Details</th>
            </tr>
        </thead>
        <tbody>
            @{
                int sn = 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(sn++)</td>
                    <td>#@item.Id</td>
                    <td>@item.DateSent.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@item.RecipientEmail</td>
                    <td>@(item.MatchedUserName ?? "-")</td>
                    <td>@item.Category</td>
                    <td>@item.Subject</td>
                    <td style="font-weight:700; color:@(item.IsSuccess ? "#15803d" : "#dc2626");">@(item.IsSuccess ? "DELIVERED" : "FAILED")</td>
                    <td>@(item.ErrorMessage ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>

