@{
    ViewBag.Title = "Top Up SMS Units";
    decimal pricePerUnit = ViewBag.PricePerUnit ?? 2.0m;
    var client = ViewBag.Client as Exwhyzee.Messaging.Core.Models.Client;
    decimal currentUnits = client?.Units ?? 0;
    string userEmail = ViewBag.UserEmail ?? "";
    string publicKey = ViewBag.PaystackPublicKey ?? "";
}

<style>
    .xyz-topup-hero {
        background: linear-gradient(135deg, #0B0F19 0%, #1E1B4B 50%, #0B0F19 100%);
        border-radius: 16px;
        padding: 22px 28px;
        margin-bottom: 24px;
        color: #FFFFFF;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .xyz-topup-hero h1 {
        font-size: 1.45rem !important;
        font-weight: 800 !important;
        margin: 0 0 4px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #FFFFFF;
    }

    .xyz-topup-card {
        background: #FFFFFF;
        border-radius: 16px;
        border: 1px solid #E2E8F0;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        padding: 28px 32px;
        margin-bottom: 24px;
    }

    body.xyz-dark-theme .xyz-topup-card {
        background: #131B2E;
        border-color: rgba(255, 255, 255, 0.08);
    }

    .xyz-preset-pill {
        background: #F8FAFC;
        border: 1.5px solid #E2E8F0;
        border-radius: 12px;
        padding: 14px 16px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
    }

    .xyz-preset-pill:hover {
        border-color: #6366F1;
        background: #EEF2FF;
        transform: translateY(-2px);
    }

    .xyz-preset-pill.active {
        border-color: #6366F1;
        background: #EEF2FF;
        box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.25);
    }

    body.xyz-dark-theme .xyz-preset-pill {
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(255, 255, 255, 0.1);
    }

    body.xyz-dark-theme .xyz-preset-pill:hover,
    body.xyz-dark-theme .xyz-preset-pill.active {
        background: rgba(99, 102, 241, 0.15);
        border-color: #6366F1;
    }
</style>

<!-- Hero Section -->
<div class="xyz-topup-hero">
    <div>
        <h1>
            <i class="fa fa-wallet" style="color:#10B981;"></i> Top Up SMS Units
        </h1>
        <p>Instant automated wallet funding powered by Paystack. Supports Cards, Transfers, and USSD.</p>
    </div>
    <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
        <div style="background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15); border-radius:12px; padding:10px 18px; text-align:right;">
            <small style="color:#94A3B8; font-size:0.75rem; font-weight:700; display:block; text-transform:uppercase;">Current Balance</small>
            <strong id="headerWalletBal" style="font-size:1.35rem; color:#FBBF24;">@currentUnits.ToString("N2") Units</strong>
        </div>
        <div style="background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.3); border-radius:12px; padding:10px 18px; text-align:center;">
            <small style="color:#A7F3D0; font-size:0.75rem; font-weight:700; display:block; text-transform:uppercase;">Rate Per Unit</small>
            <strong style="font-size:1.35rem; color:#34D399;">&#8358;@pricePerUnit.ToString("N2")</strong>
        </div>
    </div>
</div>

@Html.Partial("_ResponseMessagePartial")

<div class="xyz-topup-card">
    <div class="row">
        <!-- Left Column: Package Presets & Input -->
        <div class="col-md-7">
            <h3 style="font-weight:800; font-size:1.15rem; margin:0 0 6px; color:#1E293B;">
                Select Units to Purchase
            </h3>
            <p style="color:#64748B; font-size:0.9rem; margin-bottom:20px;">
                Choose a preset package or enter any custom unit quantity below.
            </p>

            <!-- Quick Presets Grid -->
            <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:12px; margin-bottom:24px;">
                <div class="xyz-preset-pill active" onclick="selectPreset(500, this)">
                    <strong style="display:block; font-size:1.05rem; color:#1E293B;">500 Units</strong>
                    <span style="color:#10B981; font-weight:800; font-size:0.88rem;">&#8358;@((500 * pricePerUnit).ToString("N0"))</span>
                </div>
                <div class="xyz-preset-pill" onclick="selectPreset(1000, this)">
                    <strong style="display:block; font-size:1.05rem; color:#1E293B;">1,000 Units</strong>
                    <span style="color:#10B981; font-weight:800; font-size:0.88rem;">&#8358;@((1000 * pricePerUnit).ToString("N0"))</span>
                </div>
                <div class="xyz-preset-pill" onclick="selectPreset(2500, this)">
                    <strong style="display:block; font-size:1.05rem; color:#1E293B;">2,500 Units</strong>
                    <span style="color:#10B981; font-weight:800; font-size:0.88rem;">&#8358;@((2500 * pricePerUnit).ToString("N0"))</span>
                </div>
                <div class="xyz-preset-pill" onclick="selectPreset(5000, this)">
                    <strong style="display:block; font-size:1.05rem; color:#1E293B;">5,000 Units</strong>
                    <span style="color:#10B981; font-weight:800; font-size:0.88rem;">&#8358;@((5000 * pricePerUnit).ToString("N0"))</span>
                </div>
                <div class="xyz-preset-pill" onclick="selectPreset(10000, this)">
                    <strong style="display:block; font-size:1.05rem; color:#1E293B;">10,000 Units</strong>
                    <span style="color:#10B981; font-weight:800; font-size:0.88rem;">&#8358;@((10000 * pricePerUnit).ToString("N0"))</span>
                </div>
                <div class="xyz-preset-pill" onclick="selectPreset(25000, this)">
                    <strong style="display:block; font-size:1.05rem; color:#1E293B;">25,000 Units</strong>
                    <span style="color:#10B981; font-weight:800; font-size:0.88rem;">&#8358;@((2500 * pricePerUnit * 10).ToString("N0"))</span>
                </div>
            </div>

            <!-- Custom Units Input Field -->
            <div class="form-group" style="margin-bottom:22px;">
                <label style="font-weight:700; font-size:0.92rem; margin-bottom:6px; display:block;">Or Enter Custom Unit Amount:</label>
                <div class="input-group">
                    <input type="number" id="customUnitsInput" value="500" min="1" step="1" class="form-control" style="height:48px; font-size:1.15rem; font-weight:800; border-radius:10px 0 0 10px;" />
                    <span class="input-group-addon" style="background:#F1F5F9; font-weight:800; font-size:0.95rem; border-radius:0 10px 10px 0;">
                        SMS Units
                    </span>
                </div>
            </div>

            <!-- Pay via Paystack Button -->
            <button type="button" id="btnPayNowInline" onclick="initiatePaystackInlinePayment()" class="btn btn-block" style="background:#10B981; color:#fff; font-weight:800; font-size:1.1rem; padding:14px; border-radius:12px; border:none; box-shadow:0 4px 14px rgba(16, 185, 129, 0.4); display:flex; justify-content:center; align-items:center; gap:10px;">
                <i class="fa fa-lock"></i> Pay &#8358;<span id="btnAmountDisplay">@((500 * pricePerUnit).ToString("N2"))</span> via Paystack
            </button>

            <div style="margin-top:14px; display:flex; align-items:center; justify-content:center; gap:8px; color:#64748B; font-size:0.82rem;">
                <i class="fa fa-shield-halved" style="color:#10B981;"></i>
                Secured by Paystack PCI-DSS Level 1 Gateway. Supports Cards, Transfers &amp; USSD.
            </div>
        </div>

        <!-- Right Column: Order Summary -->
        <div class="col-md-5">
            <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:16px; padding:24px;">
                <h4 style="font-weight:800; font-size:1.05rem; margin:0 0 16px; color:#1E293B;">
                    <i class="fa fa-receipt" style="color:#6366F1;"></i> Order Summary
                </h4>

                <div style="display:flex; justify-content:space-between; margin-bottom:12px; font-size:0.92rem;">
                    <span style="color:#64748B;">Units to Credit:</span>
                    <strong id="summaryUnits" style="color:#0F172A;">500 Units</strong>
                </div>

                <div style="display:flex; justify-content:space-between; margin-bottom:12px; font-size:0.92rem;">
                    <span style="color:#64748B;">Rate per Unit:</span>
                    <strong style="color:#0F172A;">&#8358;@pricePerUnit.ToString("N2")</strong>
                </div>

                <div style="display:flex; justify-content:space-between; margin-bottom:12px; font-size:0.92rem;">
                    <span style="color:#64748B;">Gateway Fee:</span>
                    <strong style="color:#10B981;">&#8358;0.00 (FREE)</strong>
                </div>

                <hr style="border-color:#E2E8F0; margin:16px 0;" />

                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                    <span style="font-weight:800; font-size:1.05rem; color:#1E293B;">Total Amount:</span>
                    <strong id="summaryTotalNaira" style="font-weight:900; font-size:1.45rem; color:#10B981;">&#8358;@((500 * pricePerUnit).ToString("N2"))</strong>
                </div>

                <div style="background:#EFF6FF; border:1px solid #BFDBFE; border-radius:10px; padding:12px; font-size:0.85rem; color:#1E40AF;">
                    <i class="fa fa-circle-info"></i> Your units will be credited immediately upon successful payment.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Paystack Inline Popup JS -->
    <script src="https://js.paystack.co/v1/inline.js"></script>

    <script>
        const unitRate = @pricePerUnit;

        function selectPreset(units, el) {
            $('.xyz-preset-pill').removeClass('active');
            $(el).addClass('active');
            $('#customUnitsInput').val(units);
            updateOrderSummary(units);
        }

        function updateOrderSummary(units) {
            const qty = parseFloat(units) || 0;
            const total = qty * unitRate;
            $('#summaryUnits').text(qty.toLocaleString('en-US') + ' Units');
            $('#summaryTotalNaira').html('&#8358;' + total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#btnAmountDisplay').text(total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        }

        $('#customUnitsInput').on('input', function () {
            $('.xyz-preset-pill').removeClass('active');
            updateOrderSummary($(this).val());
        });

        // Initialize & Launch Paystack Inline Modal
        function initiatePaystackInlinePayment() {
            const units = parseFloat($('#customUnitsInput').val());
            if (!units || units <= 0) {
                if (window.xyzToast) xyzToast.warning('Please enter a valid unit quantity.', 'Invalid Units');
                else alert('Please enter a valid unit quantity.');
                return;
            }

            const btn = $('#btnPayNowInline');
            btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Initializing Paystack...');

            // Step 1: Initialize transaction on server
            $.post('@Url.Action("InitializePaystackInline", "Dashboard", new { area = "ClientPanel" })', { units: units }, function (res) {
                btn.prop('disabled', false).html('<i class="fa fa-lock"></i> Pay &#8358;' + (units * unitRate).toLocaleString('en-US', { minimumFractionDigits: 2 }) + ' via Paystack');

                if (res && res.success) {
                    // Step 2: Open Paystack Popup Modal directly on page
                    const handler = PaystackPop.setup({
                        key: res.publicKey || '@publicKey',
                        email: res.email,
                        amount: res.amountInKobo,
                        currency: 'NGN',
                        ref: 'EXZ_' + res.transactionId + '_' + Math.floor((Math.random() * 1000000000) + 1),
                        firstname: res.firstName,
                        lastname: res.surname,
                        metadata: {
                            custom_fields: [
                                {
                                    display_name: "Transaction ID",
                                    variable_name: "transaction_id",
                                    value: res.transactionId
                                },
                                {
                                    display_name: "Units",
                                    variable_name: "units",
                                    value: res.units
                                }
                            ]
                        },
                        callback: function (response) {
                            // Step 3: Verify and credit wallet
                            verifyPaystackInlinePayment(response.reference, res.transactionId);
                        },
                        onClose: function () {
                            if (window.xyzToast) {
                                xyzToast.info('Payment window closed. Your transaction remains pending in history.', 'Cancelled');
                            }
                        }
                    });

                    handler.openIframe();
                } else {
                    if (window.xyzToast) xyzToast.error(res.message || 'Could not initialize transaction.', 'Error');
                    else alert(res.message);
                }
            }).fail(function () {
                btn.prop('disabled', false).html('<i class="fa fa-lock"></i> Pay via Paystack');
                if (window.xyzToast) xyzToast.error('Network error communicating with server.', 'Error');
            });
        }

        // Backend Verification & Wallet Credit
        function verifyPaystackInlinePayment(ref, transId) {
            if (window.xyzToast) xyzToast.info('Verifying payment with Paystack...', 'Processing');

            $.post('@Url.Action("VerifyPaystackInline", "Dashboard", new { area = "ClientPanel" })', { reference: ref, transactionId: transId }, function (res) {
                if (res && res.success) {
                    if (window.xyzToast) {
                        xyzToast.success(res.message, 'Wallet Credited!');
                    }
                    $('#headerWalletBal').text(parseFloat(res.newBalance).toFixed(2) + ' Units');

                    setTimeout(function () {
                        window.location.href = '@Url.Action("TransactionHistory", "Dashboard", new { area = "ClientPanel" })';
                    }, 1200);
                } else {
                    if (window.xyzToast) xyzToast.error(res.message || 'Payment verification failed.', 'Error');
                    else alert(res.message);
                }
            });
        }
    </script>
}
