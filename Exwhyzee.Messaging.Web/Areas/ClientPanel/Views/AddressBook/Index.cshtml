                </p>

                <!-- Navigation Tabs -->
                <ul class="nav nav-pills" id="guideTabs" style="margin-bottom:24px; gap:8px;">
                    <li class="active">
                        <a href="#guide-excel" data-toggle="pill" style="font-weight:800; border-radius:10px; padding:10px 18px;">
                            <i class="fa fa-file-excel" style="color:#10B981;"></i> Excel (.xlsx / .csv)
                        </a>
                    </li>
                    <li>
                        <a href="#guide-word" data-toggle="pill" style="font-weight:800; border-radius:10px; padding:10px 18px;">
                            <i class="fa fa-file-word" style="color:#2563EB;"></i> Word (.docx)
                        </a>
                    </li>
                    <li>
                        <a href="#guide-txt" data-toggle="pill" style="font-weight:800; border-radius:10px; padding:10px 18px;">
