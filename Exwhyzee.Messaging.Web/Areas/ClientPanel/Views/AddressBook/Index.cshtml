                        </a>
                    </li>
                    <li>
                        <a href="#guide-screenshot" data-toggle="pill" style="font-weight:800; border-radius:10px; padding:10px 18px;">
                            <i class="fa fa-camera" style="color:#E50914;"></i> Screenshot OCR Tips
                        </a>
                    </li>
                </ul>

                <div class="tab-content" style="margin-bottom:24px;">
                    <!-- TAB 1: EXCEL / CSV -->
                    <div class="tab-pane active" id="guide-excel">
                        <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:14px; padding:20px; margin-bottom:18px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:10px;">
                                <h5 style="font-weight:800; font-size:1.15rem; margin:0; color:#1E293B;">
                                    <i class="fa fa-table"></i> Spreadsheet Layout (Columns)
                                </h5>
                                <button type="button" class="btn btn-sm btn-success" onclick="downloadSampleCsv()" style="font-weight:800; border-radius:8px; padding:6px 16px;">
                                    <i class="fa fa-download"></i> Download Sample CSV
                                </button>
                            </div>

                            <table class="table table-bordered" style="background:#fff; margin-bottom:12px; font-family:'JetBrains Mono', monospace; font-size:0.92rem;">
                                <thead>
                                    <tr style="background:#E2E8F0; font-weight:800;">
                                        <th style="width:35%;">Column A (Phone Number)</th>
                                        <th style="width:35%;">Column B (Contact Name)</th>
                                        <th style="width:30%;">Column C (Note / Label)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="color:#6366F1; font-weight:700;">08031234567</td>
                                        <td>John Doe</td>
                                        <td>VIP Client</td>
                                    </tr>
                                    <tr>
                                        <td style="color:#6366F1; font-weight:700;">2348029876543</td>
                                        <td>Mary Smith</td>
                                        <td>Lagos Branch</td>
                                    </tr>
                                    <tr>
                                        <td style="color:#6366F1; font-weight:700;">+2349011223344</td>
                                        <td>Emeka Okafor</td>
                                        <td>Distributor</td>
                                    </tr>
                                </tbody>
                            </table>

                            <ul style="color:#475569; font-size:0.95rem; line-height:1.7; padding-left:20px; margin:0;">
                                <li>Phone numbers can be formatted as <code>080...</code>, <code>23480...</code>, or <code>+234...</code>.</li>
                                <li>Ensure phone numbers are not truncated or formatted as scientific notation (e.g. <code>8.03E+09</code> in Excel). Format the column as <strong>Text</strong>.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- TAB 2: WORD (.DOCX) -->
                    <div class="tab-pane" id="guide-word">
                        <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:14px; padding:20px;">
                            <h5 style="font-weight:800; font-size:1.15rem; margin:0 0 12px; color:#1E293B;">
                                <i class="fa fa-file-word" style="color:#2563EB;"></i> Microsoft Word Document Structure
                            </h5>
                            <p style="color:#475569; font-size:0.98rem; margin-bottom:14px;">
                                You can save contacts in a Word document in either of two standard styles:
                            </p>

                            <div class="row">
                                <div class="col-md-6">
                                    <div style="background:#fff; border:1px solid #CBD5E1; border-radius:8px; padding:14px; font-family:'JetBrains Mono', monospace; font-size:0.88rem;">
                                        <strong>Style 1: 2-Column Table</strong><br /><br />
                                        John Doe - 08031234567<br />
                                        Mary Smith - 08029876543<br />
                                        Emeka Obi - 09011223344
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div style="background:#fff; border:1px solid #CBD5E1; border-radius:8px; padding:14px; font-family:'JetBrains Mono', monospace; font-size:0.88rem;">
                                        <strong>Style 2: Line-by-Line List</strong><br /><br />
                                        08031234567<br />
                                        08029876543<br />
                                        09011223344
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 3: PLAIN TEXT (.TXT) -->
                    <div class="tab-pane" id="guide-txt">
                        <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:14px; padding:20px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:10px;">
                                <h5 style="font-weight:800; font-size:1.15rem; margin:0; color:#1E293B;">
                                    <i class="fa fa-file-lines" style="color:#6366F1;"></i> Notepad / Plain Text (.txt)
                                </h5>
                                <button type="button" class="btn btn-sm btn-default" onclick="copySampleTxt()" style="font-weight:800; border-radius:8px; padding:6px 14px;">
                                    <i class="fa fa-copy"></i> Copy Sample
                                </button>
                            </div>

                            <textarea id="sampleTxtContent" class="form-control" rows="4" readonly style="font-family:'JetBrains Mono', monospace; font-size:0.95rem; border-radius:10px; background:#fff; margin-bottom:12px;">08031234567, 08029876543, 09011223344, 2348055667788, 07065432109</textarea>

                            <p style="color:#475569; font-size:0.95rem; margin:0;">
                                You can separate numbers with <strong>commas</strong>, <strong>spaces</strong>, <strong>semicolons</strong>, or <strong>new lines</strong>.
                            </p>
                        </div>
                    </div>

                    <!-- TAB 4: SCREENSHOT OCR -->
                    <div class="tab-pane" id="guide-screenshot">
                        <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:14px; padding:20px;">
                            <h5 style="font-weight:800; font-size:1.15rem; margin:0 0 12px; color:#1E293B;">
                                <i class="fa fa-wand-magic-sparkles" style="color:#6366F1;"></i> Maximizing AI OCR Accuracy
                            </h5>
                            <div class="row" style="font-size:0.95rem; color:#475569;">
                                <div class="col-md-6" style="margin-bottom:12px;">
                                    <div style="background:#fff; border:1px solid #CBD5E1; border-radius:10px; padding:14px;">
                                        <strong style="color:#10B981;"><i class="fa fa-check-circle"></i> Best Practices:</strong>
                                        <ul style="margin:8px 0 0; padding-left:18px;">
                                            <li>Clear screenshot of WhatsApp group info, members list, or chats.</li>
                                            <li>Phone contacts app screenshots.</li>
                                            <li>High resolution flyers or printed posters.</li>
                                            <li>Clean handwriting on plain white paper.</li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div style="background:#fff; border:1px solid #CBD5E1; border-radius:10px; padding:14px;">
                                        <strong style="color:#EF4444;"><i class="fa fa-circle-xmark"></i> What to Avoid:</strong>
                                        <ul style="margin:8px 0 0; padding-left:18px;">
                                            <li>Extremely blurry, low-resolution, or rotated photos.</li>
                                            <li>Screenshots where numbers are partially obscured or cut off.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="text-align:right;">
                    <button type="button" class="btn btn-default" data-dismiss="modal" style="font-weight:800; font-size:1.05rem; padding:10px 24px; border-radius:10px;">
                        Close Guide
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        let currentPastedBase64 = null;
        let currentUploadedFile = null;
        let extractedContactsList = [];

        function openAiExtractorModal() {
            $('#aiExtractorModal').modal('show');
            setTimeout(() => { $('#pasteZone').focus(); }, 300);
        }

        // 1. Clipboard Paste (Ctrl + V) Handler
        window.addEventListener('paste', function (e) {
            if (!$('#aiExtractorModal').hasClass('in')) return;

            const items = (e.clipboardData || e.originalEvent.clipboardData).items;
            for (let i = 0; i < items.length; i++) {
                if (items[i].type.indexOf('image') !== -1) {
                    const blob = items[i].getAsFile();
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        currentPastedBase64 = event.target.result;
                        $('#imagePreview').attr('src', currentPastedBase64);
                        $('#imagePreviewContainer').show();
                        $('#ingestTabs a[href="#tab-screenshot"]').tab('show');
                        if (window.xyzToast) xyzToast.success('Screenshot pasted! Click "Extract & Clean" to process.', 'Image Ready');
                    };
                    reader.readAsDataURL(blob);
                    break;
                }
            }
        });

        // Image file picker
        $('#imageFileInput').change(function () {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    currentPastedBase64 = e.target.result;
                    $('#imagePreview').attr('src', currentPastedBase64);
                    $('#imagePreviewContainer').show();
                };
                reader.readAsDataURL(this.files[0]);
            }
        });

        function clearPastedImage() {
            currentPastedBase64 = null;
            $('#imageFileInput').val('');
            $('#imagePreviewContainer').hide();
        }

        // Document File Picker
        $('#docFileInput').change(function () {
            if (this.files && this.files[0]) {
                currentUploadedFile = this.files[0];
                $('#fileNameDisplay').text('Selected: ' + currentUploadedFile.name).show();
            }
        });

        function toggleNewGroupNameInput() {
            const val = $('#targetGroupSelect').val();
            if (val === '0') {
                $('#newGroupNameCol').show();
            } else {
                $('#newGroupNameCol').hide();
            }
        }

        // 2. Start AI Extraction
        function startAiExtraction() {
            const activeTab = $('#ingestTabs li.active a').attr('href');
            const formData = new FormData();
            const btn = $('#btnExtractAi');

            if (activeTab === '#tab-screenshot') {
                if (!currentPastedBase64) {
                    alert('Please paste a screenshot (Ctrl + V) or select an image file first.');
                    return;
                }
                formData.append('pasteImageBase64', currentPastedBase64);
            } else if (activeTab === '#tab-file') {
                if (!currentUploadedFile) {
                    alert('Please select a Word, Excel, or Text file first.');
                    return;
                }
                formData.append('file', currentUploadedFile);
            } else {
                const rawText = $('#rawTextInput').val();
                if (!rawText || !rawText.trim()) {
                    alert('Please enter or paste text containing numbers.');
                    return;
                }
                formData.append('rawText', rawText);
            }

            btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> AI Extracting & Normalizing Contacts...');

            $.ajax({
                url: '@Url.Action("ExtractContactsAi", "AddressBook", new { area = "ClientPanel" })',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    btn.prop('disabled', false).html('<i class="fa fa-wand-magic-sparkles"></i> Extract & Clean Phone Numbers');

                    if (res && res.success) {
                        extractedContactsList = res.contacts || [];
                        renderExtractedTable(extractedContactsList);
                        $('#resultsSection').slideDown();
                        $('#extractedCountBadge').text(extractedContactsList.length);
                        if (window.xyzToast) xyzToast.success(extractedContactsList.length + ' valid phone numbers extracted!', 'Extraction Complete');
                    } else if (res && res.keyMissing) {
                        alert(res.message);
                    } else {
                        alert(res.message || 'Unable to extract contacts.');
                    }
                },
                error: function () {
                    btn.prop('disabled', false).html('<i class="fa fa-wand-magic-sparkles"></i> Extract & Clean Phone Numbers');
                    alert('Network error during AI extraction.');
                }
            });
        }

        // Render Table Rows
        function renderExtractedTable(list) {
            const tbody = $('#extractedTableBody');
            tbody.empty();

            if (!list || list.length === 0) {
                tbody.html('<tr><td colspan="4" class="text-center text-muted" style="padding:20px;">No phone numbers found in the provided input.</td></tr>');
                return;
            }

            list.forEach((item, index) => {
                const row = `
                    <tr>
                        <td style="text-align:center;">
                            <input type="checkbox" class="contact-chk" data-idx="${index}" checked />
                        </td>
                        <td>
                            <input type="text" class="form-control input-sm input-name" data-idx="${index}" value="${item.name || 'Contact'}" style="font-weight:700; border-radius:6px;" />
                        </td>
                        <td>
                            <input type="text" class="form-control input-sm input-phone" data-idx="${index}" value="${item.phone || ''}" style="font-weight:800; color:#6366F1; border-radius:6px;" />
                        </td>
                        <td>
                            <input type="text" class="form-control input-sm input-note" data-idx="${index}" value="${item.note || 'AI Extracted'}" style="border-radius:6px;" />
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        function toggleMasterCheck(master) {
            $('.contact-chk').prop('checked', master.checked);
        }

        function selectAllExtracted(select) {
            $('.contact-chk').prop('checked', select);
            $('#checkAllMaster').prop('checked', select);
        }

        // 3. Save Extracted Contacts to DB
        function saveExtractedContactsToDb() {
            const selectedContacts = [];
            $('.contact-chk:checked').each(function () {
                const idx = $(this).data('idx');
                const row = $(this).closest('tr');
                const name = row.find('.input-name').val();
                const phone = row.find('.input-phone').val();
                const note = row.find('.input-note').val();

                if (phone && phone.trim()) {
                    selectedContacts.push({ name: name, phone: phone.trim(), note: note });
                }
            });

            if (selectedContacts.length === 0) {
                alert('Please select at least one contact to save.');
                return;
            }

            const targetGroupId = parseInt($('#targetGroupSelect').val()) || 0;
            const newGroupName = $('#newGroupNameInput').val();

            const saveBtn = $('#btnSaveExtracted');
            saveBtn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Saving...');

            const payload = {
                groupId: targetGroupId,
                newGroupName: newGroupName,
                contacts: selectedContacts
            };

            $.ajax({
                url: '@Url.Action("SaveExtractedContacts", "AddressBook", new { area = "ClientPanel" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    saveBtn.prop('disabled', false).html('<i class="fa fa-floppy-disk"></i> Save to Address Book Group');
                    if (res && res.success) {
                        $('#aiExtractorModal').modal('hide');
                        if (window.xyzToast) {
                            xyzToast.success(res.count + ' contacts saved to Address Book!', 'Saved');
                            setTimeout(() => { window.location.href = '@Url.Action("Details", "AddressBook", new { area = "ClientPanel" })/' + res.groupId; }, 1000);
                        } else {
                            window.location.href = '@Url.Action("Details", "AddressBook", new { area = "ClientPanel" })/' + res.groupId;
                        }
                    } else {
                        alert(res.message || 'Error saving contacts.');
                    }
                },
                error: function () {
                    saveBtn.prop('disabled', false).html('<i class="fa fa-floppy-disk"></i> Save to Address Book Group');
                    alert('Network error saving contacts.');
                }
            });
        }

        // Live Table Search
        $('#groupSearchInput').on('keyup', function () {
            const value = $(this).val().toLowerCase();
            $('#groupsTable tbody tr').filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });

        // Download Sample CSV template
        function downloadSampleCsv() {
            const csvContent = "Phone Number,Contact Name,Note\n08031234567,John Doe,VIP Client\n2348029876543,Mary Smith,Lagos Branch\n+2349011223344,Emeka Okafor,Distributor\n07065432109,Chioma Adeleke,Retailer";
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", "contacts_sample_template.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            if (window.xyzToast) xyzToast.success('Sample template downloaded!', 'Download Complete');
        }

        // Copy Sample Text
        function copySampleTxt() {
            const txt = document.getElementById("sampleTxtContent");
            txt.select();
            txt.setSelectionRange(0, 99999);
            document.execCommand("copy");
            if (window.xyzToast) xyzToast.success('Sample numbers copied to clipboard!', 'Copied');
            else alert('Sample numbers copied to clipboard!');
        }
    </script>
}
