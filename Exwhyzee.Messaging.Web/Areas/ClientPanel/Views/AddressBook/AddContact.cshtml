@model Exwhyzee.Messaging.Core.Models.Contact

@{
    ViewBag.Title = "Add Single Contact";
}

<style>
    .xyz-create-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 28px;
    }

    .xyz-create-hero h1 {
        font-size: 2.35rem;
        font-weight: 800;
        margin: 0 0 6px;
        color: var(--xyz-dash-text);
        letter-spacing: -0.5px;
    }

    .xyz-create-hero p {
        font-size: 1.2rem;
        color: var(--xyz-dash-muted);
        margin: 0;
    }

    .xyz-card {
        background: #FFFFFF;
        border-radius: 18px;
        border: 1px solid var(--xyz-dash-border);
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.03);
        margin-bottom: 30px;
        overflow: hidden;
    }

    body.xyz-dark-theme .xyz-card {
        background: #131B2E;
    }

    .xyz-card-header {
        padding: 22px 28px;
        border-bottom: 1px solid var(--xyz-dash-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .xyz-card-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--xyz-dash-text);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .xyz-card-body {
        padding: 32px 36px;
    }

    .xyz-input {
        height: 52px;
        border-radius: 12px;
        border: 1px solid var(--xyz-dash-border);
        background: var(--xyz-dash-bg);
        color: var(--xyz-dash-text);
        font-size: 1.15rem;
        padding: 0 18px;
        font-weight: 600;
        width: 100%;
        transition: all 0.2s ease;
    }

    .xyz-input:focus {
        border-color: #6366F1;
        outline: none;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
    }

    .xyz-textarea {
        border-radius: 12px;
        border: 1px solid var(--xyz-dash-border);
        background: var(--xyz-dash-bg);
        color: var(--xyz-dash-text);
        font-size: 1.15rem;
        padding: 16px 18px;
        font-weight: 500;
        width: 100%;
        transition: all 0.2s ease;
    }

    .xyz-textarea:focus {
        border-color: #6366F1;
        outline: none;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
    }

    .xyz-form-label {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--xyz-dash-text);
        margin-bottom: 8px;
        display: block;
    }
</style>

<!-- Hero Section -->
<div class="xyz-create-hero">
    <div>
        <h1><i class="fa fa-user-plus" style="color:#6366F1; margin-right:8px;"></i> Add Single Contact</h1>
        <p>Save a contact's phone number, name, and birthday into this address book group.</p>
    </div>
    <div>
        <a href="@Url.Action("Index", "AddressBook", new { area = "ClientPanel" })" class="btn btn-default" style="font-weight:800; font-size:1.1rem; padding:12px 24px; border-radius:12px;">
            &larr; Back to Groups
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8 col-md-offset-2">
        <div class="xyz-card">
            <div class="xyz-card-header">
                <h3 class="xyz-card-title">
                    <i class="fa fa-address-card" style="color:#10B981;"></i> Contact Information
                </h3>
            </div>
            <div class="xyz-card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger", style = "font-weight:700; font-size:1.1rem; margin-bottom:20px;" })

                    <!-- Phone Number -->
                    <div class="form-group" style="margin-bottom:22px;">
                        <label class="xyz-form-label">
                            Phone Number <span style="color:#E50914;">*</span>
                        </label>
                        @Html.TextBoxFor(model => model.PhoneNumber, new { @class = "xyz-input", placeholder = "08031234567 or 2348031234567", required = "required", autofocus = "autofocus", style = "font-family:'JetBrains Mono', monospace; font-size:1.2rem; color:#6366F1;" })
                        @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger", style = "font-weight:700; margin-top:6px; display:block;" })
                    </div>

                    <div class="row">
                        <!-- Surname / Name -->
                        <div class="col-md-6">
                            <div class="form-group" style="margin-bottom:22px;">
                                <label class="xyz-form-label">First Name / Surname</label>
                                @Html.TextBoxFor(model => model.Surname, new { @class = "xyz-input", placeholder = "e.g. John" })
                                @Html.ValidationMessageFor(model => model.Surname, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <!-- Other Names -->
                        <div class="col-md-6">
                            <div class="form-group" style="margin-bottom:22px;">
                                <label class="xyz-form-label">Other Names (Optional)</label>
                                @Html.TextBoxFor(model => model.Othernames, new { @class = "xyz-input", placeholder = "e.g. Doe" })
                                @Html.ValidationMessageFor(model => model.Othernames, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Date of Birth -->
                        <div class="col-md-6">
                            <div class="form-group" style="margin-bottom:22px;">
                                <label class="xyz-form-label">
                                    <i class="fa fa-cake-candles" style="color:#F59E0B; margin-right:4px;"></i> Date of Birth (Optional)
                                </label>
                                <input type="date" name="dateBirth" class="xyz-input" />
                            </div>
                        </div>

                        <!-- Note / Tag -->
                        <div class="col-md-6">
                            <div class="form-group" style="margin-bottom:22px;">
                                <label class="xyz-form-label">Note / Role (Optional)</label>
                                @Html.TextBoxFor(model => model.Note, new { @class = "xyz-input", placeholder = "e.g. Manager, VIP" })
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div style="display:flex; gap:14px; align-items:center; margin-top:12px;">
                        <button type="submit" class="btn btn-primary btn-lg" style="background:#E50914; border:none; font-weight:800; font-size:1.15rem; padding:14px 36px; border-radius:12px; box-shadow:0 6px 20px rgba(229,9,20,0.35);">
                            <i class="fa fa-plus-circle"></i> Add Contact
                        </button>
                        <a href="@Url.Action("Index", "AddressBook", new { area = "ClientPanel" })" class="btn btn-default btn-lg" style="font-weight:700; font-size:1.1rem; padding:14px 28px; border-radius:12px;">
                            Cancel
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
