{
  "openapi": "3.0.0",
  "info": {
    "title": "XYZSMS Developer API",
    "description": "Welcome to the **XYZSMS Developer REST API Documentation**.\nProgrammatically dispatch single and bulk SMS messages, query real-time unit balances, inspect message delivery history with pagination, check sender ID verification status, and retrieve network carrier rates.\n\n## 🔐 Authentication\nAll endpoints require authentication using your account API Key.\nYou can provide your API key via any of the following methods:\n\n1. **Custom Header (Recommended)**:\n```http\nX-Api-Key: xyz_key_YOUR_ACTUAL_KEY\n```\n\n2. **Standard Authorization Bearer Header**:\n```http\nAuthorization: Bearer xyz_key_YOUR_ACTUAL_KEY\n```\n\n3. **Query Parameter**:\n```http\nhttps://api.xyzsms.com/api/sms/balance?apikey=xyz_key_YOUR_ACTUAL_KEY\n```\n",
    "version": "1.1.0"
  },
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/sms/send": {
      "post": {
        "summary": "Dispatch Single or Bulk SMS",
        "description": "Sends an SMS message to one or more recipient phone numbers. Supports comma-separated or newline-separated numbers.",
        "tags": [
          "Messaging"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComposeSmsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message was successfully queued/dispatched.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendMessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request (e.g. Invalid recipients, insufficient unit balance, or blacklisted words)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (Missing or invalid API Key)"
          }
        }
      }
    },
    "/api/sms/balance": {
      "get": {
        "summary": "Check Live Unit Balance",
        "description": "Queries the real-time available SMS messaging units for the authenticated client account.",
        "tags": [
          "Account"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved balance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (Invalid or missing API Key)"
          }
        }
      }
    },
    "/api/sms/history": {
      "get": {
        "summary": "Delivery Logs & Message History",
        "description": "Retrieves outbound SMS delivery history with server-side pagination and optional filters by sender ID, recipient number, or status.",
        "tags": [
          "History & Analytics"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (1-based index).",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of records per page (default: 50, max: 200).",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "senderId",
            "in": "query",
            "description": "Filter by sender ID (e.g. XYZSMS).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "recipient",
            "in": "query",
            "description": "Filter by recipient phone number.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status (e.g. Sent, Delivered, Failed).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved paginated history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedHistoryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (Invalid or missing API Key)"
          }
        }
      }
    },
    "/api/sms/senderids": {
      "get": {
        "summary": "Retrieve Sender IDs & Approval Status",
        "description": "Returns all registered Sender IDs for the authenticated client along with their telecommunication approval status.",
        "tags": [
          "Sender IDs"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved sender IDs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SenderIdsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (Invalid or missing API Key)"
          }
        }
      }
    },
    "/api/sms/pricing": {
      "get": {
        "summary": "Network Rates & Base Unit Pricing",
        "description": "Retrieves the platform base unit price, flat rates, and individual telecommunication carrier rates and dial codes.",
        "tags": [
          "Pricing"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved pricing list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricingResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (Invalid or missing API Key)"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "Custom API Key Header: `X-Api-Key: xyz_key_XXXXXXXXXXXXXXXXXXXXXXXXXXX`"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "Standard Bearer Token: `Authorization: Bearer xyz_key_XXXXXXXXXXXXXXXXXXXXXXXXXXX`"
      }
    },
    "schemas": {
      "ComposeSmsRequest": {
        "type": "object",
        "required": [
          "recipients",
          "senderId",
          "messageContent"
        ],
        "properties": {
          "senderId": {
            "type": "string",
            "description": "Your registered and approved Sender ID (maximum 11 alphanumeric characters).",
            "example": "XYZSMS"
          },
          "recipients": {
            "type": "string",
            "description": "Comma-separated or newline-separated recipient phone numbers.",
            "example": "08012345678,08123456789"
          },
          "messageContent": {
            "type": "string",
            "description": "The SMS text message body to deliver.",
            "example": "Your verification code is 849201. Valid for 10 minutes."
          },
          "isFlash": {
            "type": "boolean",
            "description": "Set to true for flash SMS (appears directly on recipient screen).",
            "example": false
          },
          "scheduledDate": {
            "type": "string",
            "format": "date-time",
            "description": "Optional future dispatch time (ISO 8601 string).",
            "example": "2026-08-25T09:00:00Z"
          }
        }
      },
      "SendMessageResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Message dispatched successfully."
          },
          "totalUnitsUsed": {
            "type": "number",
            "example": 3.0
          },
          "recipientsCount": {
            "type": "integer",
            "example": 2
          },
          "batchReference": {
            "type": "string",
            "example": "XYZ-TXN-9402104"
          }
        }
      },
      "BalanceResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "username": {
            "type": "string",
            "example": "john_doe"
          },
          "email": {
            "type": "string",
            "example": "john@example.com"
          },
          "unitsBalance": {
            "type": "number",
            "example": 2450.75
          },
          "currency": {
            "type": "string",
            "example": "NGN"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-21T08:15:00Z"
          }
        }
      },
      "PaginatedHistoryResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "example": 50
          },
          "totalRecords": {
            "type": "integer",
            "example": 142
          },
          "totalPages": {
            "type": "integer",
            "example": 3
          },
          "hasNextPage": {
            "type": "boolean",
            "example": true
          },
          "hasPreviousPage": {
            "type": "boolean",
            "example": false
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryRecord"
            }
          }
        }
      },
      "HistoryRecord": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "integer",
            "example": 1054
          },
          "senderId": {
            "type": "string",
            "example": "XYZSMS"
          },
          "recipients": {
            "type": "string",
            "example": "08012345678"
          },
          "messageContent": {
            "type": "string",
            "example": "Your OTP code is 492104"
          },
          "unitsUsed": {
            "type": "number",
            "example": 1.5
          },
          "status": {
            "type": "string",
            "example": "Sent"
          },
          "dateSent": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-21T07:30:00Z"
          }
        }
      },
      "SenderIdsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "count": {
            "type": "integer",
            "example": 2
          },
          "senderIds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "example": 10
                },
                "senderId": {
                  "type": "string",
                  "example": "XYZSMS"
                },
                "status": {
                  "type": "string",
                  "example": "Approved"
                },
                "isApproved": {
                  "type": "boolean",
                  "example": true
                },
                "message": {
                  "type": "string",
                  "nullable": true,
                  "example": null
                }
              }
            }
          }
        }
      },
      "PricingResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "currency": {
            "type": "string",
            "example": "NGN"
          },
          "basePricePerUnit": {
            "type": "number",
            "example": 2.0
          },
          "flatUnitsPerSms": {
            "type": "number",
            "example": 1.0
          },
          "count": {
            "type": "integer",
            "example": 4
          },
          "rates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "country": {
                  "type": "string",
                  "example": "Nigeria"
                },
                "networkProvider": {
                  "type": "string",
                  "example": "MTN"
                },
                "unitsPerSms": {
                  "type": "number",
                  "example": 1.5
                },
                "estimatedCostPerSms": {
                  "type": "number",
                  "example": 3.0
                },
                "internationalDialCode": {
                  "type": "string",
                  "example": "234"
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Insufficient units to complete SMS broadcast."
          }
        }
      }
    }
  }
}
